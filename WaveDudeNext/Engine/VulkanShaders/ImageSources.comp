#version 450

// One work item per image source. SceneData supplies at most one source per pixel.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Field { float u[]; };
layout(set = 0, binding = 1, std430) readonly buffer Indices { int indices[]; };
layout(set = 0, binding = 2, std430) readonly buffer Levels { int levels[]; };
layout(set = 0, binding = 3, std430) readonly buffer Frequencies { float frequencies[]; };
layout(push_constant) uniform Parameters
{
    int count;
    float time;
    float amplitude;
} p;

void main()
{
    int source = int(gl_GlobalInvocationID.x);
    if (source >= p.count) return;
    int pixel = indices[source];
    u[pixel] = u[pixel] * 0.9 + sin(frequencies[levels[source]] * p.time) * p.amplitude * 0.1;
}
