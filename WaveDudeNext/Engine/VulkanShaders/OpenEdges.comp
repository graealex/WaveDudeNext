#version 450

// Mur's absorbing boundary on the padded ring, after the interior wave step.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Field { float u[]; };
layout(set = 0, binding = 1, std430) buffer Next { float next[]; };
layout(set = 0, binding = 2, std430) readonly buffer Speed { float speedSquared[]; };
layout(push_constant) uniform Parameters
{
    int width;
    int height;
    int stride;
    int trackIntensity;
    float speedScale;
    float intensityAlpha;
} p;

void absorb(int ring, int inner)
{
    float speed = sqrt(speedSquared[inner] * p.speedScale) * 0.56213877;
    float k = (speed - 1.0) / (speed + 1.0);
    next[ring] = u[inner] + k * (next[inner] - u[ring]);
}

void main()
{
    int id = int(gl_GlobalInvocationID.x);
    if (id < p.width + 2)
    {
        int ix = clamp(id, 1, p.width);
        absorb(id, p.stride + ix);
        absorb((p.height + 1) * p.stride + id, p.height * p.stride + ix);
    }
    else
    {
        int y = id - (p.width + 2) + 1;
        if (y > p.height) return;
        absorb(y * p.stride, y * p.stride + 1);
        absorb(y * p.stride + p.width + 1, y * p.stride + p.width);
    }
}
