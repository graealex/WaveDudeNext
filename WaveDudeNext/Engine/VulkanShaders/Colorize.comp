#version 450

layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Samples { uint samples[]; };
layout(set = 0, binding = 1, std430) readonly buffer Colours { uint colours[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Pixels { uint pixels[]; };
layout(push_constant) uniform Parameters { int count; int indexFormat; } parameters;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(parameters.count)) return;
    uint value;
    if (parameters.indexFormat != 0)
    {
        value = min((samples[i >> 2] >> ((i & 3u) * 8u)) & 255u, 254u);
    }
    else
    {
        value = (samples[i >> 1] >> ((i & 1u) * 16u)) & 65535u;
    }
    pixels[i] = colours[value];
}
