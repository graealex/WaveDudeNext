<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WaveDudeNext.App.Controls"
        xmlns:converters="using:WaveDudeNext.App.Converters"
        xmlns:docking="using:WaveDudeNext.App.Docking"
        xmlns:layout="using:WaveDudeNext.UI.Docking"
        xmlns:localization="using:WaveDudeNext.App.Localization"
        xmlns:local="using:WaveDudeNext.App"
        xmlns:panes="using:WaveDudeNext.App.Panes"
        xmlns:model="using:WaveDudeNext.Model"
        xmlns:sys="using:System"
        xmlns:theming="using:WaveDudeNext.App.Theming"
        xmlns:ui="using:WaveDudeNext.UI"
        xmlns:uitheming="using:WaveDudeNext.UI.Theming"
        x:Class="WaveDudeNext.App.MainWindow"
        x:DataType="local:MainWindow"
        Icon="/Assets/wavedudenext.ico"
        Width="1280" Height="800" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontSize="12"
        DragDrop.AllowDrop="True">
	<!-- The window as the WPF one lays it out: the menu bar, the dock host with the Project, Properties and Messages panes
	     around the Preview document, and the status bar. The window is its own data context: the panes bind the models
	     (Document, Selection, RunHost, Live, Preview, Busy, SceneComposer), the menus bind Commands, each a line into a
	     model, with their hot keys; the settings menus bind their entries and check marks as the WPF window does (the panes,
	     the theme, the language and the RAM cache from their lists through an item theme, the zoom and the preview quality
	     as entries whose check mark compares the setting with the entry's value); the recent files and the examples are
	     filled in code. Texts come from the string table through DynamicResource, so a language switch applies at once.
	     The items a harness reads carry the WPF head's automation ids. -->
	<Window.Resources>
		<converters:TitleConverter x:Key="TitleConverter" />
		<converters:RunStatusConverter x:Key="RunStatus" />
		<converters:EnumByNameConverter x:Key="EnumByName" />
		<converters:EnumNameConverter x:Key="EnumName" />
		<converters:EnumOneOfConverter x:Key="EnumOneOf" />
		<converters:EqualityConverter x:Key="Equality" />
		<converters:IntEqualsConverter x:Key="IntEquals" />
		<converters:DoubleEqualsConverter x:Key="DoubleEquals" />
		<converters:FrameMemoryOptionConverter x:Key="FrameMemoryOption" />
		<converters:LanguageNameConverter x:Key="LanguageName" />
		<converters:BusyTextConverter x:Key="BusyText" />

		<!-- one entry per dock item: check mark follows whether it is shown, click toggles it -->
		<ControlTheme x:Key="PaneMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="docking:DockItem">
			<Setter Property="Header" Value="{Binding Title}" />
			<Setter Property="ToggleType" Value="CheckBox" />
			<Setter Property="IsChecked" Value="{Binding IsShown, Mode=OneWay}" />
			<Setter Property="Command" Value="{Binding $parent[local:MainWindow].Commands.TogglePane}" />
			<Setter Property="CommandParameter" Value="{Binding}" />
		</ControlTheme>
		<!-- one entry per theme, named by the enum's text (which follows the language): check mark follows the current one -->
		<ControlTheme x:Key="ThemeMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="uitheming:AppTheme">
			<Setter Property="Header">
				<Setter.Value>
					<MultiBinding Converter="{StaticResource EnumName}" Mode="OneWay">
						<Binding />
						<Binding Path="Current" Source="{x:Static localization:LanguageController.Instance}" />
					</MultiBinding>
				</Setter.Value>
			</Setter>
			<Setter Property="ToggleType" Value="Radio" />
			<Setter Property="Command" Value="{Binding SelectCommand, Source={x:Static theming:ThemeController.Instance}}" />
			<Setter Property="CommandParameter" Value="{Binding}" />
			<Setter Property="IsChecked">
				<Setter.Value>
					<MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
						<Binding Path="Current" Source="{x:Static theming:ThemeController.Instance}" />
						<Binding />
					</MultiBinding>
				</Setter.Value>
			</Setter>
		</ControlTheme>
		<!-- one entry per language ("System" first): check mark follows the current code, click selects -->
		<ControlTheme x:Key="LanguageMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="localization:LanguageOption">
			<!-- the "System" entry's text follows the language (the others name their language in its own words) -->
			<Setter Property="Header">
				<Setter.Value>
					<MultiBinding Converter="{StaticResource LanguageName}" Mode="OneWay">
						<Binding />
						<Binding Path="Current" Source="{x:Static localization:LanguageController.Instance}" />
					</MultiBinding>
				</Setter.Value>
			</Setter>
			<Setter Property="ToggleType" Value="Radio" />
			<Setter Property="Command" Value="{Binding SelectCommand, Source={x:Static localization:LanguageController.Instance}}" />
			<Setter Property="CommandParameter" Value="{Binding Code}" />
			<Setter Property="IsChecked">
				<Setter.Value>
					<MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
						<Binding Path="Current" Source="{x:Static localization:LanguageController.Instance}" />
						<Binding Path="Code" />
					</MultiBinding>
				</Setter.Value>
			</Setter>
		</ControlTheme>
		<!-- one entry per RAM cache size: "Auto" or the percentage; check mark follows the setting -->
		<ControlTheme x:Key="FrameMemoryMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="sys:Int32">
			<Setter Property="Header">
				<Setter.Value>
					<MultiBinding Converter="{StaticResource FrameMemoryOption}" Mode="OneWay">
						<Binding />
						<Binding Path="Current" Source="{x:Static localization:LanguageController.Instance}" />
					</MultiBinding>
				</Setter.Value>
			</Setter>
			<Setter Property="ToggleType" Value="Radio" />
			<Setter Property="Command" Value="{Binding $parent[local:MainWindow].Commands.SetFrameMemory}" />
			<Setter Property="CommandParameter" Value="{Binding}" />
			<Setter Property="IsChecked">
				<Setter.Value>
					<MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
						<Binding Path="FrameMemoryPercent" Source="{x:Static ui:Settings.Default}" />
						<Binding />
					</MultiBinding>
				</Setter.Value>
			</Setter>
			<Setter Property="AutomationProperties.AutomationId" Value="{Binding StringFormat='MenuFrameMemory{0}'}" />
		</ControlTheme>
	</Window.Resources>
	<Window.Styles>
		<!-- the run's one entry pauses and resumes; the header follows whether a pause is pending (upstream's DataTrigger) -->
		<Style Selector="MenuItem#mnuPauseRun">
			<Setter Property="Header" Value="{DynamicResource MenuSimulationPause}" />
		</Style>
		<Style Selector="MenuItem#mnuPauseRun.paused">
			<Setter Property="Header" Value="{DynamicResource MenuSimulationResume}" />
		</Style>
		<!-- the timeline's Play and Pause, F7 (2026-11-04): the header and the glyph follow the preview's state -->
		<Style Selector="MenuItem#mnuPlayPause">
			<Setter Property="Header" Value="{DynamicResource MenuSimulationPlay}" />
			<Setter Property="controls:MenuIcon.Drawing" Value="Run" />
		</Style>
		<Style Selector="MenuItem#mnuPlayPause.playing">
			<Setter Property="Header" Value="{DynamicResource MenuSimulationPausePlayback}" />
			<Setter Property="controls:MenuIcon.Drawing" Value="Pause" />
		</Style>
	</Window.Styles>
	<Window.Title>
		<MultiBinding Converter="{StaticResource TitleConverter}">
			<Binding Source="{StaticResource Title}" />
			<Binding Path="Document.Filename" />
			<Binding Path="Document.IsDirty" />
			<Binding Path="Document.SuggestedFileName" />
			<!-- the language, so "Untitled" follows a switch -->
			<Binding Path="Current" Source="{x:Static localization:LanguageController.Instance}" />
		</MultiBinding>
	</Window.Title>
	<DockPanel>
		<Menu x:Name="menu" DockPanel.Dock="Top" Background="{DynamicResource MenuBackground}" Foreground="{DynamicResource MenuForeground}">
			<MenuItem Header="{DynamicResource MenuFile}">
				<MenuItem Header="{DynamicResource MenuFileNew}" controls:MenuIcon.Drawing="New" Command="{Binding Commands.New}" HotKey="Ctrl+N" InputGesture="Ctrl+N" />
				<MenuItem Header="{DynamicResource MenuFileOpen}" controls:MenuIcon.Drawing="Open" Command="{Binding Commands.Open}" HotKey="Ctrl+O" InputGesture="Ctrl+O" />
				<MenuItem x:Name="mnuRecent" Header="{DynamicResource MenuFileRecent}" controls:MenuIcon.Drawing="Recent" />
				<MenuItem x:Name="mnuExamples" Header="{DynamicResource MenuFileExamples}" controls:MenuIcon.Drawing="Examples" AutomationProperties.AutomationId="MenuExamples" />
				<Separator />
				<MenuItem Header="{DynamicResource MenuFileSave}" controls:MenuIcon.Drawing="Save" Command="{Binding Commands.Save}" HotKey="Ctrl+S" InputGesture="Ctrl+S" />
				<MenuItem Header="{DynamicResource MenuFileSaveAs}" controls:MenuIcon.Drawing="SaveAs" Command="{Binding Commands.SaveAs}" HotKey="Ctrl+Shift+S" InputGesture="Ctrl+Shift+S" />
				<Separator />
				<MenuItem Header="{DynamicResource MenuFileExport}" controls:MenuIcon.Drawing="Export" AutomationProperties.AutomationId="MenuExport">
					<MenuItem Header="{DynamicResource MenuFileExportField}" controls:MenuIcon.Drawing="Export" Command="{Binding Commands.ExportField}" HotKey="Ctrl+Shift+E" InputGesture="Ctrl+Shift+E" />
					<MenuItem Header="{DynamicResource MenuFileExportIntensity}" controls:MenuIcon.Drawing="Export" Command="{Binding Commands.ExportIntensity}" HotKey="Ctrl+Shift+I" InputGesture="Ctrl+Shift+I" />
					<MenuItem Header="{DynamicResource MenuFileExportBoth}" controls:MenuIcon.Drawing="Export" Command="{Binding Commands.ExportBoth}" HotKey="Ctrl+Shift+B" InputGesture="Ctrl+Shift+B" />
					<Separator />
					<MenuItem Header="{DynamicResource MenuFileExportFieldFrame}" controls:MenuIcon.Drawing="Scene" Command="{Binding Commands.ExportFrame}" CommandParameter="{x:Static model:ProbeLayer.Field}" HotKey="Ctrl+Shift+F" InputGesture="Ctrl+Shift+F" />
					<MenuItem Header="{DynamicResource MenuFileExportIntensityFrame}" controls:MenuIcon.Drawing="Scene" Command="{Binding Commands.ExportFrame}" CommandParameter="{x:Static model:ProbeLayer.Intensity}" HotKey="Ctrl+Shift+G" InputGesture="Ctrl+Shift+G" />
				</MenuItem>
				<MenuItem Header="{DynamicResource MenuFileExportLast}" controls:MenuIcon.Drawing="ExportLast" Command="{Binding Commands.ExportLast}" HotKey="Ctrl+E" InputGesture="Ctrl+E" AutomationProperties.AutomationId="MenuExportLast" />
				<Separator />
				<MenuItem Header="{DynamicResource MenuFileClose}" controls:MenuIcon.Drawing="CloseProject" Command="{Binding Commands.CloseProject}" />
				<MenuItem Header="{DynamicResource MenuFileExit}" controls:MenuIcon.Drawing="Exit" Command="{Binding Commands.Exit}" InputGesture="Alt+F4" />
			</MenuItem>
			<MenuItem Header="{DynamicResource MenuEdit}">
				<MenuItem Header="{DynamicResource MenuEditUndo}" controls:MenuIcon.Drawing="Undo" Command="{Binding Commands.Undo}" HotKey="Ctrl+Z" InputGesture="Ctrl+Z" />
				<MenuItem Header="{DynamicResource MenuEditRedo}" controls:MenuIcon.Drawing="Redo" Command="{Binding Commands.Redo}" HotKey="Ctrl+Y" InputGesture="Ctrl+Y" />
				<Separator />
				<MenuItem Header="{DynamicResource MenuEditCut}" controls:MenuIcon.Drawing="Cut" Command="{Binding Commands.Cut}" HotKey="Ctrl+X" InputGesture="Ctrl+X" />
				<MenuItem Header="{DynamicResource MenuEditCopy}" controls:MenuIcon.Drawing="Copy" Command="{Binding Commands.Copy}" HotKey="Ctrl+C" InputGesture="Ctrl+C" />
				<MenuItem Header="{DynamicResource MenuEditPaste}" controls:MenuIcon.Drawing="Paste" Command="{Binding Commands.Paste}" HotKey="Ctrl+V" InputGesture="Ctrl+V" />
				<MenuItem Header="{DynamicResource MenuEditDelete}" controls:MenuIcon.Drawing="Delete" Command="{Binding Commands.Delete}" InputGesture="Delete" />
				<Separator />
				<MenuItem Header="{DynamicResource MenuProjectSelectAll}" controls:MenuIcon.Drawing="SelectAll" Command="{Binding Commands.SelectAll}" HotKey="Ctrl+A" InputGesture="Ctrl+A" />
			</MenuItem>
			<MenuItem Header="{DynamicResource MenuView}">
				<MenuItem Header="{DynamicResource MenuViewPanes}" controls:MenuIcon.Drawing="Panes"
				          ItemsSource="{Binding Items, ElementName=dockHost}" ItemContainerTheme="{StaticResource PaneMenuItem}" />
				<MenuItem Header="{DynamicResource MenuViewTheme}" controls:MenuIcon.Drawing="Theme"
				          ItemsSource="{Binding Options, Source={x:Static theming:ThemeController.Instance}}" ItemContainerTheme="{StaticResource ThemeMenuItem}" />
				<!-- the UI zoom (2026-11-02, the user's request): every window's content at the factor, a user setting applied
				     live (WindowZoom); the parameter is the factor with a decimal point -->
				<MenuItem Header="{DynamicResource MenuViewUiZoom}" controls:MenuIcon.Drawing="Zoom" AutomationProperties.AutomationId="MenuUiZoom">
					<MenuItem Header="{DynamicResource MenuViewUiZoom50}" ToggleType="Radio" Command="{Binding Commands.SetUiZoom}" CommandParameter="0.5"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=UiZoom, Converter={StaticResource DoubleEquals}, ConverterParameter=0.5, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuUiZoom50" />
					<MenuItem Header="{DynamicResource MenuViewUiZoom75}" ToggleType="Radio" Command="{Binding Commands.SetUiZoom}" CommandParameter="0.75"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=UiZoom, Converter={StaticResource DoubleEquals}, ConverterParameter=0.75, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuUiZoom75" />
					<MenuItem Header="{DynamicResource MenuViewUiZoom100}" ToggleType="Radio" Command="{Binding Commands.SetUiZoom}" CommandParameter="1"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=UiZoom, Converter={StaticResource DoubleEquals}, ConverterParameter=1, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuUiZoom100" />
					<MenuItem Header="{DynamicResource MenuViewUiZoom125}" ToggleType="Radio" Command="{Binding Commands.SetUiZoom}" CommandParameter="1.25"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=UiZoom, Converter={StaticResource DoubleEquals}, ConverterParameter=1.25, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuUiZoom125" />
					<MenuItem Header="{DynamicResource MenuViewUiZoom150}" ToggleType="Radio" Command="{Binding Commands.SetUiZoom}" CommandParameter="1.5"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=UiZoom, Converter={StaticResource DoubleEquals}, ConverterParameter=1.5, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuUiZoom150" />
					<MenuItem Header="{DynamicResource MenuViewUiZoom200}" ToggleType="Radio" Command="{Binding Commands.SetUiZoom}" CommandParameter="2"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=UiZoom, Converter={StaticResource DoubleEquals}, ConverterParameter=2, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuUiZoom200" />
					<MenuItem Header="{DynamicResource MenuViewUiZoom250}" ToggleType="Radio" Command="{Binding Commands.SetUiZoom}" CommandParameter="2.5"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=UiZoom, Converter={StaticResource DoubleEquals}, ConverterParameter=2.5, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuUiZoom250" />
					<MenuItem Header="{DynamicResource MenuViewUiZoom300}" ToggleType="Radio" Command="{Binding Commands.SetUiZoom}" CommandParameter="3"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=UiZoom, Converter={StaticResource DoubleEquals}, ConverterParameter=3, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuUiZoom300" />
				</MenuItem>
				<MenuItem Header="{DynamicResource MenuViewLanguage}" controls:MenuIcon.Drawing="Language"
				          ItemsSource="{Binding Options, Source={x:Static localization:LanguageController.Instance}}" ItemContainerTheme="{StaticResource LanguageMenuItem}" />
				<Separator />
				<!-- the reduced preview (2026-10-15): how much of a run is captured and kept, for weaker machines; user
				     settings, never the project's, and an export always uses a full run -->
				<MenuItem Header="{DynamicResource MenuViewResolution}" controls:MenuIcon.Drawing="PreviewResolution" AutomationProperties.AutomationId="MenuPreviewResolution">
					<MenuItem Header="{DynamicResource MenuViewResolutionFull}" ToggleType="Radio" Command="{Binding Commands.SetPreviewResolution}" CommandParameter="1"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewResolution, Converter={StaticResource IntEquals}, ConverterParameter=1, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewResolution1" />
					<MenuItem Header="{DynamicResource MenuViewResolutionHalf}" ToggleType="Radio" Command="{Binding Commands.SetPreviewResolution}" CommandParameter="2"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewResolution, Converter={StaticResource IntEquals}, ConverterParameter=2, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewResolution2" />
					<MenuItem Header="{DynamicResource MenuViewResolutionQuarter}" ToggleType="Radio" Command="{Binding Commands.SetPreviewResolution}" CommandParameter="4"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewResolution, Converter={StaticResource IntEquals}, ConverterParameter=4, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewResolution4" />
				</MenuItem>
				<MenuItem Header="{DynamicResource MenuViewFrames}" controls:MenuIcon.Drawing="PreviewFrames" AutomationProperties.AutomationId="MenuPreviewFrames">
					<MenuItem Header="{DynamicResource MenuViewFramesFull}" ToggleType="Radio" Command="{Binding Commands.SetPreviewFrames}" CommandParameter="1"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewFrames, Converter={StaticResource IntEquals}, ConverterParameter=1, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewFrames1" />
					<MenuItem Header="{DynamicResource MenuViewFramesHalf}" ToggleType="Radio" Command="{Binding Commands.SetPreviewFrames}" CommandParameter="2"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewFrames, Converter={StaticResource IntEquals}, ConverterParameter=2, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewFrames2" />
					<MenuItem Header="{DynamicResource MenuViewFramesQuarter}" ToggleType="Radio" Command="{Binding Commands.SetPreviewFrames}" CommandParameter="4"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewFrames, Converter={StaticResource IntEquals}, ConverterParameter=4, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewFrames4" />
				</MenuItem>
				<MenuItem Header="{DynamicResource MenuViewSamples}" controls:MenuIcon.Drawing="PreviewSamples" AutomationProperties.AutomationId="MenuPreviewSamples">
					<MenuItem Header="{DynamicResource MenuViewSamples16}" ToggleType="Radio" Command="{Binding Commands.SetPreviewSamples}" CommandParameter="2"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewSampleBytes, Converter={StaticResource IntEquals}, ConverterParameter=2, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewSamples2" />
					<MenuItem Header="{DynamicResource MenuViewSamples8}" ToggleType="Radio" Command="{Binding Commands.SetPreviewSamples}" CommandParameter="1"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewSampleBytes, Converter={StaticResource IntEquals}, ConverterParameter=1, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewSamples1" />
				</MenuItem>
				<!-- the dithering of the 16-bit pictures (2026-10-23): preview only, at each picture's size on screen; 8-bit samples
				     have nothing finer to dither, so the entry waits for 16-bit ones -->
				<MenuItem Header="{DynamicResource MenuViewDither}" controls:MenuIcon.Drawing="PreviewDither" AutomationProperties.AutomationId="MenuPreviewDither"
				          IsEnabled="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewSampleBytes, Converter={StaticResource IntEquals}, ConverterParameter=2, Mode=OneWay}">
					<MenuItem Header="{DynamicResource MenuViewDitherOff}" ToggleType="Radio" Command="{Binding Commands.SetPreviewDither}" CommandParameter="0"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewDitherBits, Converter={StaticResource IntEquals}, ConverterParameter=0, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewDither0" />
					<MenuItem Header="{DynamicResource MenuViewDither10}" ToggleType="Radio" Command="{Binding Commands.SetPreviewDither}" CommandParameter="10"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewDitherBits, Converter={StaticResource IntEquals}, ConverterParameter=10, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewDither10" />
					<MenuItem Header="{DynamicResource MenuViewDither12}" ToggleType="Radio" Command="{Binding Commands.SetPreviewDither}" CommandParameter="12"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewDitherBits, Converter={StaticResource IntEquals}, ConverterParameter=12, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewDither12" />
					<MenuItem Header="{DynamicResource MenuViewDither14}" ToggleType="Radio" Command="{Binding Commands.SetPreviewDither}" CommandParameter="14"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewDitherBits, Converter={StaticResource IntEquals}, ConverterParameter=14, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewDither14" />
					<MenuItem Header="{DynamicResource MenuViewDither16}" ToggleType="Radio" Command="{Binding Commands.SetPreviewDither}" CommandParameter="16"
					          IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewDitherBits, Converter={StaticResource IntEquals}, ConverterParameter=16, Mode=OneWay}"
					          AutomationProperties.AutomationId="MenuPreviewDither16" />
				</MenuItem>
			</MenuItem>
			<MenuItem Header="{DynamicResource MenuSimulation}">
				<MenuItem Header="{DynamicResource MenuSimulationRun}" controls:MenuIcon.Drawing="Run" Command="{Binding Commands.Run}" HotKey="F5" InputGesture="F5" />
				<!-- one entry pauses and resumes; its header is the window's style's, following the run's state -->
				<MenuItem x:Name="mnuPauseRun" controls:MenuIcon.Drawing="Pause" Command="{Binding Commands.TogglePause}" HotKey="F6" InputGesture="F6"
				          Classes.paused="{Binding RunHost.Run.State, Converter={StaticResource EnumOneOf}, ConverterParameter=Paused, FallbackValue=False}" />
				<MenuItem Header="{DynamicResource MenuSimulationStop}" controls:MenuIcon.Drawing="Stop" Command="{Binding Commands.Stop}" HotKey="Shift+F5" InputGesture="Shift+F5" />
				<Separator />
				<!-- the timeline's Play and Pause, F7, so the keyboard has them from anywhere (2026-11-04, the user's request):
				     the header and the glyph are the window's style's, following the preview's state -->
				<MenuItem x:Name="mnuPlayPause" Command="{Binding Commands.PlayPause}" HotKey="F7" InputGesture="F7" AutomationProperties.AutomationId="MenuPlayPause"
				          Classes.playing="{Binding Preview.IsPlaying}" />
				<Separator />
				<!-- the engine is the application's choice, not the project's: it does not change the result. The three toggles
				     flip their setting by a command and show it through a one-way mark, as the panes' entries do -->
				<MenuItem Header="{DynamicResource MenuSimulationUseGpu}" ToggleType="CheckBox" AutomationProperties.AutomationId="MenuUseGpu"
				          Command="{Binding Commands.ToggleUseGpu}" IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=UseGpu, Mode=OneWay}" />
				<MenuItem Header="{DynamicResource MenuSimulationAutoRerun}" ToggleType="CheckBox" AutomationProperties.AutomationId="MenuAutoRerun"
				          Command="{Binding Commands.ToggleAutoRerun}" IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=AutoRerun, Mode=OneWay}" />
				<!-- a run whose frames do not fit in the RAM cache asks first (the memory warning, 2026-11-03, the user's design),
				     offering a lower preview quality; its "Do not warn me again" clears this -->
				<MenuItem Header="{DynamicResource MenuSimulationWarnMemory}" ToggleType="CheckBox" AutomationProperties.AutomationId="MenuWarnMemory"
				          Command="{Binding Commands.ToggleMemoryWarning}" IsChecked="{Binding Source={x:Static ui:Settings.Default}, Path=WarnWhenRamInsufficient, Mode=OneWay}" />
				<!-- the memory a run's frames may take before the rest goes to disk: the application decides from what is free
				     ("Auto", 2026-10-15), a percentage of the RAM is only an upper bound on that -->
				<MenuItem Header="{DynamicResource MenuSimulationFrameMemory}" controls:MenuIcon.Drawing="FrameMemory" AutomationProperties.AutomationId="MenuFrameMemory"
				          ItemsSource="{x:Static local:MainWindow.FrameMemoryOptions}" ItemContainerTheme="{StaticResource FrameMemoryMenuItem}" />
			</MenuItem>
			<MenuItem Header="{DynamicResource MenuHelp}">
				<MenuItem Header="{DynamicResource MenuHelpAbout}" controls:MenuIcon.Drawing="About" Command="{Binding Commands.About}" />
				<MenuItem Header="{DynamicResource MenuHelpManual}" controls:MenuIcon.Drawing="Manual" Command="{Binding Commands.Manual}" HotKey="F1" InputGesture="F1" />
			</MenuItem>
		</Menu>

		<!-- the status bar: the last log line (double-click opens the Messages pane), the busy indicator and the run's state on the right -->
		<Border x:Name="statusBar" DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackground}" MinHeight="22" Padding="4,0,16,0">
			<DockPanel>
				<!-- the busy indicator (2026-11-11, as the WPF head's): an export (frames done), an export waiting for its run or a
				     scratch frame being computed for the preview (indeterminate) -->
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock AutomationProperties.AutomationId="StatusExport" Foreground="{DynamicResource StatusBarForeground}" VerticalAlignment="Center">
						<TextBlock.Text>
							<MultiBinding Converter="{StaticResource BusyText}">
								<Binding Path="Busy.Kind" />
								<Binding Path="Busy.FramesDone" />
								<Binding Path="Busy.FrameCount" />
								<Binding Path="Busy.ComputingFrame" />
								<Binding Path="Current" Source="{x:Static localization:LanguageController.Instance}" />
							</MultiBinding>
						</TextBlock.Text>
					</TextBlock>
					<ProgressBar Width="120" Height="12" Margin="6,0,8,0" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource TipExportCancel}"
					             Minimum="0" Maximum="1" Value="{Binding Busy.Share, Mode=OneWay}" IsIndeterminate="{Binding Busy.IsIndeterminate}"
					             IsVisible="{Binding Busy.IsBusy}" AutomationProperties.AutomationId="StatusBusyBar" />
				</StackPanel>
				<TextBlock DockPanel.Dock="Right" AutomationProperties.AutomationId="StatusRun" Foreground="{DynamicResource StatusBarForeground}" VerticalAlignment="Center" Margin="4,2">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource RunStatus}">
							<Binding Path="RunHost.Run.State" />
							<Binding Path="RunHost.Run.StepsDone" />
							<Binding Path="RunHost.Run.TotalSteps" />
							<Binding Path="RunHost.Run.EngineDescription" />
							<Binding Path="RunHost.IsRunStale" />
							<!-- the language, so the words follow a switch -->
							<Binding Path="Current" Source="{x:Static localization:LanguageController.Instance}" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
				<TextBlock x:Name="txtStatus" AutomationProperties.AutomationId="StatusMessage" Text="{DynamicResource Ready}" Foreground="{DynamicResource StatusBarForeground}" VerticalAlignment="Center" Margin="4,2" TextTrimming="CharacterEllipsis" />
			</DockPanel>
		</Border>

		<docking:DockHost x:Name="dockHost">
			<!-- the arrangement of a first start (agreed 2026-10-09): a left column of a quarter of the width with the Project
			     tree in its upper third and the Properties pane below it, the preview in the rest; Messages hidden. Loaded by
			     the window when no saved layout applies -->
			<docking:DockHost.DefaultLayout>
				<layout:DockLayout>
					<layout:DockLayout.Root>
						<layout:SplitLayout Orientation="Horizontal">
							<layout:SplitLayout.Children>
								<layout:SplitLayout Orientation="Vertical" Length="1">
									<layout:SplitLayout.Children>
										<layout:GroupLayout Active="project" Length="1">
											<layout:GroupLayout.Items><x:String>project</x:String></layout:GroupLayout.Items>
										</layout:GroupLayout>
										<layout:GroupLayout Active="properties" Length="2">
											<layout:GroupLayout.Items><x:String>properties</x:String></layout:GroupLayout.Items>
										</layout:GroupLayout>
									</layout:SplitLayout.Children>
								</layout:SplitLayout>
								<layout:DocumentLayout Length="3" />
							</layout:SplitLayout.Children>
						</layout:SplitLayout>
					</layout:DockLayout.Root>
				</layout:DockLayout>
			</docking:DockHost.DefaultLayout>
			<docking:DockHost.Items>
				<docking:DockItem Id="project" Title="{StaticResource PaneProject}" DefaultSide="Left">
					<panes:ProjectTree x:Name="projectTree" Project="{Binding Document.Project}" SelectedItem="{Binding Selection.Current, Mode=TwoWay}"
					                   SelectedItems="{Binding Selection.Items}" Commands="{Binding Commands}"
					                   RevealRequest="{Binding Selection.RevealRequest}" />
				</docking:DockItem>
				<docking:DockItem Id="properties" Title="{StaticResource PaneProperties}" DefaultSide="Right">
					<panes:PropertiesPane x:Name="propertiesPane" SelectedObject="{Binding Selection.Current}" Project="{Binding Document.Project}"
					                      Commands="{Binding Commands}" SceneImageFileMissing="{Binding SceneImage.IsFileMissing}"
					                      RevealRequest="{Binding Selection.RevealRequest}" />
				</docking:DockItem>
				<docking:DockItem Id="messages" Title="{StaticResource PaneMessages}" DefaultSide="Bottom">
					<panes:MessagesPane x:Name="messagesPane" TargetName="messages" />
				</docking:DockItem>
			</docking:DockHost.Items>
			<docking:DockHost.DocumentContent>
				<Border BorderThickness="1" BorderBrush="{DynamicResource ToolWindowBorder}">
					<panes:PreviewPane x:Name="previewPane" Project="{Binding Document.Project}" Run="{Binding RunHost.Run}" Commands="{Binding Commands}"
					                   SelectedItem="{Binding Selection.Current, Mode=TwoWay}" SelectedItems="{Binding Selection.Items}"
					                   IsStale="{Binding RunHost.IsRunStale}" IsProbesStale="{Binding RunHost.IsProbesStale}" ScratchFrame="{Binding Live.ScratchFrame}"
					                   ScenePixels="{Binding SceneComposer.Pixels}" IsComputing="{Binding Busy.IsComputingFrame}"
					                   Position="{Binding Preview.Position, Mode=TwoWay}" IsPlaying="{Binding Preview.IsPlaying, Mode=TwoWay}" IsPlaybackHeld="{Binding Preview.IsPlaybackHeld}"
					                   ColorsVersion="{Binding Preview.ColorsVersion}"
					                   ShownFrame="{Binding Preview.ShownFrame, Mode=OneWayToSource}"
					                   CanvasWidth="{Binding Preview.CanvasWidth, Mode=OneWayToSource}" CanvasHeight="{Binding Preview.CanvasHeight, Mode=OneWayToSource}"
					                   Orientation="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewOrientation, Mode=TwoWay, Converter={StaticResource EnumByName}}"
					                   DitherBits="{Binding Source={x:Static ui:Settings.Default}, Path=PreviewDitherBits}" />
				</Border>
			</docking:DockHost.DocumentContent>
		</docking:DockHost>
	</DockPanel>
</Window>
