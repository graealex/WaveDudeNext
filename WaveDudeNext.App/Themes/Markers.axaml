<!-- The handles of the sources, parts and probes on the pictures (upstream's Panes/PreviewPane.xaml:169-306, as control
     themes the SceneOverlay assigns per role): a ring for a source, a ring with an inner ring for a part (a lens-shaped
     glyph read as squashed, 2026-10-18), a square for a probe point, each with four crosshair ticks outside it and a gap
     around the exact pixel; every stroke is drawn twice, a dark halo first, so the glyph reads on any picture. The
     selected item's handle shows the selection yellow, the focused handle the accent fill. Every thumb is odd-sized with
     its point at the centre pixel (the 21 x 21 glyphs at (10.5, 10.5)), the shapes inside odd too, because the point
     marks a pixel's centre and the layout rounding rounds the thumb and each shape to whole pixels: a 20 px thumb put its
     origin on a half pixel, and the 3 px dot, its 5 px halo and the crosshair came out half a pixel apart (2026-10-26,
     Jeroen's report). The glyphs are the shared geometries of Themes/Icons.axaml. Cursors: SizeAll for a point that moves, the diagonal
     corner cursor for a grip (Avalonia has no SizeNWSE; BottomRightCorner is its diagonal resize cursor), Hand for a
     lever or a Bézier handle. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:WaveDudeNext.App.Controls">

	<!-- the shared look and states: PictureHandle grey, the selection yellow for the selected item (:selected), the
	     accent fill and a thicker stroke under keyboard focus (:focus), the thicker stroke under the pointer -->
	<ControlTheme x:Key="MarkerBase" TargetType="controls:MarkerThumb">
		<Setter Property="Width" Value="21" />
		<Setter Property="Height" Value="21" />
		<Setter Property="Cursor" Value="SizeAll" />
		<Setter Property="Foreground" Value="{DynamicResource PictureHandle}" />
		<Setter Property="Background" Value="#60000000" />
		<Setter Property="BorderBrush" Value="{DynamicResource PictureHandle}" />
		<Setter Property="StrokeThickness" Value="1.5" />
		<Style Selector="^:selected">
			<Setter Property="BorderBrush" Value="{DynamicResource PictureSelection}" />
			<Setter Property="Foreground" Value="{DynamicResource PictureSelection}" />
		</Style>
		<Style Selector="^:focus">
			<Setter Property="Background" Value="{DynamicResource DropPreviewFill}" />
			<Setter Property="StrokeThickness" Value="2.5" />
		</Style>
		<Style Selector="^:pointerover">
			<Setter Property="StrokeThickness" Value="2.5" />
		</Style>
	</ControlTheme>

	<!-- a source: ring r6 plus four crosshair ticks plus a 3 px dot on a 5 px black dot, over a 13 px background disc -->
	<ControlTheme x:Key="SourceMarker" TargetType="controls:MarkerThumb" BasedOn="{StaticResource MarkerBase}">
		<Setter Property="Template">
			<ControlTemplate TargetType="controls:MarkerThumb">
				<Panel Background="Transparent">
					<Ellipse Width="13" Height="13" Fill="{TemplateBinding Background}" />
					<Path Data="{StaticResource SourceGlyph}" Stroke="Black" StrokeThickness="{TemplateBinding HaloThickness}" StrokeLineCap="Round" Opacity="0.75" />
					<Path Data="{StaticResource SourceGlyph}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding StrokeThickness}" StrokeLineCap="Round" />
					<Ellipse Width="5" Height="5" Fill="Black" Opacity="0.75" />
					<Ellipse Width="3" Height="3" Fill="{TemplateBinding Foreground}" />
				</Panel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<!-- a part's centre: ring r6 plus inner ring r2.5 plus ticks -->
	<ControlTheme x:Key="PartMarker" TargetType="controls:MarkerThumb" BasedOn="{StaticResource MarkerBase}">
		<Setter Property="Template">
			<ControlTemplate TargetType="controls:MarkerThumb">
				<Panel Background="Transparent">
					<Ellipse Width="13" Height="13" Fill="{TemplateBinding Background}" />
					<Path Data="{StaticResource PartGlyph}" Stroke="Black" StrokeThickness="{TemplateBinding HaloThickness}" StrokeLineCap="Round" StrokeJoin="Round" Opacity="0.75" />
					<Path Data="{StaticResource PartGlyph}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding StrokeThickness}" StrokeLineCap="Round" StrokeJoin="Round" />
				</Panel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<!-- a part's size grip: a small filled square on the outline's corner; not rotated with the part -->
	<ControlTheme x:Key="PartGripMarker" TargetType="controls:MarkerThumb" BasedOn="{StaticResource MarkerBase}">
		<Setter Property="Width" Value="15" />
		<Setter Property="Height" Value="15" />
		<Setter Property="Cursor" Value="BottomRightCorner" />
		<Setter Property="Template">
			<ControlTemplate TargetType="controls:MarkerThumb">
				<Panel Background="Transparent">
					<Rectangle Width="9" Height="9" Fill="Black" Opacity="0.75" />
					<Rectangle Width="7" Height="7" Fill="{TemplateBinding BorderBrush}" />
				</Panel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<!-- a point of an outline or a node of a fibre: a small ring -->
	<ControlTheme x:Key="PartPointMarker" TargetType="controls:MarkerThumb" BasedOn="{StaticResource MarkerBase}">
		<Setter Property="Width" Value="15" />
		<Setter Property="Height" Value="15" />
		<Setter Property="Template">
			<ControlTemplate TargetType="controls:MarkerThumb">
				<Panel Background="Transparent">
					<Ellipse Width="11" Height="11" Fill="{TemplateBinding Background}" Stroke="Black" StrokeThickness="{TemplateBinding HaloThickness}" Opacity="0.75" />
					<Ellipse Width="11" Height="11" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding StrokeThickness}" />
				</Panel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<!-- a fibre node's Bézier handle, and a lens surface's vertex: a small filled dot at the end of its dotted line (2026-10-22) -->
	<ControlTheme x:Key="FiberHandleMarker" TargetType="controls:MarkerThumb" BasedOn="{StaticResource MarkerBase}">
		<Setter Property="Width" Value="13" />
		<Setter Property="Height" Value="13" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<ControlTemplate TargetType="controls:MarkerThumb">
				<Panel Background="Transparent">
					<Ellipse Width="9" Height="9" Fill="Black" Opacity="0.75" />
					<Ellipse Width="7" Height="7" Fill="{TemplateBinding BorderBrush}" />
				</Panel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<!-- the rotation lever of a composite source or a part: a 15 px disc with an arc-arrow glyph -->
	<ControlTheme x:Key="AngleMarker" TargetType="controls:MarkerThumb" BasedOn="{StaticResource MarkerBase}">
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<ControlTemplate TargetType="controls:MarkerThumb">
				<Panel Background="Transparent">
					<Ellipse Width="15" Height="15" Fill="{TemplateBinding Background}" />
					<Path Data="{StaticResource AngleGlyph}" Stroke="Black" StrokeThickness="{TemplateBinding HaloThickness}" StrokeLineCap="Round" StrokeJoin="Round" Opacity="0.75" />
					<Path Data="{StaticResource AngleGlyph}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding StrokeThickness}" StrokeLineCap="Round" StrokeJoin="Round" />
				</Panel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<!-- a probe's point: an 11 px square plus ticks plus a 3 px dot on a 5 px black dot -->
	<ControlTheme x:Key="ProbeMarker" TargetType="controls:MarkerThumb" BasedOn="{StaticResource MarkerBase}">
		<Setter Property="Template">
			<ControlTemplate TargetType="controls:MarkerThumb">
				<Panel Background="Transparent">
					<Rectangle Width="11" Height="11" Fill="{TemplateBinding Background}" />
					<Path Data="{StaticResource ProbeGlyph}" Stroke="Black" StrokeThickness="{TemplateBinding HaloThickness}" StrokeJoin="Round" StrokeLineCap="Round" Opacity="0.75" />
					<Path Data="{StaticResource ProbeGlyph}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding StrokeThickness}" StrokeJoin="Round" StrokeLineCap="Round" />
					<Rectangle Width="5" Height="5" Fill="Black" Opacity="0.75" />
					<Rectangle Width="3" Height="3" Fill="{TemplateBinding Foreground}" />
				</Panel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>
</ResourceDictionary>
