<!-- The project tree's own styles (upstream Themes/Controls.xaml:557-665 and Panes/ProjectTree.xaml:39-109), loaded by the
     pane alone (Panes/ProjectTree.axaml, UserControl.Styles), so no generic TreeView style lives anywhere else: the keyed
     control themes for the tree, its rows, the chevron expander, the rows' check box and the three kinds of button, and
     the class styles for a row's state. Colours are the theme table's (Themes/Dark.axaml, Light.axaml) through
     DynamicResource; square, 1 px borders, no shadows, as everywhere in the port (ADR 0002). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:WaveDudeNext.App.Localization"
        xmlns:controls="using:WaveDudeNext.App.Controls"
        xmlns:converters="using:WaveDudeNext.App.Converters"
        x:CompileBindings="False">

	<Styles.Resources>
		<converters:TreeIdConverter x:Key="TreeId" />
		<converters:TreeNameConverter x:Key="TreeName" />

		<!-- the glyphs of the row and toolbar buttons (PlusGeometry, MinusGeometry and the two that move a row, RowUpGeometry
		     and RowDownGeometry, smaller than the 10 px chevrons), the expander's chevrons, the Part button's drop-down
		     arrow and the check mark are the shared geometries of Themes/Icons.axaml, which the application merges -->

		<!-- the tree: no border, 2 px padding, the tool window's colours -->
		<ControlTheme x:Key="ProjectTreeTheme" TargetType="TreeView">
			<Setter Property="Background" Value="{DynamicResource TreeViewBackground}" />
			<Setter Property="Foreground" Value="{DynamicResource TreeViewForeground}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="2" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
						<ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="{TemplateBinding Padding}">
							<ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
						</ScrollViewer>
					</Border>
				</ControlTemplate>
			</Setter>
		</ControlTheme>

		<!-- the expander: a 16 px box with a 5 x 10 chevron, right when closed and down when open, the glyph colour and its
		     hover colour; a pixel above the middle of the 23 px row, where the 16 px icons beside it round to, so the chevrons
		     centre on the text (upstream Controls.xaml:577-601) -->
		<ControlTheme x:Key="ProjectTreeExpanderTheme" TargetType="ToggleButton">
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="Width" Value="16" />
			<Setter Property="Height" Value="16" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="Transparent" Margin="0,0,0,1">
						<Path Name="Glyph" Data="{StaticResource ChevronRightGeometry}" Stroke="{DynamicResource TreeViewGlyph}" StrokeThickness="1"
						      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
					</Border>
				</ControlTemplate>
			</Setter>
			<Style Selector="^:checked /template/ Path#Glyph">
				<Setter Property="Data" Value="{StaticResource ChevronDownGeometry}" />
				<Setter Property="Margin" Value="0,2,0,0" />
			</Style>
			<Style Selector="^:pointerover /template/ Path#Glyph">
				<Setter Property="Stroke" Value="{DynamicResource TreeViewGlyphHover}" />
			</Style>
		</ControlTheme>

		<!-- a row: 23 px high (upstream's 2026-10-23 request for more room), no padding above or below, so the 15 px text line
		     and the 16 px icons centre on it; the expander in a 16 px column, the children indented by that column; every
		     row expanded at first. The header Border takes the keyboard focus for the row (Avalonia's template focus target,
		     as the Fluent theme does); the focus shows as the selection's active colour, as in the WPF tree, with no border
		     or adorner. The automation id is the TreeId rule's, bound to the node once (a reflection binding: the row's node
		     has no compile-time type). -->
		<ControlTheme x:Key="ProjectTreeItemTheme" TargetType="TreeViewItem">
			<Setter Property="Foreground" Value="{DynamicResource TreeViewForeground}" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Padding" Value="3,0" />
			<Setter Property="IsExpanded" Value="True" />
			<!-- no focus rectangle around a row: the focused row is the selected one, which the active selection colour
			     shows, as in the WPF tree (2026-11-11: Avalonia's default adorner had drawn a white frame round it) -->
			<Setter Property="FocusAdorner" Value="{x:Null}" />
			<!-- the id keeps the name the row was made with (the harnesses find a renamed row by it); the name is the text the row
			     shows, following a rename and a language switch, which the WPF head's rows give UI Automation by themselves. Both are
			     reflection bindings (x:CompileBindings off for this file): a row's data context has no one type -->
			<Setter Property="AutomationProperties.AutomationId" Value="{Binding Converter={StaticResource TreeId}}" />
			<Setter Property="AutomationProperties.Name">
				<Setter.Value>
					<MultiBinding Converter="{StaticResource TreeName}" Mode="OneWay">
						<Binding />
						<Binding Path="Name" />
						<Binding Path="Current" Source="{x:Static localization:LanguageController.Instance}" />
					</MultiBinding>
				</Setter.Value>
			</Setter>
			<Setter Property="Template">
				<ControlTemplate>
					<Grid ColumnDefinitions="16,*" RowDefinitions="Auto,*">
						<ToggleButton Name="PART_ExpandCollapseChevron" Theme="{StaticResource ProjectTreeExpanderTheme}"
						              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" VerticalAlignment="Center" />
						<!-- no border: Avalonia fills a Border's background inside a geometry inset by half its border thickness,
						     so a 1 px transparent border had put the selected row's edges on half pixels, a blended line round
						     the fill, where the WPF row is a plain 23 px fill (2026-11-11, the look brought to the WPF head's) -->
						<Border Name="PART_LayoutRoot" Grid.Column="1" Focusable="True" TemplatedControl.IsTemplateFocusTarget="True"
						        Background="{TemplateBinding Background}" BorderThickness="0"
						        MinHeight="23" Padding="{TemplateBinding Padding}">
							<ContentPresenter Name="PART_HeaderPresenter" Focusable="False"
							                  Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
							                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
						</Border>
						<ItemsPresenter Name="PART_ItemsPresenter" Grid.Row="1" Grid.Column="1"
						                IsVisible="{TemplateBinding IsExpanded}" ItemsPanel="{TemplateBinding ItemsPanel}" />
					</Grid>
				</ControlTemplate>
			</Setter>
			<Style Selector="^ /template/ Border#PART_LayoutRoot:pointerover">
				<Setter Property="Background" Value="{DynamicResource TreeViewItemHover}" />
			</Style>
			<Style Selector="^:selected /template/ Border#PART_LayoutRoot">
				<Setter Property="Background" Value="{DynamicResource TreeViewItemSelected}" />
			</Style>
			<Style Selector="^:selected">
				<Setter Property="Foreground" Value="{DynamicResource TreeViewItemSelectedForeground}" />
			</Style>
			<Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
				<Setter Property="IsVisible" Value="False" />
			</Style>
			<Style Selector="^:disabled">
				<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
			</Style>
		</ControlTheme>

		<!-- the rows' check box (Enabled, Active): a 14 px box with the check mark stroked 1.5, out of the Tab cycle (Space
		     on the row toggles it); hover and focus an accent border, as upstream's CheckBox (Editors.xaml:131-164) -->
		<ControlTheme x:Key="RowCheckBox" TargetType="CheckBox">
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="Box" Width="14" Height="14" Background="{DynamicResource CheckBoxBackground}"
					        BorderBrush="{DynamicResource CheckBoxBorder}" BorderThickness="1">
						<Path Name="Glyph" Data="{DynamicResource CheckGeometry}" Stroke="{DynamicResource WindowForeground}" StrokeThickness="1.5"
						      HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
					</Border>
				</ControlTemplate>
			</Setter>
			<Style Selector="^:checked /template/ Path#Glyph">
				<Setter Property="IsVisible" Value="True" />
			</Style>
			<Style Selector="^:pointerover /template/ Border#Box">
				<Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
			</Style>
			<Style Selector="^:disabled /template/ Border#Box">
				<Setter Property="Opacity" Value="0.5" />
			</Style>
		</ControlTheme>

		<!-- the stroked-glyph button of the rows, out of the Tab cycle (the toolbar and the context menu do the same);
		     Content is the geometry (upstream ProjectTree.xaml:44-76) -->
		<ControlTheme x:Key="GlyphButton" TargetType="Button">
			<Setter Property="Width" Value="18" />
			<Setter Property="Height" Value="18" />
			<Setter Property="Margin" Value="1,0" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<!-- the keyboard focus is the accent border alone, as in WPF (2026-11-11: Avalonia's default adorner had drawn
			     its white frame round the toolbar's focused buttons as well) -->
			<Setter Property="FocusAdorner" Value="{x:Null}" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
						<Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
						      HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
				</ControlTemplate>
			</Setter>
			<Style Selector="^:pointerover /template/ Border#Bd">
				<Setter Property="Background" Value="{DynamicResource ButtonHover}" />
			</Style>
			<Style Selector="^:focus /template/ Border#Bd">
				<Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
			</Style>
			<Style Selector="^:disabled">
				<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
				<Setter Property="Opacity" Value="0.5" />
			</Style>
		</ControlTheme>
		<!-- the toolbar's glyph buttons are in the Tab cycle (upstream 2026-10-15, the keyboard-first rule) -->
		<ControlTheme x:Key="ToolGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
			<Setter Property="Focusable" Value="True" />
			<Setter Property="IsTabStop" Value="True" />
		</ControlTheme>

		<!-- the toolbar's add buttons (upstream 2026-10-23, the user's choice): flat like the glyph buttons beside them, the
		     hover background and, with the keyboard focus, the accent border; an icon with the add plus, then the label.
		     23 px high, the height of the tree's rows, the content one pixel down, where the 16 px icon and the text line
		     both centre; pressed, the accent fills it and the text turns white -->
		<ControlTheme x:Key="TextButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
			<Setter Property="FocusAdorner" Value="{x:Null}" />
			<Setter Property="Padding" Value="6,1,6,0" />
			<Setter Property="Margin" Value="1,0" />
			<Setter Property="Height" Value="23" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
					        Padding="{TemplateBinding Padding}">
						<ContentPresenter Name="PART_ContentPresenter" Focusable="False"
						                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
						                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
					</Border>
				</ControlTemplate>
			</Setter>
			<Style Selector="^:pointerover /template/ Border#Bd">
				<Setter Property="Background" Value="{DynamicResource ButtonHover}" />
			</Style>
			<Style Selector="^:focus /template/ Border#Bd">
				<Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
			</Style>
			<Style Selector="^:pressed /template/ Border#Bd">
				<Setter Property="Background" Value="{DynamicResource ButtonPressed}" />
			</Style>
			<Style Selector="^:pressed">
				<Setter Property="Foreground" Value="White" />
			</Style>
			<Style Selector="^:disabled">
				<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
			</Style>
		</ControlTheme>
	</Styles.Resources>

	<!-- a row whose item is switched off greys its icon and name: both take the text colour the row's panel passes down,
	     so one setter on the panel does for both; the glyph buttons hold their own colour (upstream's DisabledRow and
	     InactiveRow styles). The row sets the class from Enabled or Active. -->
	<Style Selector="DockPanel.row.off">
		<Setter Property="TextElement.Foreground" Value="{DynamicResource GrayText}" />
	</Style>

	<!-- a row in the multi-selection beside the current one: the inactive-selection colours; the TreeView's own selection
	     (the current row) is drawn by the item theme and wins (upstream's IsInSelection trigger). The pane sets the class and
	     the ItemStatus "InSelection" a harness reads. -->
	<Style Selector="TreeViewItem.inSelection:not(:selected) /template/ Border#PART_LayoutRoot">
		<Setter Property="Background" Value="{DynamicResource TreeViewItemSelectedInactive}" />
	</Style>
	<Style Selector="TreeViewItem.inSelection:not(:selected)">
		<Setter Property="Foreground" Value="{DynamicResource TreeViewItemSelectedInactiveForeground}" />
	</Style>

	<!-- the selected row while the keyboard focus is elsewhere: the inactive colours (upstream's IsSelectionActive trigger);
	     the pane sets the class from the tree's IsKeyboardFocusWithin -->
	<Style Selector="TreeView.inactive TreeViewItem:selected /template/ Border#PART_LayoutRoot">
		<Setter Property="Background" Value="{DynamicResource TreeViewItemSelectedInactive}" />
	</Style>
	<Style Selector="TreeView.inactive TreeViewItem:selected">
		<Setter Property="Foreground" Value="{DynamicResource TreeViewItemSelectedInactiveForeground}" />
	</Style>

	<!-- the plus badge of an add button's icon takes the text colour where the accent is the background (a pressed button) -->
	<Style Selector="Button:pressed controls|IconView">
		<Setter Property="BadgeBrush" Value="{Binding $self.Foreground}" />
	</Style>
</Styles>
