<!-- The preview pane's control themes (upstream's PreviewPane.xaml resources): the transport bar's 22 x 22
     buttons and toggles with a filled Path glyph (Content is the geometry), the split radios, the probe graph box thumbs,
     the picture splitter and the busy spinner. Brushes come from the theme dictionaries through DynamicResource; the
     glyphs are the shared geometries of Themes/Icons.axaml (the WPF head's Icons.xaml converted at build), named by
     key. Included by the pane (UserControl.Styles). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Styles.Resources>
		<ResourceDictionary>
			<!-- the glyphs (the transport bar's, the spinner's ring, a graph box's resize grip) are the shared geometries of
			     Themes/Icons.axaml, which the application merges -->

			<!-- filled-glyph transport button; Content is the geometry. A tab stop: keyboard focus shows as an accent border and
			     nothing else (no adorner; :focus, not :focus-visible, since WPF's IsKeyboardFocused holds after a click too;
			     2026-11-11, the focus look brought to the WPF head's) -->
			<ControlTheme x:Key="TransportButton" TargetType="Button">
				<Setter Property="Width" Value="22" />
				<Setter Property="Height" Value="22" />
				<Setter Property="Margin" Value="1,0" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="FocusAdorner" Value="{x:Null}" />
				<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
				<Setter Property="Template">
					<ControlTemplate>
						<Border Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
							<Path Data="{TemplateBinding Content}" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter>
				<Style Selector="^:pointerover /template/ Border#Bd">
					<Setter Property="Background" Value="{DynamicResource ButtonHover}" />
				</Style>
				<Style Selector="^:focus /template/ Border#Bd">
					<Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
				</Style>
				<Style Selector="^:pressed /template/ Border#Bd">
					<Setter Property="Background" Value="{DynamicResource ButtonPressed}" />
				</Style>
				<Style Selector="^:pressed">
					<Setter Property="Foreground" Value="White" />
				</Style>
				<Style Selector="^:disabled">
					<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
					<Setter Property="Opacity" Value="0.5" />
				</Style>
			</ControlTheme>

			<!-- glyph toggle button; the checked one stays pressed. The toggles share the buttons' look, including the greyed,
			     half-transparent disabled state (Live without a run) -->
			<ControlTheme x:Key="TransportToggle" TargetType="ToggleButton">
				<Setter Property="Width" Value="22" />
				<Setter Property="Height" Value="22" />
				<Setter Property="Margin" Value="1,0" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="FocusAdorner" Value="{x:Null}" />
				<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
				<Setter Property="Template">
					<ControlTemplate>
						<Border Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
							<Path Data="{TemplateBinding Content}" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter>
				<Style Selector="^:pointerover /template/ Border#Bd">
					<Setter Property="Background" Value="{DynamicResource ButtonHover}" />
				</Style>
				<Style Selector="^:focus /template/ Border#Bd">
					<Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
				</Style>
				<Style Selector="^:checked /template/ Border#Bd">
					<Setter Property="Background" Value="{DynamicResource ButtonPressed}" />
				</Style>
				<Style Selector="^:checked">
					<Setter Property="Foreground" Value="White" />
				</Style>
				<Style Selector="^:disabled">
					<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
					<Setter Property="Opacity" Value="0.5" />
				</Style>
			</ControlTheme>

			<!-- the split radios: the same look; their group is one tab stop with Left/Right inside (see the pane) -->
			<ControlTheme x:Key="TransportRadio" TargetType="RadioButton">
				<Setter Property="Width" Value="22" />
				<Setter Property="Height" Value="22" />
				<Setter Property="Margin" Value="1,0" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="FocusAdorner" Value="{x:Null}" />
				<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
				<Setter Property="Template">
					<ControlTemplate>
						<Border Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
							<Path Data="{TemplateBinding Content}" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter>
				<Style Selector="^:pointerover /template/ Border#Bd">
					<Setter Property="Background" Value="{DynamicResource ButtonHover}" />
				</Style>
				<Style Selector="^:focus /template/ Border#Bd">
					<Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
				</Style>
				<Style Selector="^:checked /template/ Border#Bd">
					<Setter Property="Background" Value="{DynamicResource ButtonPressed}" />
				</Style>
				<Style Selector="^:checked">
					<Setter Property="Foreground" Value="White" />
				</Style>
				<Style Selector="^:disabled">
					<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
					<Setter Property="Opacity" Value="0.5" />
				</Style>
			</ControlTheme>

			<!-- a probe's graph box: the thumb covering the box (transparent; focus and hover show a border) and the resize
			     grip at its bottom-right corner. The box itself is drawn by the overlay -->
			<ControlTheme x:Key="ProbeBoxThumb" TargetType="Thumb">
				<Setter Property="Cursor" Value="SizeAll" />
				<Setter Property="FocusAdorner" Value="{x:Null}" />
				<Setter Property="Template">
					<ControlTemplate>
						<Border Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" />
					</ControlTemplate>
				</Setter>
				<Style Selector="^:pointerover /template/ Border#Bd">
					<Setter Property="BorderBrush" Value="#80FFFFFF" />
				</Style>
				<Style Selector="^:focus /template/ Border#Bd">
					<Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
					<Setter Property="BorderThickness" Value="2" />
				</Style>
			</ControlTheme>
			<ControlTheme x:Key="ProbeBoxCornerThumb" TargetType="Thumb">
				<Setter Property="Width" Value="12" />
				<Setter Property="Height" Value="12" />
				<Setter Property="FocusAdorner" Value="{x:Null}" />
				<Setter Property="Cursor" Value="BottomRightCorner" />
				<Setter Property="Foreground" Value="#A0FFFFFF" />
				<Setter Property="Template">
					<ControlTemplate>
						<Panel Background="Transparent">
							<Path Data="{StaticResource ResizeGripGlyph}" Fill="{TemplateBinding Foreground}" />
						</Panel>
					</ControlTemplate>
				</Setter>
				<Style Selector="^:pointerover">
					<Setter Property="Foreground" Value="White" />
				</Style>
				<Style Selector="^:focus">
					<Setter Property="Foreground" Value="{DynamicResource Accent}" />
				</Style>
			</ControlTheme>

			<!-- the splitter between the pictures: a tab stop, arrows move it, Enter or a double-click puts it back in the middle -->
			<ControlTheme x:Key="PictureSplitter" TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}">
				<Setter Property="Background" Value="{DynamicResource SplitterBackground}" />
				<Setter Property="FocusAdorner" Value="{x:Null}" />
				<Style Selector="^:pointerover">
					<Setter Property="Background" Value="{DynamicResource ButtonHover}" />
				</Style>
				<Style Selector="^:focus">
					<Setter Property="Background" Value="{DynamicResource Accent}" />
				</Style>
			</ControlTheme>
		</ResourceDictionary>
	</Styles.Resources>

	<!-- the spinner turns once a second while it carries the class, which the pane sets while the busy layer is shown -->
	<Style Selector="Path.spinning">
		<Style.Animations>
			<Animation Duration="0:0:1" IterationCount="INFINITE">
				<KeyFrame Cue="0%">
					<Setter Property="RotateTransform.Angle" Value="0" />
				</KeyFrame>
				<KeyFrame Cue="100%">
					<Setter Property="RotateTransform.Angle" Value="360" />
				</KeyFrame>
			</Animation>
		</Style.Animations>
	</Style>
</Styles>
