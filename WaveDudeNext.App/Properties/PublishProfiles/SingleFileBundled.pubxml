<?xml version="1.0" encoding="utf-8"?>
<!-- Single-file, self-contained publish of the Avalonia head for 64-bit Windows (2026-11-11, the user's request: the
     counterpart of the WPF head's profile of this name, with the same properties): one EXE in bin\PublishBundled with
     the .NET runtime inside, so nothing has to be installed on the user's machine, named
     WaveDudeNext-<version>-avalonia-bundled.exe for the release by the project's NameReleaseFile target, no symbol files
     beside it. The counterpart of SingleFile.pubxml, which leaves the runtime to the machine and says what
     IncludeAllContentForSelfExtract does here. No ReadyToRun, as in the WPF head's profiles (2026-11-03): CLAUDE.md under
     Publish says why, and names the SDK trap a return would have to mind.
     dotnet publish WaveDudeNext.App/WaveDudeNext.App.csproj -p:PublishProfile=SingleFileBundled -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\PublishBundled\</PublishDir>
    <NameReleaseFile>true</NameReleaseFile>
    <ReleaseFileSuffix>-avalonia-bundled</ReleaseFileSuffix>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
