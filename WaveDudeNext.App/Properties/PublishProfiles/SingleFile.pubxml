<?xml version="1.0" encoding="utf-8"?>
<!-- Single-file, framework-dependent publish of the Avalonia head for 64-bit Windows (2026-11-11, the user's request: the
     counterpart of the WPF head's profile of this name, with the same properties): one EXE in bin\Publish, named
     WaveDudeNext-<version>-avalonia.exe for the release by the project's NameReleaseFile target, with Avalonia's
     assemblies and its three native libraries (Skia, HarfBuzz, ANGLE) inside, the colour schemes and the examples
     embedded, no symbol files beside it. The .NET Runtime must be on the user's machine, the plain one, where the WPF
     head needs the Desktop Runtime; without it the host shows Microsoft's "You must install .NET" dialog with the
     download link. SingleFileBundled.pubxml is the self-contained counterpart.
     IncludeAllContentForSelfExtract is what puts the native libraries into the EXE (without it, or the narrower
     IncludeNativeLibrariesForSelfExtract, the three DLLs lie beside it): the host unpacks the EXE's content under
     %TEMP%\.net at the first start of a build and runs it from there. The log still lands beside the EXE, since the app
     goes by the process path.
     No ReadyToRun, as in the WPF head's profiles (2026-11-03): CLAUDE.md under Publish says why.
     dotnet publish WaveDudeNext.App/WaveDudeNext.App.csproj -p:PublishProfile=SingleFile -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Publish\</PublishDir>
    <NameReleaseFile>true</NameReleaseFile>
    <ReleaseFileSuffix>-avalonia</ReleaseFileSuffix>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
