<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WaveDudeNext.App.App"
             RequestedThemeVariant="Dark">
	<!-- Dark by default, light selectable (View > Theme): Fluent in its compact density underneath, and the WPF head's own
	     colour tables (Themes/Dark.axaml, Themes/Light.axaml: WaveDudeNext.WPF/Themes/Dark.xaml and Light.xaml converted at
	     build, Build/SharedXaml.targets, 2026-11-10) as the theme dictionaries every style reads through DynamicResource.
	     The strings are the WPF head's tables converted the same way (Strings/); English is merged here, the language
	     switch replaces that dictionary at run time. -->
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceInclude x:Key="Dark" Source="avares://WaveDudeNext.App/Themes/Dark.axaml" />
				<ResourceInclude x:Key="Light" Source="avares://WaveDudeNext.App/Themes/Light.axaml" />
			</ResourceDictionary.ThemeDictionaries>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://WaveDudeNext.App/Strings/Strings.EN.axaml" />
				<!-- every geometry of the application: the WPF head's Themes/Icons.xaml converted at build. Merged here, once,
				     so the theme files, the panes and IconView name a geometry by its key and declare none (2026-11-11);
				     before the dock chrome, whose brushes and templates name three of them -->
				<ResourceInclude Source="avares://WaveDudeNext.App/Themes/Icons.axaml" />
				<!-- the control themes of the dock chrome (DockGroupControl, its tabs, header buttons and splitters) -->
				<ResourceInclude Source="avares://WaveDudeNext.App/Themes/Docking.axaml" />
			</ResourceDictionary.MergedDictionaries>
			<!-- the same in both themes: the overlay handles and the selected item over the pictures, chosen for
			     colour-blind contrast (upstream Controls.xaml:41-42) -->
			<SolidColorBrush x:Key="PictureHandle" Color="#FFC8C8C8" />
			<SolidColorBrush x:Key="PictureSelection" Color="#FFFFE000" />
		</ResourceDictionary>
	</Application.Resources>
	<Application.Styles>
		<FluentTheme DensityStyle="Compact" />
		<!-- upstream's control styles for the whole application, in upstream's order (App.xaml: Controls, Editors, Lists).
		     After the Fluent theme, because Application.Styles are searched last to first and a control resolves its
		     ControlTheme once, when it joins the tree: these control themes must be in place before any window is built.
		     The panes and dialogs also include their own theme files (ProjectTree, Preview, Messages, Dialogs). -->
		<StyleInclude Source="avares://WaveDudeNext.App/Themes/Controls.axaml" />
		<StyleInclude Source="avares://WaveDudeNext.App/Themes/Editors.axaml" />
		<StyleInclude Source="avares://WaveDudeNext.App/Themes/Lists.axaml" />
	</Application.Styles>
</Application>
