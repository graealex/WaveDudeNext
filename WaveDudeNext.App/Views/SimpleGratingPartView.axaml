<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.App.Controls"
             xmlns:converters="using:WaveDudeNext.App.Converters"
             xmlns:meta="using:WaveDudeNext.App.Markup"
             xmlns:panes="using:WaveDudeNext.App.Panes"
             xmlns:views="using:WaveDudeNext.App.Views"
             xmlns:model="using:WaveDudeNext.Model"
             xmlns:rendering="using:WaveDudeNext.Rendering"
             x:Class="WaveDudeNext.App.Views.SimpleGratingPartView"
             x:DataType="model:SimpleGratingPart">
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<!-- the dots' material: mirror or glass, index, absorption; no coating rows, the dots take no band -->
			<views:ShapeMaterialView CoatingShown="False" />
			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionLattice}" />
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:SimpleGratingPart.Columns}" />
				<controls:NumberBox Text="{Binding Columns, UpdateSourceTrigger=LostFocus}" Minimum="1" ToolTip.Tip="{meta:Hint model:SimpleGratingPart.Columns}" AutomationProperties.AutomationId="PartColumns" />
				<TextBlock Classes="FormLabel" Text="{meta:Label model:SimpleGratingPart.Rows}" />
				<controls:NumberBox Text="{Binding Rows, UpdateSourceTrigger=LostFocus}" Minimum="1" ToolTip.Tip="{meta:Hint model:SimpleGratingPart.Rows}" AutomationProperties.AutomationId="PartRows" />
				<TextBlock Classes="FormLabel" Text="{meta:Label model:SimpleGratingPart.ColumnSpacing}" />
				<controls:NumberBox Text="{Binding ColumnSpacing, UpdateSourceTrigger=LostFocus}" Minimum="2" ToolTip.Tip="{meta:Hint model:SimpleGratingPart.ColumnSpacing}" AutomationProperties.AutomationId="PartColumnSpacing" />
				<TextBlock Classes="FormLabel" Text="{meta:Label model:SimpleGratingPart.RowSpacing}" />
				<controls:NumberBox Text="{Binding RowSpacing, UpdateSourceTrigger=LostFocus}" Minimum="2" ToolTip.Tip="{meta:Hint model:SimpleGratingPart.RowSpacing}" AutomationProperties.AutomationId="PartRowSpacing" />
				<!-- at most half the smaller spacing: the box's top follows the spacings -->
				<TextBlock Classes="FormLabel" Text="{meta:Label model:SimpleGratingPart.Diameter}" />
				<controls:NumberBox Text="{Binding Diameter, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="{Binding MaxDiameter}" ToolTip.Tip="{meta:Hint model:SimpleGratingPart.Diameter}" AutomationProperties.AutomationId="PartDiameter" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
