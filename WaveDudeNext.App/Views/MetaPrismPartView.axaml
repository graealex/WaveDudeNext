<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.App.Controls"
             xmlns:converters="using:WaveDudeNext.App.Converters"
             xmlns:meta="using:WaveDudeNext.App.Markup"
             xmlns:panes="using:WaveDudeNext.App.Panes"
             xmlns:views="using:WaveDudeNext.App.Views"
             xmlns:model="using:WaveDudeNext.Model"
             xmlns:rendering="using:WaveDudeNext.Rendering"
             x:Class="WaveDudeNext.App.Views.MetaPrismPartView"
             x:DataType="model:MetaPrismPart">
	<UserControl.Resources>
		<converters:PixelsConverter x:Key="Pixels" />
	</UserControl.Resources>
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<!-- the plate's material; the band on the pattern's tops (front) and the plate's back, no sides -->
			<views:ShapeMaterialView SidesHidden="True" />
			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:MetaSurfacePart.Length}" />
				<controls:NumberBox Text="{Binding Length, UpdateSourceTrigger=LostFocus}" Minimum="1" Increment="10" ToolTip.Tip="{meta:Hint model:MetaSurfacePart.Length}" AutomationProperties.AutomationId="PartLength" />
				<TextBlock Classes="FormLabel" Text="{meta:Label model:MetaSurfacePart.Width}" />
				<controls:NumberBox Text="{Binding Width, UpdateSourceTrigger=LostFocus}" Minimum="2" Increment="10" ToolTip.Tip="{meta:Hint model:MetaSurfacePart.Width}" AutomationProperties.AutomationId="PartWidth" />
			</controls:FormPanel>
			<!-- the prism: the wavelength it is cut for and the angle it turns the wave by -->
			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionPrism}" />
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:MetaSurfacePart.DesignFrequency}" />
				<controls:NumberBox Text="{Binding DesignFrequency, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="255" DragStep="0.1" Decimals="2" ToolTip.Tip="{meta:Hint model:MetaSurfacePart.DesignFrequency}" AutomationProperties.AutomationId="PartDesignFrequency" />
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelWavelength}" />
				<TextBlock Classes="FormReadout" Text="{Binding Wavelength, Converter={StaticResource Pixels}}" ToolTip.Tip="{DynamicResource TipGateWavelength}" AutomationProperties.AutomationId="PartWavelength" />
				<TextBlock Classes="FormLabel" Text="{meta:Label model:MetaPrismPart.Deflection}" />
				<controls:NumberBox Text="{Binding Deflection, UpdateSourceTrigger=LostFocus}" Minimum="-89" Maximum="89" DragStep="0.5" Decimals="2" ToolTip.Tip="{meta:Hint model:MetaPrismPart.Deflection}" AutomationProperties.AutomationId="PartDeflection" />
				<!-- read-only: a zone's width, a full turn of phase, and how many fit across the face -->
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelZoneWidth}" />
				<TextBlock Classes="FormReadout" Text="{Binding ZoneWidth, Converter={StaticResource Pixels}}" ToolTip.Tip="{DynamicResource TipZoneWidth}" AutomationProperties.AutomationId="PartZoneWidth" />
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelMetaZones}" />
				<TextBlock Classes="FormReadout" Text="{Binding ZoneCount}" ToolTip.Tip="{DynamicResource TipMetaZones}" AutomationProperties.AutomationId="PartZoneCount" />
			</controls:FormPanel>
			<!-- the pattern: the ridges' index, cell and height, and the height a full turn needs -->
			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionPattern}" />
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{meta:Label model:MetaSurfacePart.PatternIndex}" />
				<controls:NumberBox Text="{Binding PatternIndex, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip.Tip="{meta:Hint model:MetaSurfacePart.PatternIndex}" AutomationProperties.AutomationId="PartPatternIndex" />
				<TextBlock Classes="FormLabel" Text="{meta:Label model:MetaSurfacePart.Pitch}" />
				<controls:NumberBox Text="{Binding Pitch, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="10000" DragStep="0.1" Decimals="2" ToolTip.Tip="{meta:Hint model:MetaSurfacePart.Pitch}" AutomationProperties.AutomationId="PartPitch" />
				<TextBlock Classes="FormLabel" Text="{meta:Label model:MetaSurfacePart.Height}" />
				<controls:NumberBox Text="{Binding Height, UpdateSourceTrigger=LostFocus}" Minimum="1" Maximum="10000" DragStep="0.1" Decimals="2" ToolTip.Tip="{meta:Hint model:MetaSurfacePart.Height}" AutomationProperties.AutomationId="PartHeight" />
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelFullTurnHeight}" />
				<TextBlock Classes="FormReadout" Text="{Binding FullTurnHeight, Converter={StaticResource Pixels}}" ToolTip.Tip="{DynamicResource TipFullTurnHeight}" AutomationProperties.AutomationId="PartFullTurnHeight" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
