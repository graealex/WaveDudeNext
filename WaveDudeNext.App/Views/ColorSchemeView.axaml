<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.App.Controls"
             xmlns:converters="using:WaveDudeNext.App.Converters"
             xmlns:meta="using:WaveDudeNext.App.Markup"
             xmlns:panes="using:WaveDudeNext.App.Panes"
             xmlns:views="using:WaveDudeNext.App.Views"
             xmlns:model="using:WaveDudeNext.Model"
             xmlns:rendering="using:WaveDudeNext.Rendering"
             x:Class="WaveDudeNext.App.Views.ColorSchemeView"
             x:DataType="rendering:ColorScheme">
	<UserControl.Resources>
		<converters:ColorSchemeBrushConverter x:Key="ColorSchemeBrush" />
		<converters:RgbTextConverter x:Key="RgbText" />
		<converters:IntGreaterThanConverter x:Key="GreaterThan" />
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionGeneral}" />
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{meta:Label rendering:ColorScheme.Name}" />
				<TextBox Text="{Binding Name}" ToolTip.Tip="{meta:Hint rendering:ColorScheme.Name}" AutomationProperties.AutomationId="SchemeName" />

				<TextBlock Classes="FormLabel" Text="{meta:Label rendering:ColorScheme.Kind}" />
				<ComboBox Theme="{DynamicResource EnumComboBox}" ItemsSource="{meta:EnumValues rendering:ColorSchemeKind}"
				          SelectedItem="{Binding Kind}" ToolTip.Tip="{meta:Hint rendering:ColorScheme.Kind}" AutomationProperties.AutomationId="SchemeKind" />

				<TextBlock Classes="FormLabel" Text="{meta:Label rendering:ColorScheme.Description}" />
				<TextBox Text="{Binding Description}" TextWrapping="Wrap" AcceptsReturn="False"
				         ToolTip.Tip="{meta:Hint rendering:ColorScheme.Description}" AutomationProperties.AutomationId="SchemeDescription" />
			</controls:FormPanel>

			<Label Theme="{DynamicResource FormSection}" Content="{DynamicResource SectionStops}" />
			<!-- start from any existing scheme: picking one copies its stops, kind and description into this one -->
			<controls:FormPanel>
				<TextBlock Classes="FormLabel" Text="{DynamicResource LabelBasedOn}" />
				<ComboBox x:Name="basedOn" ToolTip.Tip="{DynamicResource TipBasedOn}" SelectionChanged="OnBasedOnChanged" AutomationProperties.AutomationId="SchemeBasedOn">
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="rendering:ColorScheme">
							<DockPanel>
								<Rectangle DockPanel.Dock="Left" Width="56" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" StrokeThickness="0.5"
								           Stroke="{DynamicResource TextBoxBorder}" Fill="{Binding Stops, Converter={StaticResource ColorSchemeBrush}}" />
								<TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
							</DockPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</controls:FormPanel>
			<!-- the whole gradient with a marker under each stop: a marker dragged moves its stop, a click on the gradient adds one
			     (2026-11-11). The bar is wider than the form by its inset at either end, the room of the half marker under a stop
			     at 0 or 1, so the gradient itself keeps the width of the fields. -->
			<controls:GradientBar Margin="-8,0,-8,4" Scheme="{Binding}" RemoveCommand="{Binding $parent[panes:PropertiesPane].Commands.RemoveStop}"
			                      OutlineBrush="{DynamicResource TextBoxBorder}" MarkerBrush="{DynamicResource WindowForeground}"
			                      AccentBrush="{DynamicResource Accent}" ToolTip.Tip="{DynamicResource TipSchemeGradient}"
			                      AutomationProperties.AutomationId="SchemeGradient" />

			<!-- one row per stop, along the gradient: position (0..1), swatch (the picker), colour as #RRGGBB, remove (while more than one stop remains) -->
			<ItemsControl x:Name="stops" ItemsSource="{Binding Stops}" Focusable="False">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="rendering:ColorStop">
						<DockPanel Margin="0,0,0,4">
							<Button DockPanel.Dock="Right" Theme="{DynamicResource RemovePointButton}" Focusable="False" ToolTip.Tip="{DynamicResource TipRemoveStop}"
							        IsEnabled="{Binding $parent[ItemsControl].ItemCount, Converter={StaticResource GreaterThan}, ConverterParameter=1}" Click="OnRemoveStop" />
							<controls:NumberBox DockPanel.Dock="Left" Width="64" Minimum="0" Maximum="1" Increment="0.01" Text="{Binding Position, UpdateSourceTrigger=LostFocus}"
							                    ToolTip.Tip="{DynamicResource TipStopPosition}" />
							<!-- the swatch opens the colour picker (Space, Enter, Down); ids carry the stop's position -->
							<controls:ColorPickerButton DockPanel.Dock="Left" Margin="4,0" Color="{Binding Color}" ToolTip.Tip="{DynamicResource TipStopSwatch}"
							                            AutomationProperties.AutomationId="{Binding Position, StringFormat='StopSwatch:{0}'}" />
							<TextBox Text="{Binding Color, Converter={StaticResource RgbText}, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="{DynamicResource TipStopColor}"
							         AutomationProperties.AutomationId="{Binding Position, StringFormat='StopColor:{0}'}" />
						</DockPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<StackPanel Orientation="Horizontal">
				<Button Padding="8,2" Margin="0,2,6,0" Content="{DynamicResource ButtonAddStop}" ToolTip.Tip="{DynamicResource TipAddStop}"
				        Click="OnAddStop" AutomationProperties.AutomationId="SchemeAddStop" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
