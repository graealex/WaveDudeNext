<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WaveDudeNext.Desktop</AssemblyName>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WaveDudeNext/WaveDudeNext.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <EmbeddedResource Include="../Examples/*.wdproj" LogicalName="Examples/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
