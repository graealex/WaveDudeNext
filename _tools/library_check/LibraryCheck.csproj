<Project Sdk="Microsoft.NET.Sdk">

  <!-- Verification harness for the WaveDudeNext library (engines, probes, rendering, frame store, run driver).
       Not part of the solution; run with "dotnet run" on this project (Release) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The harness targets the library's cross-platform framework; Windows-only WIC and Media Foundation checks are conditional. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LibraryCheck</RootNamespace>
    <!-- the .editorconfig code-style rules are build warnings too: a file without the license header (IDE0073) -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WaveDudeNext\WaveDudeNext.csproj" />
  </ItemGroup>

</Project>
