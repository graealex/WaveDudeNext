	<x:String x:Key="Label.DisplayLayer.Brightness">Helderheid</x:String>
	<x:String x:Key="Hint.DisplayLayer.Brightness">Versterking van de waarden vóór de kleurtoewijzing.</x:String>
	<x:String x:Key="Label.DisplayLayer.BlackLevel">Zwartniveau</x:String>
	<x:String x:Key="Hint.DisplayLayer.BlackLevel">Verschuiving vóór de kleurtoewijzing; waarden op of onder dit niveau krijgen de eerste kleur.</x:String>
	<x:String x:Key="Label.DisplayLayer.Preview">Voorbeeld</x:String>
	<x:String x:Key="Hint.DisplayLayer.Preview">Deze uitvoer in het live-voorbeeld tonen.</x:String>
	<x:String x:Key="Label.DisplayLayer.Overlay">Omtrek in het voorbeeld</x:String>
	<x:String x:Key="Hint.DisplayLayer.Overlay">De gloeiende-randen-omtrek van de scèneafbeelding in het voorbeeld over deze uitvoer leggen.</x:String>
	<x:String x:Key="Label.DisplayLayer.OverlayGain">Omtrekhelderheid</x:String>
	<x:String x:Key="Hint.DisplayLayer.OverlayGain">Factor van de omtrek: 1 zoals berekend, hoger versterkt zwakke randen, 0 verbergt hem.</x:String>
	<x:String x:Key="Label.DisplayLayer.OverlayInExport">Omtrek in de export</x:String>
