    <x:String x:Key="LabelGateLength">Total length</x:String>
    <x:String x:Key="TipGateLayout">Computed from the design wavelength and the indices with the simulator's own wave equation (the 4th-order Laplacian)</x:String>
    <x:String x:Key="LabelInputA">Input A</x:String>
    <x:String x:Key="LabelInputB">Input B</x:String>
    <x:String x:Key="TipGatePorts">Canvas pixels. Feed the inputs with equal waves (the same frequency, amplitude and phase); a missing wave is a logical 0. The outputs line up with the inputs of gates set a port spacing above and below, one length on</x:String>
    <x:String x:Key="SectionZones">Zones</x:String>
    <x:String x:Key="LabelZoneCount">Number of zones</x:String>
    <x:String x:Key="LabelOuterZone">Outermost zone</x:String>
    <x:String x:Key="TipZones">The zones the plate gets within its diameter, and the width of the outermost whole one, which the grid must resolve (a few pixels at least)</x:String>
    <x:String x:Key="SectionPoints">Points</x:String>
    <x:String x:Key="SectionNodes">Nodes</x:String>
    <x:String x:Key="HintPolygonPoints">Vertices of the outline relative to the centre, before rotation. Empty: the regular polygon above is used.</x:String>
    <x:String x:Key="HintFiberNodes">Nodes of the path relative to the centre, before rotation, each with the in- and out-handle of the segments meeting there, as offsets from the node. Fewer than two nodes paint nothing.</x:String>
    <x:String x:Key="ButtonAddPoint">Add point</x:String>
    <x:String x:Key="TipAddPoint">Append a point after the last one</x:String>
    <x:String x:Key="TipRemovePoint">Remove this point</x:String>
    <x:String x:Key="ButtonAddNode">Add node</x:String>
    <x:String x:Key="TipAddNode">Append a node beyond the last one, continuing the path</x:String>
    <x:String x:Key="TipRemoveNode">Remove this node</x:String>
    <x:String x:Key="LabelNodePoint">Node</x:String>
    <x:String x:Key="LabelNodeIn">In</x:String>
    <x:String x:Key="LabelNodeOut">Out</x:String>
    <x:String x:Key="LabelApexAngle">Apex angle</x:String>
    <x:String x:Key="TipApexAngle">The angle at the apex: 180° minus the two base angles</x:String>
    <x:String x:Key="LabelEdgeThickness">Edge thickness</x:String>
    <x:String x:Key="TipEdgeThickness">Thickness at the rim: the centre thickness less what the convex surfaces take, plus what the concave ones add; 0 when the surfaces meet at the rim</x:String>
    <x:String x:Key="SectionGraph">Graph</x:String>
    <x:String x:Key="SectionAxes">Axes</x:String>
    <x:String x:Key="ButtonNewSeed">_New seed</x:String>
    <x:String x:Key="ItemCountZero">No entries</x:String>
    <x:String x:Key="ItemCountOne">1 entry</x:String>
    <x:String x:Key="ItemCountMany">{0} entries</x:String>
    <x:String x:Key="TipSaveSceneImage">Save the embedded image to a file</x:String>
    <x:String x:Key="SceneImageSaveFilterFormat">Image file (*{0})|*{0}|All files (*.*)|*.*</x:String>
    <x:String x:Key="SceneImageSaveError">The image could not be saved to '{0}'</x:String>
    <x:String x:Key="TipBrowseSceneImage">Pick an image file; it is embedded in the project</x:String>
    <x:String x:Key="TipRemoveSceneImage">Drop the embedded image and its file path; the canvas keeps the image's size</x:String>
    <x:String x:Key="SceneImageNotFound">(not found)</x:String>
    <x:String x:Key="LabelEmbeddedImage">Embedded image</x:String>
    <x:String x:Key="TipEmbeddedImage">Size of the embedded scene image; the canvas takes this size</x:String>
    <x:String x:Key="SceneImageFilter">Images (*.png;*.bmp;*.jpg;*.jpeg;*.tif;*.tiff;*.gif)|*.png;*.bmp;*.jpg;*.jpeg;*.tif;*.tiff;*.gif|All files (*.*)|*.*</x:String>
    <x:String x:Key="ColorSchemeFilter">Colour schemes (*.wdscheme;*.json)|*.wdscheme;*.json|All files (*.*)|*.*</x:String>
    <x:String x:Key="PickerBrowse">Load from file…</x:String>
    <x:String x:Key="PickerEditCopy">Edit a copy in the project…</x:String>
    <x:String x:Key="PickerProjectTag">project</x:String>
    <x:String x:Key="PickerMissingFormat">{0} (not found)</x:String>
    <x:String x:Key="LabelBasedOn">Based on</x:String>
    <x:String x:Key="TipBasedOn">Copy the stops of an existing scheme into this one, then change them</x:String>
    <x:String x:Key="ButtonAddStop">Add stop</x:String>
    <x:String x:Key="TipAddStop">Insert a stop in the widest gap, with the gradient's colour there</x:String>
    <x:String x:Key="TipRemoveStop">Remove this stop</x:String>
    <x:String x:Key="TipStopPosition">Position along the gradient: 0 at the lowest value, 1 at the highest</x:String>
    <x:String x:Key="TipStopColor">Colour as #RRGGBB; Enter applies it</x:String>
    <x:String x:Key="TipStopSwatch">Pick the colour: Space opens the picker, Enter keeps it, Escape puts the old colour back</x:String>
    <x:String x:Key="TipColorSquare">Saturation (Left, Right) and brightness (Up, Down); Shift moves by ten steps</x:String>
    <x:String x:Key="TipColorHue">Hue: Up and Down move by a degree, ten with Shift</x:String>
    <x:String x:Key="TipColorChannel">Channel 0 to 255; Up and Down step it</x:String>
    <x:String x:Key="OpenFileDialogFilter">WaveDude Next projects (*.wdproj)|*.wdproj|Wave Dude 2D projects (configuration.json)|configuration.json;*.json|XML files (*.xml)|*.xml|All files (*.*)|*.*</x:String>
