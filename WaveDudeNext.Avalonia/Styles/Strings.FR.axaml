	<x:String x:Key="ButtonAddStop">Ajouter un point</x:String>
	<x:String x:Key="TipAddStop">Insérer un point dans le plus grand intervalle, avec la couleur du dégradé à cet endroit</x:String>
	<x:String x:Key="TipRemoveStop">Supprimer ce point</x:String>
