<UserControl x:Class="WaveDudeNext.Avalonia.Views.TrianglePartView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:converters="using:WaveDudeNext.Avalonia.Converters"
             xmlns:meta="using:WaveDudeNext.Avalonia.Markup"
             xmlns:views="using:WaveDudeNext.Avalonia.Views"
             xmlns:model="using:WaveDudeNext.Model"
             Classes="wpfEditor" x:CompileBindings="False">

	<UserControl.Resources>
        <converters:ConditionConverter x:Key="Condition"/>
		<converters:TriangleApexConverter x:Key="ApexAngle" />
		<!-- the presets fix the angles: A is typed for the isosceles and custom types, B for custom only -->


	</UserControl.Resources>
		<StackPanel Margin="8">
			<views:PartCommonView />
			<views:ShapeMaterialView />

			<Label Classes="formSection" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.TrianglePart.Type}" />
				<ComboBox Classes="enumComboBox" ItemsSource="{x:Static controls:EnumItems.TriangleType}"
				          SelectedItem="{Binding Type, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.TrianglePart.Type}" AutomationProperties.AutomationId="PartTriangleType" />

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.TrianglePart.Base}" />
				<NumericUpDown Value="{Binding Base, Mode=TwoWay}" Minimum="2" Increment="10" ToolTip.Tip="{DynamicResource Hint.TrianglePart.Base}" AutomationProperties.AutomationId="PartBase"  Maximum="2147483647"/>

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.TrianglePart.AngleA}" />
				<NumericUpDown IsEnabled="{Binding Type, Converter={StaticResource Condition}, ConverterParameter='False;Isosceles=True;Custom=True'}" Value="{Binding AngleA, Mode=TwoWay}" Minimum="1" Maximum="178" ToolTip.Tip="{DynamicResource Hint.TrianglePart.AngleA}" AutomationProperties.AutomationId="PartAngleA" />

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.TrianglePart.AngleB}" />
				<NumericUpDown IsEnabled="{Binding Type, Converter={StaticResource Condition}, ConverterParameter='False;Custom=True'}" Value="{Binding AngleB, Mode=TwoWay}" Minimum="1" Maximum="178" ToolTip.Tip="{DynamicResource Hint.TrianglePart.AngleB}" AutomationProperties.AutomationId="PartAngleB" />

				<!-- read-only: what the two base angles leave for the apex -->
				<TextBlock Classes="formLabel" Text="{DynamicResource LabelApexAngle}" />
				<TextBlock Classes="formReadout" ToolTip.Tip="{DynamicResource TipApexAngle}" AutomationProperties.AutomationId="PartApexAngle">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource ApexAngle}">
							<Binding Path="Type" />
							<Binding Path="AngleA" />
							<Binding Path="AngleB" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</controls:FormPanel>
		</StackPanel>

</UserControl>
