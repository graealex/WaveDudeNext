<UserControl x:Class="WaveDudeNext.Avalonia.Views.BraggReflectorPartView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:WaveDudeNext.Avalonia.Converters"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:meta="using:WaveDudeNext.Avalonia.Markup"
             xmlns:views="using:WaveDudeNext.Avalonia.Views"
             xmlns:model="using:WaveDudeNext.Model"
             Classes="wpfEditor" x:CompileBindings="False">
    <UserControl.Resources><converters:ConditionConverter x:Key="Condition"/></UserControl.Resources>
		<StackPanel Margin="8">
			<views:PartCommonView />

			<Label Classes="formSection" Content="{DynamicResource SectionLayers}" />
			<controls:FormPanel>
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.BraggReflectorPart.Pairs}" />
				<NumericUpDown Value="{Binding Pairs, Mode=TwoWay}" Minimum="1" Maximum="200" ToolTip.Tip="{DynamicResource Hint.BraggReflectorPart.Pairs}" AutomationProperties.AutomationId="PartPairs" />

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.BraggReflectorPart.Thickness1}" />
				<NumericUpDown Value="{Binding Thickness1, Mode=TwoWay}" Minimum="1" ToolTip.Tip="{DynamicResource Hint.BraggReflectorPart.Thickness1}" AutomationProperties.AutomationId="PartThickness1"  Maximum="2147483647"/>

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.BraggReflectorPart.Index1}" />
				<NumericUpDown Value="{Binding Index1, Mode=TwoWay}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip.Tip="{DynamicResource Hint.BraggReflectorPart.Index1}" AutomationProperties.AutomationId="PartIndex1" />

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.BraggReflectorPart.Thickness2}" />
				<NumericUpDown Value="{Binding Thickness2, Mode=TwoWay}" Minimum="1" ToolTip.Tip="{DynamicResource Hint.BraggReflectorPart.Thickness2}" AutomationProperties.AutomationId="PartThickness2"  Maximum="2147483647"/>

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.BraggReflectorPart.Index2}" />
				<NumericUpDown Value="{Binding Index2, Mode=TwoWay}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip.Tip="{DynamicResource Hint.BraggReflectorPart.Index2}" AutomationProperties.AutomationId="PartIndex2" />
			</controls:FormPanel>

			<Label Classes="formSection" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.BraggReflectorPart.Width}" />
				<NumericUpDown Value="{Binding Width, Mode=TwoWay}" Minimum="2" Increment="10" ToolTip.Tip="{DynamicResource Hint.BraggReflectorPart.Width}" AutomationProperties.AutomationId="PartWidth"  Maximum="2147483647"/>
			</controls:FormPanel>
		</StackPanel>

</UserControl>
