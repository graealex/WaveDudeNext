<UserControl x:Class="WaveDudeNext.Avalonia.Views.PartCommonView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:meta="using:WaveDudeNext.Avalonia.Markup"
             xmlns:model="using:WaveDudeNext.Model"
             Classes="wpfEditor" x:CompileBindings="False"
             xmlns:converters="using:WaveDudeNext.Avalonia.Converters"
             xmlns:localization="using:WaveDudeNext.Avalonia.Localization"
             xmlns:p="using:WaveDudeNext.Avalonia">

	<UserControl.Resources>
        <converters:ConditionConverter x:Key="Condition"/>
		<converters:KindDescriptionConverter x:Key="KindDescription" />

	</UserControl.Resources>

	<!-- the members every part has: name, enabled, centre and angle; placed first in each kind's form -->
	<StackPanel>
		<!-- what this kind is (2026-10-29, the user's choice, beside the Add part menu's tooltips): the Kind.<Type> string under a
		     header whose chevron turns while it is open; open or closed is one user setting for every kind -->
        <Expander Header="{DynamicResource SectionDescription}" IsExpanded="False" Margin="0,0,0,6">
            <TextBlock TextWrapping="Wrap" Text="{Binding Converter={StaticResource KindDescription}}"/>
        </Expander>

		<Label Classes="formSection" Content="{DynamicResource SectionGeneral}" />
		<controls:FormPanel>
			<TextBlock Classes="formLabel" Text="{DynamicResource Label.OpticalPart.Name}" />
			<TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip.Tip="{DynamicResource Hint.OpticalPart.Name}" AutomationProperties.AutomationId="PartName" />

			<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.OpticalPart.Enabled}"
			          IsChecked="{Binding Enabled, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.OpticalPart.Enabled}" AutomationProperties.AutomationId="PartEnabled" />
		</controls:FormPanel>

		<Label Classes="formSection" Content="{DynamicResource SectionPosition}" />
		<controls:FormPanel>
			<TextBlock Classes="formLabel" Text="{DynamicResource Label.OpticalPart.X}" />
			<NumericUpDown Value="{Binding X, Mode=TwoWay}" Minimum="0" ToolTip.Tip="{DynamicResource Hint.OpticalPart.X}" AutomationProperties.AutomationId="PartX"  Maximum="2147483647"/>

			<TextBlock Classes="formLabel" Text="{DynamicResource Label.OpticalPart.Y}" />
			<NumericUpDown Value="{Binding Y, Mode=TwoWay}" Minimum="0" ToolTip.Tip="{DynamicResource Hint.OpticalPart.Y}" AutomationProperties.AutomationId="PartY"  Maximum="2147483647"/>

			<TextBlock Classes="formLabel" Text="{DynamicResource Label.OpticalPart.Angle}" />
			<NumericUpDown Value="{Binding Angle, Mode=TwoWay}" Minimum="-180" Maximum="180" Increment="5" ToolTip.Tip="{DynamicResource Hint.OpticalPart.Angle}" AutomationProperties.AutomationId="PartAngleBox" />
		</controls:FormPanel>
	</StackPanel>
</UserControl>
