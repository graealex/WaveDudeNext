<UserControl x:Class="WaveDudeNext.Avalonia.Views.ZonePlatePartView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:converters="using:WaveDudeNext.Avalonia.Converters"
             xmlns:meta="using:WaveDudeNext.Avalonia.Markup"
             xmlns:views="using:WaveDudeNext.Avalonia.Views"
             xmlns:model="using:WaveDudeNext.Model"
             Classes="wpfEditor" x:CompileBindings="False">

	<UserControl.Resources>
        <converters:ConditionConverter x:Key="Condition"/>
		<converters:ZonePlateConverter x:Key="Plate" />
	</UserControl.Resources>
		<StackPanel Margin="8">
			<views:PartCommonView />

			<Label Classes="formSection" Content="{DynamicResource SectionDesign}" />
			<controls:FormPanel>
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.ZonePlatePart.DesignFrequency}" />
				<NumericUpDown Value="{Binding DesignFrequency, Mode=TwoWay}" Minimum="1" Maximum="255" ToolTip.Tip="{DynamicResource Hint.ZonePlatePart.DesignFrequency}" AutomationProperties.AutomationId="PartDesignFrequency" />

				<!-- read-only: the wavelength the frequency gives with the project's frequency scale -->
				<TextBlock Classes="formLabel" Text="{DynamicResource LabelWavelength}" />
				<TextBlock Classes="formReadout" ToolTip.Tip="{DynamicResource TipGateWavelength}" AutomationProperties.AutomationId="PartWavelength">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Plate}" ConverterParameter="Wavelength">
							<Binding /><Binding Path="Wavelength" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.ZonePlatePart.FocalLength}" />
				<NumericUpDown Value="{Binding FocalLength, Mode=TwoWay}" Minimum="1" Increment="10" ToolTip.Tip="{DynamicResource Hint.ZonePlatePart.FocalLength}" AutomationProperties.AutomationId="PartFocalLength"  Maximum="2147483647"/>

				<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.ZonePlatePart.Inverse}"
				          IsChecked="{Binding Inverse, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.ZonePlatePart.Inverse}" AutomationProperties.AutomationId="PartInverse" />
			</controls:FormPanel>

			<Label Classes="formSection" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.ZonePlatePart.Diameter}" />
				<NumericUpDown Value="{Binding Diameter, Mode=TwoWay}" Minimum="2" Increment="10" ToolTip.Tip="{DynamicResource Hint.ZonePlatePart.Diameter}" AutomationProperties.AutomationId="PartDiameter"  Maximum="2147483647"/>

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.ZonePlatePart.Thickness}" />
				<NumericUpDown Value="{Binding Thickness, Mode=TwoWay}" Minimum="1" ToolTip.Tip="{DynamicResource Hint.ZonePlatePart.Thickness}" AutomationProperties.AutomationId="PartThickness"  Maximum="2147483647"/>

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.ZonePlatePart.Coating}" />
				<NumericUpDown Value="{Binding Coating, Mode=TwoWay}" Minimum="0" Maximum="400" ToolTip.Tip="{DynamicResource Hint.ZonePlatePart.Coating}" AutomationProperties.AutomationId="PartCoating" />

				<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.ZonePlatePart.Mount}"
				          IsChecked="{Binding Mount, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.ZonePlatePart.Mount}" AutomationProperties.AutomationId="PartMount" />

				<!-- the mount's width, only while there is a mount -->
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.ZonePlatePart.MountWidth}" />
				<NumericUpDown Value="{Binding MountWidth, Mode=TwoWay}" Minimum="1" Increment="10" IsEnabled="{Binding Mount}" ToolTip.Tip="{DynamicResource Hint.ZonePlatePart.MountWidth}" AutomationProperties.AutomationId="PartMountWidth"  Maximum="2147483647"/>
			</controls:FormPanel>

			<Label Classes="formSection" Content="{DynamicResource SectionZones}" />
			<controls:FormPanel ToolTip.Tip="{DynamicResource TipZones}">
				<TextBlock Classes="formLabel" Text="{DynamicResource LabelZoneCount}" />
				<TextBlock Classes="formReadout" AutomationProperties.AutomationId="PartZoneCount">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Plate}" ConverterParameter="Zones">
							<Binding /><Binding Path="ZoneCount" /><Binding Path="Diameter" /><Binding Path="FocalLength" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>

				<TextBlock Classes="formLabel" Text="{DynamicResource LabelOuterZone}" />
				<TextBlock Classes="formReadout" AutomationProperties.AutomationId="PartOuterZone">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Plate}" ConverterParameter="OuterZone">
							<Binding /><Binding Path="ZoneCount" /><Binding Path="Diameter" /><Binding Path="FocalLength" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</controls:FormPanel>
		</StackPanel>

</UserControl>
