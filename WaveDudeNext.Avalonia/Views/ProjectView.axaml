<UserControl x:Class="WaveDudeNext.Avalonia.Views.ProjectView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:views="using:WaveDudeNext.Avalonia.Views"
             Classes="wpfEditor" x:CompileBindings="False">
	<StackPanel Margin="8">
		<Label Classes="formSection" Content="{DynamicResource SectionGeneral}" />
		<controls:FormPanel>
			<TextBlock Classes="formLabel" Text="{DynamicResource Label.Project.Version}" />
			<TextBlock Classes="formValue" Text="{Binding Version}" ToolTip.Tip="{DynamicResource Hint.Project.Version}" />

			<TextBlock Classes="formLabel" Text="{DynamicResource Label.Project.Seed}" />
			<DockPanel>
				<Button DockPanel.Dock="Right" Margin="6,0,0,0"
				        Click="OnReseed" AutomationProperties.AutomationId="ProjectNewSeed" ><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Reset"/><TextBlock Text="{DynamicResource ButtonNewSeed}"/></StackPanel></Button>
				<NumericUpDown Value="{Binding Seed, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.Project.Seed}" FormatString="0" ParsingNumberStyle="Integer" Minimum="-2147483648" Maximum="2147483647"/>
			</DockPanel>

			<TextBlock Classes="formLabel" Text="{DynamicResource Label.Project.Description}" VerticalAlignment="Top" Margin="0,4,0,0" />
			<TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip.Tip="{DynamicResource Hint.Project.Description}"
			         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top"
			         ScrollViewer.VerticalScrollBarVisibility="Auto" />
		</controls:FormPanel>
	</StackPanel>
</UserControl>
