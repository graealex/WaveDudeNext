<UserControl x:Class="WaveDudeNext.Avalonia.Views.FiberPathView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:WaveDudeNext.Avalonia.Converters"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:commands="using:WaveDudeNext.Avalonia.Commands"
             xmlns:meta="using:WaveDudeNext.Avalonia.Markup"
             xmlns:model="using:WaveDudeNext.Model"
             Classes="wpfEditor" x:CompileBindings="False">
    <UserControl.Resources><converters:ConditionConverter x:Key="Condition"/></UserControl.Resources>



	<!-- the node list of a fibre's path (the data context is the part): one block per node with the node's X and Y, the
	     Smooth flag and a remove button on the first row, the in- and out-handle offsets on the rows below (relative to
	     the node, before rotation), and an add button under the list. Inside the template the string keys are referenced
	     directly: a template rejects the resource reference the meta extensions wrap (2026-10-22) -->
	<StackPanel>
		<Label Classes="formSection" Content="{DynamicResource SectionNodes}" />
		<TextBlock Margin="0,0,0,4" Foreground="{DynamicResource GrayText}" TextWrapping="Wrap" Text="{DynamicResource HintFiberNodes}" />
		<Grid Margin="0,0,0,2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="36" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="1" Classes="formLabel" Text="{DynamicResource Label.FiberNode.X}" Margin="2,0" />
			<TextBlock Grid.Column="2" Classes="formLabel" Text="{DynamicResource Label.FiberNode.Y}" Margin="2,0" />
		</Grid>
		<ItemsControl ItemsSource="{Binding Nodes}" Focusable="False">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Grid Margin="0,0,0,6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="36" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="{DynamicResource LabelNodePoint}" />
						<NumericUpDown Grid.Row="0" Grid.Column="1" Margin="0,0,2,2" Value="{Binding X, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.FiberNode.X}"  Minimum="-2147483648" Maximum="2147483647"/>
						<NumericUpDown Grid.Row="0" Grid.Column="2" Margin="2,0,0,2" Value="{Binding Y, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.FiberNode.Y}"  Minimum="-2147483648" Maximum="2147483647"/>
						<StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
							<!-- the label as a TextBlock child, which also names the box for automation (Content would show the reference, not the text) -->
							<CheckBox Margin="6,0,0,2" VerticalAlignment="Center" IsChecked="{Binding Smooth, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.FiberNode.Smooth}">
								<TextBlock Text="{DynamicResource Label.FiberNode.Smooth}" />
							</CheckBox>
							<Button Padding="5,0" ToolTip.Tip="{DynamicResource TipRemoveNode}" AutomationProperties.Name="{DynamicResource TipRemoveNode}"
							        Click="OnRemoveNode" ><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Delete"/></StackPanel></Button>
						</StackPanel>
						<TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="{DynamicResource LabelNodeIn}" />
						<NumericUpDown Grid.Row="1" Grid.Column="1" Margin="0,0,2,2" Value="{Binding InX, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.FiberNode.InX}"  Minimum="-2147483648" Maximum="2147483647"/>
						<NumericUpDown Grid.Row="1" Grid.Column="2" Margin="2,0,0,2" Value="{Binding InY, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.FiberNode.InY}"  Minimum="-2147483648" Maximum="2147483647"/>
						<TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="{DynamicResource LabelNodeOut}" />
						<NumericUpDown Grid.Row="2" Grid.Column="1" Margin="0,0,2,0" Value="{Binding OutX, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.FiberNode.OutX}"  Minimum="-2147483648" Maximum="2147483647"/>
						<NumericUpDown Grid.Row="2" Grid.Column="2" Margin="2,0,0,0" Value="{Binding OutY, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.FiberNode.OutY}"  Minimum="-2147483648" Maximum="2147483647"/>
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
			<Button Padding="8,2" Margin="0,2,6,0" ToolTip.Tip="{DynamicResource TipAddNode}"
			        Click="OnAddNode" AutomationProperties.AutomationId="PartAddNode" ><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="PlusBadge"/><TextBlock Text="{DynamicResource ButtonAddNode}"/></StackPanel></Button>
		</StackPanel>
	</StackPanel>
</UserControl>
