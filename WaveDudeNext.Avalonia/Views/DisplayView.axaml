<UserControl x:Class="WaveDudeNext.Avalonia.Views.DisplayView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:WaveDudeNext.Avalonia.Views"
             xmlns:converters="using:WaveDudeNext.Avalonia.Converters"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:meta="using:WaveDudeNext.Avalonia.Markup"
             xmlns:model="using:WaveDudeNext.Model"
             Classes="wpfEditor" x:CompileBindings="False">
    <UserControl.Resources><converters:ConditionConverter x:Key="Condition"/></UserControl.Resources>
		<StackPanel Margin="8">
			<Label Classes="formSection" Content="{DynamicResource SectionField}" />
			<local:DisplayLayerView DataContext="{Binding Field}" Kind="Field" />

			<Label Classes="formSection" Content="{DynamicResource SectionIntensity}" />
			<local:DisplayLayerView DataContext="{Binding Intensity}" Kind="Intensity" />

			<!-- what the preview pictures draw over the frames (2026-10-29, the user's request): a selected object shows its own either way -->
			<Label Classes="formSection" Content="{DynamicResource SectionPreview}" />
			<controls:FormPanel>
				<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.Display.HandlesInPreview}"
				          IsChecked="{Binding HandlesInPreview, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.Display.HandlesInPreview}" AutomationProperties.AutomationId="DisplayHandlesInPreview" />
				<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.Display.LabelsInPreview}"
				          IsChecked="{Binding LabelsInPreview, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.Display.LabelsInPreview}" AutomationProperties.AutomationId="DisplayLabelsInPreview" />
			</controls:FormPanel>

			<Label Classes="formSection" Content="{DynamicResource SectionExportRange}" />
			<controls:FormPanel>
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.Display.ExportFrom}" />
				<NumericUpDown Value="{Binding ExportFrom, Mode=TwoWay}" Minimum="0" ToolTip.Tip="{DynamicResource Hint.Display.ExportFrom}"  Maximum="2147483647"/>

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.Display.ExportTo}" />
				<NumericUpDown Value="{Binding ExportTo, Mode=TwoWay}" Minimum="0" ToolTip.Tip="{DynamicResource Hint.Display.ExportTo}"  Maximum="2147483647"/>

				<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.Display.ProbeGraphsInExport}"
				          IsChecked="{Binding ProbeGraphsInExport, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.Display.ProbeGraphsInExport}" />
				<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.Display.ProbeMarkersInExport}"
				          IsChecked="{Binding ProbeMarkersInExport, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.Display.ProbeMarkersInExport}" />
				<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.Display.SourceMarkersInExport}"
				          IsChecked="{Binding SourceMarkersInExport, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.Display.SourceMarkersInExport}" />
			</controls:FormPanel>

			<Label Classes="formSection" Content="{DynamicResource SectionVideo}" />
			<controls:FormPanel DataContext="{Binding Video}">
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.Video.Fps}" />
				<NumericUpDown Value="{Binding Fps, Mode=TwoWay}" Minimum="1" Maximum="240" ToolTip.Tip="{DynamicResource Hint.Video.Fps}" />

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.Video.Quality}" />
				<NumericUpDown Value="{Binding Quality, Mode=TwoWay}" Minimum="1" Maximum="100" ToolTip.Tip="{DynamicResource Hint.Video.Quality}" />
			</controls:FormPanel>
		</StackPanel>

</UserControl>
