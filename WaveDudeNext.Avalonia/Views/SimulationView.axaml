<UserControl x:Class="WaveDudeNext.Avalonia.Views.SimulationView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:views="using:WaveDudeNext.Avalonia.Views"
             Classes="wpfEditor" x:CompileBindings="False">
	<StackPanel Margin="8">
		<Label Classes="formSection" Content="{DynamicResource SectionRun}" />
		<controls:FormPanel>
			<TextBlock Classes="formLabel" Text="{DynamicResource Label.Simulation.Steps}" />
			<NumericUpDown Value="{Binding Steps, Mode=TwoWay}" Minimum="1" Maximum="10000000" Increment="100" ToolTip.Tip="{DynamicResource Hint.Simulation.Steps}" FormatString="0" ParsingNumberStyle="Integer"/>

			<TextBlock Classes="formLabel" Text="{DynamicResource Label.Simulation.VisualizeEvery}" />
			<NumericUpDown Value="{Binding VisualizeEvery, Mode=TwoWay}" Minimum="1" Maximum="1000" ToolTip.Tip="{DynamicResource Hint.Simulation.VisualizeEvery}" FormatString="0" ParsingNumberStyle="Integer"/>
		</controls:FormPanel>

		<Label Classes="formSection" Content="{DynamicResource SectionSolver}" />
		<controls:FormPanel>
			<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.Simulation.FourthOrderLaplacian}"
			          IsChecked="{Binding FourthOrderLaplacian, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.Simulation.FourthOrderLaplacian}" />

			<TextBlock Classes="formLabel" Text="{DynamicResource Label.Simulation.WaveSpeed}" />
			<NumericUpDown Value="{Binding WaveSpeed, Mode=TwoWay}" Minimum="0.000001" Maximum="1000000" Increment="0.01" ToolTip.Tip="{DynamicResource Hint.Simulation.WaveSpeed}" />

			<TextBlock Classes="formLabel" Text="{DynamicResource Label.Simulation.TimeDecay}" />
			<NumericUpDown Value="{Binding TimeDecay, Mode=TwoWay}" Minimum="1" Maximum="100" ToolTip.Tip="{DynamicResource Hint.Simulation.TimeDecay}" />

			<TextBlock Classes="formLabel" Text="{DynamicResource Label.Simulation.SourceFrequencyScale}" />
			<NumericUpDown Value="{Binding SourceFrequencyScale, Mode=TwoWay}" Minimum="0" Maximum="1000" Increment="0.1" ToolTip.Tip="{DynamicResource Hint.Simulation.SourceFrequencyScale}" />

			<TextBlock Classes="formLabel" Text="{DynamicResource Label.Simulation.IntensityScale}" />
			<NumericUpDown Value="{Binding IntensityScale, Mode=TwoWay}" Minimum="0.0000001" Maximum="1000000" Increment="0.1" ToolTip.Tip="{DynamicResource Hint.Simulation.IntensityScale}" />
		</controls:FormPanel>
	</StackPanel>
</UserControl>
