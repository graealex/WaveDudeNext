<UserControl x:Class="WaveDudeNext.Avalonia.Views.PartPointsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:WaveDudeNext.Avalonia.Converters"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:commands="using:WaveDudeNext.Avalonia.Commands"
             xmlns:meta="using:WaveDudeNext.Avalonia.Markup"
             xmlns:model="using:WaveDudeNext.Model"
             Classes="wpfEditor" x:CompileBindings="False">
    <UserControl.Resources><converters:ConditionConverter x:Key="Condition"/></UserControl.Resources>



	<!-- the point list of a polygon outline (the data context is the part): one row per point with X
	     and Y relative to the centre, before rotation, a remove button, and an add button below -->
	<StackPanel>
		<Label Classes="formSection" Content="{DynamicResource SectionPoints}" />
		<TextBlock Margin="0,0,0,4" Foreground="{DynamicResource GrayText}" TextWrapping="Wrap" Text="{Binding HintText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
		<DockPanel Margin="0,0,0,2">
			<Border DockPanel.Dock="Right" Width="22" />
			<UniformGrid Columns="2">
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.PartPoint.X}" Margin="2,0" />
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.PartPoint.Y}" Margin="2,0" />
			</UniformGrid>
		</DockPanel>
		<ItemsControl x:Name="list" ItemsSource="{Binding Points}" Focusable="False">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<DockPanel Margin="0,0,0,4">
						<Button DockPanel.Dock="Right" Padding="5,0" ToolTip.Tip="{DynamicResource TipRemovePoint}" AutomationProperties.Name="{DynamicResource TipRemovePoint}"
						        Click="OnRemovePoint" ><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Delete"/></StackPanel></Button>
						<UniformGrid Columns="2">
							<NumericUpDown Margin="0,0,2,0" Value="{Binding X, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.PartPoint.X}"  Minimum="-2147483648" Maximum="2147483647"/>
							<NumericUpDown Margin="2,0,0,0" Value="{Binding Y, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.PartPoint.Y}"  Minimum="-2147483648" Maximum="2147483647"/>
						</UniformGrid>
					</DockPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
			<Button Padding="8,2" Margin="0,2,6,0" ToolTip.Tip="{DynamicResource TipAddPoint}"
			        Click="OnAddPoint" AutomationProperties.AutomationId="PartAddPoint" ><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="PlusBadge"/><TextBlock Text="{DynamicResource ButtonAddPoint}"/></StackPanel></Button>
		</StackPanel>
	</StackPanel>
</UserControl>
