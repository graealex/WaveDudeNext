<UserControl x:Class="WaveDudeNext.Avalonia.Views.FiberPartView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:WaveDudeNext.Avalonia.Converters"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:meta="using:WaveDudeNext.Avalonia.Markup"
             xmlns:views="using:WaveDudeNext.Avalonia.Views"
             xmlns:model="using:WaveDudeNext.Model"
             Classes="wpfEditor" x:CompileBindings="False">
    <UserControl.Resources><converters:ConditionConverter x:Key="Condition"/></UserControl.Resources>
		<StackPanel Margin="8">
			<views:PartCommonView />

			<Label Classes="formSection" Content="{DynamicResource SectionCore}" />
			<controls:FormPanel>
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.FiberPart.CoreIndex}" />
				<NumericUpDown Value="{Binding CoreIndex, Mode=TwoWay}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip.Tip="{DynamicResource Hint.FiberPart.CoreIndex}" AutomationProperties.AutomationId="PartCoreIndex" />

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.FiberPart.CoreDiameter}" />
				<NumericUpDown Value="{Binding CoreDiameter, Mode=TwoWay}" Minimum="2" ToolTip.Tip="{DynamicResource Hint.FiberPart.CoreDiameter}" AutomationProperties.AutomationId="PartCoreDiameter"  Maximum="2147483647"/>
			</controls:FormPanel>

			<Label Classes="formSection" Content="{DynamicResource SectionCladding}" />
			<controls:FormPanel>
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.FiberPart.CladdingIndex}" />
				<NumericUpDown Value="{Binding CladdingIndex, Mode=TwoWay}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip.Tip="{DynamicResource Hint.FiberPart.CladdingIndex}" AutomationProperties.AutomationId="PartCladdingIndex" />

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.FiberPart.CladdingThickness}" />
				<NumericUpDown Value="{Binding CladdingThickness, Mode=TwoWay}" Minimum="0" ToolTip.Tip="{DynamicResource Hint.FiberPart.CladdingThickness}" AutomationProperties.AutomationId="PartCladdingThickness"  Maximum="2147483647"/>

				<!-- the cladding's absorbing band, a hump in its outer part (2026-10-29) -->
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.FiberPart.Absorption}" />
				<NumericUpDown Value="{Binding Absorption, Mode=TwoWay}" Minimum="0" Maximum="255" Increment="5" ToolTip.Tip="{DynamicResource Hint.FiberPart.Absorption}" AutomationProperties.AutomationId="PartAbsorption" />

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.FiberPart.AbsorptionRamp}" />
				<NumericUpDown Value="{Binding AbsorptionRamp, Mode=TwoWay}" Minimum="1" Maximum="400" ToolTip.Tip="{DynamicResource Hint.FiberPart.AbsorptionRamp}" AutomationProperties.AutomationId="PartAbsorptionRamp" />

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.FiberPart.Coating}" />
				<NumericUpDown Value="{Binding Coating, Mode=TwoWay}" Minimum="0" Maximum="50" ToolTip.Tip="{DynamicResource Hint.FiberPart.Coating}" AutomationProperties.AutomationId="PartCoating" />

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.CoatedPart.CoatingProfile}" />
				<ComboBox Classes="enumComboBox" ItemsSource="{x:Static controls:EnumItems.CoatingProfile}" SelectedItem="{Binding CoatingProfile, Mode=TwoWay}"
				          ToolTip.Tip="{DynamicResource Hint.CoatedPart.CoatingProfile}" AutomationProperties.AutomationId="PartCoatingProfile" />

				<!-- the faces: the start face is the front, the end face the back, the tube the sides (2026-10-29) -->
				<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.CoatedPart.FrontCoated}"
				          IsChecked="{Binding FrontCoated, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.CoatedPart.FrontCoated}" AutomationProperties.AutomationId="PartFrontCoated" />
				<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.CoatedPart.BackCoated}"
				          IsChecked="{Binding BackCoated, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.CoatedPart.BackCoated}" AutomationProperties.AutomationId="PartBackCoated" />
				<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.CoatedPart.SidesCoated}"
				          IsChecked="{Binding SidesCoated, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.CoatedPart.SidesCoated}" AutomationProperties.AutomationId="PartSidesCoated" />
			</controls:FormPanel>

			<Label Classes="formSection" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.FiberPart.Ends}" />
				<ComboBox Classes="enumComboBox" ItemsSource="{x:Static controls:EnumItems.FiberEnds}"
				          SelectedItem="{Binding Ends, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.FiberPart.Ends}" AutomationProperties.AutomationId="PartEnds" />
			</controls:FormPanel>

			<views:FiberPathView />
		</StackPanel>

</UserControl>
