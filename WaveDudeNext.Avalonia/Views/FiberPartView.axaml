
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WaveDudeNext.Avalonia.Views"
    x:Class="WaveDudeNext.Avalonia.Views.FiberPartView"
    x:CompileBindings="False">

    <StackPanel Margin="8" Spacing="12">
    
    	<views:PartCommonView/>

        <!-- Fiber heading -->
        <StackPanel Spacing="4">
            <TextBlock Text="Fiber"
                       FontSize="17"
                       FontWeight="Bold"/>

            <TextBlock Text="{Binding Name}"
                       Foreground="#AAAAAA"/>
        </StackPanel>

        <!-- CORE -->
        <TextBlock Text="Core"
                   FontWeight="Bold"
                   Margin="0,10,0,0"/>

        <Grid ColumnDefinitions="*,120"
              RowDefinitions="Auto,Auto"
              RowSpacing="8"
              ColumnSpacing="8">

            <TextBlock Text="Core index"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     Text="{Binding CoreIndex, Mode=OneWay}"
                     IsReadOnly="True"/>

            <TextBlock Grid.Row="1"
                       Text="Core diameter"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Text="{Binding CoreDiameter, Mode=OneWay}"
                     IsReadOnly="True"/>
        </Grid>

        <!-- CLADDING -->
        <TextBlock Text="Cladding"
                   FontWeight="Bold"
                   Margin="0,10,0,0"/>

        <Grid ColumnDefinitions="*,120"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="8"
              ColumnSpacing="8">

            <TextBlock Text="Cladding index"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     Text="{Binding CladdingIndex, Mode=OneWay}"
                     IsReadOnly="True"/>

            <TextBlock Grid.Row="1"
                       Text="Cladding thickness"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Text="{Binding CladdingThickness, Mode=OneWay}"
                     IsReadOnly="True"/>

            <TextBlock Grid.Row="2"
                       Text="Absorption"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Text="{Binding Absorption, Mode=OneWay}"
                     IsReadOnly="True"/>

            <TextBlock Grid.Row="3"
                       Text="Absorption ramp"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     Text="{Binding AbsorptionRamp, Mode=OneWay}"
                     IsReadOnly="True"/>

            <TextBlock Grid.Row="4"
                       Text="Coating"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Row="4"
                     Grid.Column="1"
                     Text="{Binding Coating, Mode=OneWay}"
                     IsReadOnly="True"/>

            <TextBlock Grid.Row="5"
                       Text="Coating profile"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Row="5"
                     Grid.Column="1"
                     Text="{Binding CoatingProfile, Mode=OneWay}"
                     IsReadOnly="True"/>
        </Grid>

        <!-- COATED FACES -->
        <TextBlock Text="Coated faces"
                   FontWeight="Bold"
                   Margin="0,10,0,0"/>

        <CheckBox Content="Front coated"
                  IsChecked="{Binding FrontCoated, Mode=OneWay}"
                  IsEnabled="False"/>

        <CheckBox Content="Back coated"
                  IsChecked="{Binding BackCoated, Mode=OneWay}"
                  IsEnabled="False"/>

        <CheckBox Content="Sides coated"
                  IsChecked="{Binding SidesCoated, Mode=OneWay}"
                  IsEnabled="False"/>

        <!-- SHAPE -->
        <TextBlock Text="Shape"
                   FontWeight="Bold"
                   Margin="0,10,0,0"/>

        <Grid ColumnDefinitions="*,120">
            <TextBlock Text="Fiber ends"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     Text="{Binding Ends, Mode=OneWay}"
                     IsReadOnly="True"/>
        </Grid>

        <views:FiberPathView/>

    </StackPanel>
</UserControl>

