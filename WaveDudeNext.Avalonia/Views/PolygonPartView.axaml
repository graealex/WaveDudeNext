<UserControl x:Class="WaveDudeNext.Avalonia.Views.PolygonPartView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:WaveDudeNext.Avalonia.Converters"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:meta="using:WaveDudeNext.Avalonia.Markup"
             xmlns:views="using:WaveDudeNext.Avalonia.Views"
             xmlns:model="using:WaveDudeNext.Model"
             Classes="wpfEditor" x:CompileBindings="False">
    <UserControl.Resources><converters:ConditionConverter x:Key="Condition"/></UserControl.Resources>
		<StackPanel Margin="8">
			<views:PartCommonView />
			<views:ShapeMaterialView />

			<Label Classes="formSection" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Classes="formLabel" Text="{DynamicResource Label.PolygonPart.Sides}" />
				<NumericUpDown Value="{Binding Sides, Mode=TwoWay}" Minimum="3" Maximum="64" ToolTip.Tip="{DynamicResource Hint.PolygonPart.Sides}" AutomationProperties.AutomationId="PartSides" />

				<TextBlock Classes="formLabel" Text="{DynamicResource Label.PolygonPart.Side}" />
				<NumericUpDown Value="{Binding Side, Mode=TwoWay}" Minimum="2" Increment="10" ToolTip.Tip="{DynamicResource Hint.PolygonPart.Side}" AutomationProperties.AutomationId="PartSide"  Maximum="2147483647"/>
			</controls:FormPanel>
		</StackPanel>

</UserControl>
