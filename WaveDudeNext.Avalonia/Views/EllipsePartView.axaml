<UserControl x:Class="WaveDudeNext.Avalonia.Views.EllipsePartView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:WaveDudeNext.Avalonia.Converters"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:meta="using:WaveDudeNext.Avalonia.Markup"
             xmlns:views="using:WaveDudeNext.Avalonia.Views"
             xmlns:model="using:WaveDudeNext.Model"
             Classes="wpfEditor" x:CompileBindings="False">
    <UserControl.Resources><converters:ConditionConverter x:Key="Condition"/></UserControl.Resources>
		<StackPanel Margin="8">
			<views:PartCommonView />
			<views:ShapeMaterialView />

			<Label Classes="formSection" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<!-- the two sizes with the chain beside them spanning both rows, as the image editors draw it; one row of the
				     form, laid out to the form's label column -->
				<Grid controls:FormPanel.FullWidth="True">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="110" />
						<ColumnDefinition Width="8" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="4" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock Classes="formLabel" Text="{DynamicResource Label.EllipsePart.Length}" />
					<NumericUpDown Grid.Column="2" Value="{Binding Length, Mode=TwoWay}" Minimum="1" Increment="10" ToolTip.Tip="{DynamicResource Hint.EllipsePart.Length}" AutomationProperties.AutomationId="PartLength"  Maximum="2147483647"/>
					<TextBlock Grid.Row="2" Classes="formLabel" Text="{DynamicResource Label.EllipsePart.Width}" />
					<NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding Width, Mode=TwoWay}" Minimum="1" Increment="10" ToolTip.Tip="{DynamicResource Hint.EllipsePart.Width}" AutomationProperties.AutomationId="PartWidth"  Maximum="2147483647"/>
					<ToggleButton Grid.Column="3" Grid.RowSpan="3" Content="↔" Margin="4,0,0,0" VerticalAlignment="Center"
					              IsChecked="{Binding Linked, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.EllipsePart.Linked}" AutomationProperties.Name="{DynamicResource Label.EllipsePart.Linked}" AutomationProperties.AutomationId="PartLinked" />
				</Grid>
			</controls:FormPanel>
		</StackPanel>

</UserControl>
