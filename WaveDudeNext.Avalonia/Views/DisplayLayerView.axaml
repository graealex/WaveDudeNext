<UserControl x:Class="WaveDudeNext.Avalonia.Views.DisplayLayerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:WaveDudeNext.Avalonia.Converters"
             xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
             xmlns:local="using:WaveDudeNext.Avalonia.Views"
             xmlns:panes="using:WaveDudeNext.Avalonia.Panes"
             xmlns:meta="using:WaveDudeNext.Avalonia.Markup"
             xmlns:model="using:WaveDudeNext.Model"
             Classes="wpfEditor" x:CompileBindings="False">
    <UserControl.Resources><converters:ConditionConverter x:Key="Condition"/></UserControl.Resources>

	<controls:FormPanel>
		<TextBlock Classes="formLabel" Text="{DynamicResource Label.DisplayLayer.ColorScheme}" />
		<!-- the picker lists the project's schemes and the shared ones of this layer's kind, with previews -->
		<controls:ColorSchemePicker SelectedName="{Binding ColorScheme, Mode=TwoWay}" Kind="{Binding Kind, RelativeSource={RelativeSource AncestorType=local:DisplayLayerView}}" Project="{Binding Project, RelativeSource={RelativeSource AncestorType=panes:PropertiesPane, Tree=Logical}}"/>

		<TextBlock Classes="formLabel" Text="{DynamicResource Label.DisplayLayer.Brightness}" />
		<NumericUpDown Value="{Binding Brightness, Mode=TwoWay}" Minimum="0.0001" Maximum="100000" ToolTip.Tip="{DynamicResource Hint.DisplayLayer.Brightness}" />

		<TextBlock Classes="formLabel" Text="{DynamicResource Label.DisplayLayer.BlackLevel}" />
		<NumericUpDown Value="{Binding BlackLevel, Mode=TwoWay}" Minimum="-10" Maximum="1" Increment="0.01" ToolTip.Tip="{DynamicResource Hint.DisplayLayer.BlackLevel}" />

		<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.DisplayLayer.Preview}"
		          IsChecked="{Binding Preview, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.DisplayLayer.Preview}" />
		<!-- the scene image's glowing-edges outline: over the preview (opt-out), baked into exports (opt-in) -->
		<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.DisplayLayer.Overlay}"
		          IsChecked="{Binding Overlay, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.DisplayLayer.Overlay}" />
		<TextBlock Classes="formLabel" Text="{DynamicResource Label.DisplayLayer.OverlayGain}" />
		<NumericUpDown Value="{Binding OverlayGain, Mode=TwoWay}" Minimum="0" Maximum="5" Increment="0.05" ToolTip.Tip="{DynamicResource Hint.DisplayLayer.OverlayGain}" />
		<CheckBox controls:FormPanel.FullWidth="True" Content="{DynamicResource Label.DisplayLayer.OverlayInExport}"
		          IsChecked="{Binding OverlayInExport, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Hint.DisplayLayer.OverlayInExport}" />
	</controls:FormPanel>
</UserControl>
