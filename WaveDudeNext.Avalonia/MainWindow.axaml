<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panes="using:WaveDudeNext.Avalonia.Panes"
        xmlns:controls="using:WaveDudeNext.Avalonia.Controls"
        x:Class="WaveDudeNext.Avalonia.MainWindow"
        Title="WaveDude Next" Width="1500" Height="900" MinWidth="1000" MinHeight="600"
        Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource WorkspaceForeground}">
    <LayoutTransformControl x:Name="WorkspaceScale"><Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Menu Grid.Row="0">
            <MenuItem Header="{DynamicResource MenuFile}">
                <MenuItem Header="{DynamicResource MenuFileNew}" Click="NewProject_Click"><MenuItem.Icon><controls:IconView Drawing="New"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.AccessOpenProjectMore}" Click="OpenProject_Click"><MenuItem.Icon><controls:IconView Drawing="Open"/></MenuItem.Icon></MenuItem>
                <MenuItem x:Name="RecentMenu" Header="{DynamicResource Shell.Recentprojects}"/>
                <MenuItem Header="{DynamicResource Shell.ImportclassicprojectMore}" Click="ImportClassic_Click"><MenuItem.Icon><controls:IconView Drawing="Open"/></MenuItem.Icon></MenuItem>
                <MenuItem x:Name="ExamplesMenu" Header="{DynamicResource Shell.AccessExamples}"><MenuItem.Icon><controls:IconView Drawing="Open"/></MenuItem.Icon></MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource DialogSave}" Click="SaveProject_Click"><MenuItem.Icon><controls:IconView Drawing="Save"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.AccessSaveAsMore}" Click="SaveProjectAs_Click"><MenuItem.Icon><controls:IconView Drawing="Save"/></MenuItem.Icon></MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource Shell.ExportrecordingMore}" Click="ExportRecording_Click"><MenuItem.Icon><controls:IconView Drawing="Export"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.Cancelexport}" Click="CancelExport_Click"><MenuItem.Icon><controls:IconView Drawing="Exit"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.ExportfieldframeMore}" Tag="Field" Click="ExportFrame_Click"><MenuItem.Icon><controls:IconView Drawing="Export"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.ExportintensityframeMore}" Tag="Intensity" Click="ExportFrame_Click"><MenuItem.Icon><controls:IconView Drawing="Export"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.ExportselectedprobeCSVMore}" Click="ExportProbe_Click"><MenuItem.Icon><controls:IconView Drawing="Export"/></MenuItem.Icon></MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource MenuFileExit}" Click="Exit_Click"><MenuItem.Icon><controls:IconView Drawing="Exit"/></MenuItem.Icon></MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuEdit}">
                <MenuItem Header="{DynamicResource MenuEditUndo}" Click="Undo_Click"><MenuItem.Icon><controls:IconView Drawing="Undo"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource MenuEditRedo}" Click="Redo_Click"><MenuItem.Icon><controls:IconView Drawing="Redo"/></MenuItem.Icon></MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource MenuEditCut}" Click="Cut_Click"><MenuItem.Icon><controls:IconView Drawing="Delete"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource MessagesCopy}" Click="Copy_Click"><MenuItem.Icon><controls:IconView Drawing="Duplicate"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource MenuEditPaste}" Click="Paste_Click"><MenuItem.Icon><controls:IconView Drawing="Duplicate"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource MenuProjectDuplicate}" Click="Duplicate_Click"><MenuItem.Icon><controls:IconView Drawing="Duplicate"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource MenuEditDelete}" Click="Delete_Click"><MenuItem.Icon><controls:IconView Drawing="Delete"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource MenuProjectMoveUp}" Tag="-1" Click="MoveObject_Click"><MenuItem.Icon><controls:IconView Drawing="Up"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.AccessMovedown}" Tag="1" Click="MoveObject_Click"><MenuItem.Icon><controls:IconView Drawing="Down"/></MenuItem.Icon></MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource Shell.AccessProject}">
                <MenuItem Header="{DynamicResource MenuProjectAddSource}" Click="AddSource_Click"><MenuItem.Icon><controls:IconView Drawing="Source"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.AccessAddpart}"><MenuItem.Icon><controls:IconView Drawing="Part"/></MenuItem.Icon>
                    <MenuItem Header="{DynamicResource Shell.Lensmirror}" Tag="LensPart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="Lens"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="{DynamicResource Shell.Polygon}" Tag="PolygonPart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="Polygon"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="{DynamicResource Shell.Rectangle}" Tag="RectanglePart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="Rectangle"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="{DynamicResource Shell.Ellipse}" Tag="EllipsePart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="Ellipse"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="{DynamicResource Shell.Triangle}" Tag="TrianglePart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="Triangle"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="{DynamicResource Shell.Outline}" Tag="OutlinePart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="Outline"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="{DynamicResource Shell.Fibre}" Tag="FiberPart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="Fiber"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="{DynamicResource Shell.Braggreflector}" Tag="BraggReflectorPart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="BraggReflector"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="{DynamicResource Shell.GRINlens}" Tag="GrinLensPart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="GrinLens"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="{DynamicResource Shell.Zoneplate}" Tag="ZonePlatePart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="ZonePlate"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="{DynamicResource Shell.XORgate}" Tag="XorGatePart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="XorGate"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="{DynamicResource Shell.ANDgate}" Tag="AndGatePart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="AndGate"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="{DynamicResource Shell.ORgate}" Tag="OrGatePart" Click="AddPart_Click"><MenuItem.Icon><controls:IconView Drawing="OrGate"/></MenuItem.Icon></MenuItem>
                </MenuItem>
                <MenuItem Header="{DynamicResource Shell.AccessAddprobe}" Click="AddProbe_Click"><MenuItem.Icon><controls:IconView Drawing="Probe"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.Addcolourscheme}" Click="AddScheme_Click"><MenuItem.Icon><controls:IconView Drawing="Palette"/></MenuItem.Icon></MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuSimulation}">
                <MenuItem Header="{DynamicResource DialogRun}" Click="Start_Click"><MenuItem.Icon><controls:IconView Drawing="Play"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource MenuSimulationPause}" Click="Pause_Click"><MenuItem.Icon><controls:IconView Drawing="Pause"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.AccessReset}" Click="Reset_Click"><MenuItem.Icon><controls:IconView Drawing="Reset"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.Rerecordprobes}" Click="RerunProbes_Click"><MenuItem.Icon><controls:IconView Drawing="Probe"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.Applychanges}" Click="ApplyChanges_Click"><MenuItem.Icon><controls:IconView Drawing="Apply"/></MenuItem.Icon></MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource Shell.Setplaybackinpoint}" Click="MarkIn_Click"><MenuItem.Icon><controls:IconView Drawing="First"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.Setplaybackoutpoint}" Click="MarkOut_Click"><MenuItem.Icon><controls:IconView Drawing="Last"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.Clearplaybackrange}" Click="ClearRange_Click"><MenuItem.Icon><controls:IconView Drawing="Reset"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.Playpauseplayback}" Click="PlayPause_Click"><MenuItem.Icon><controls:IconView Drawing="Play"/></MenuItem.Icon></MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuView}">
                <MenuItem Header="{DynamicResource Shell.Previewquality}"><MenuItem Header="{DynamicResource Shell.Automatic}" Tag="Auto" Click="PreviewQuality_Click"><MenuItem.Icon><controls:IconView Drawing="PreviewResolution"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.Full16bit}" Tag="Full" Click="PreviewQuality_Click"><MenuItem.Icon><controls:IconView Drawing="PreviewResolution"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.Balanced8bit}" Tag="Balanced" Click="PreviewQuality_Click"><MenuItem.Icon><controls:IconView Drawing="PreviewResolution"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.Economyhalfresolutionalternateframes8bit}" Tag="Economy" Click="PreviewQuality_Click"><MenuItem.Icon><controls:IconView Drawing="PreviewResolution"/></MenuItem.Icon></MenuItem></MenuItem>
                <MenuItem Header="{DynamicResource Shell.Panes}"><MenuItem Header="{DynamicResource Shell.Showprojecttree}" Tag="Tree" Click="ShowPane_Click"/><MenuItem Header="{DynamicResource Shell.Showproperties}" Tag="Properties" Click="ShowPane_Click"/><MenuItem Header="{DynamicResource Shell.Showfield}" Tag="Field" Click="ShowPane_Click"/><MenuItem Header="{DynamicResource Shell.Showintensity}" Tag="Intensity" Click="ShowPane_Click"/><MenuItem x:Name="ProbePanesMenu" Header="{DynamicResource Shell.Probeviewports}"/><MenuItem Header="{DynamicResource Shell.Resetlayout}" Click="ResetLayout_Click"/><MenuItem Header="{DynamicResource Shell.Floatprojecttree}" Tag="Tree" Click="FloatPane_Click"><MenuItem.Icon><controls:IconView Drawing="Duplicate"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.Floatproperties}" Tag="Properties" Click="FloatPane_Click"><MenuItem.Icon><controls:IconView Drawing="Duplicate"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.Floatfield}" Tag="Field" Click="FloatPane_Click"><MenuItem.Icon><controls:IconView Drawing="Duplicate"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.Floatintensity}" Tag="Intensity" Click="FloatPane_Click"><MenuItem.Icon><controls:IconView Drawing="Duplicate"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.Dockallpanes}" Click="DockAll_Click"><MenuItem.Icon><controls:IconView Drawing="Apply"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.Tabbedpreviews}" Click="TabbedPreviews_Click"><MenuItem.Icon><controls:IconView Drawing="Duplicate"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.Sidebysidepreviews}" Click="SideBySide_Click"><MenuItem.Icon><controls:IconView Drawing="Project"/></MenuItem.Icon></MenuItem></MenuItem>
                <MenuItem Header="{DynamicResource Shell.Fitpreviews}" Click="FitViews_Click"><MenuItem.Icon><controls:IconView Drawing="Project"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{DynamicResource Shell.UIzoom}"><MenuItem Header="{DynamicResource Shell.80}" Tag="0.8" Click="UiZoom_Click"><MenuItem.Icon><controls:IconView Drawing="Project"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.100}" Tag="1" Click="UiZoom_Click"><MenuItem.Icon><controls:IconView Drawing="Project"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.125}" Tag="1.25" Click="UiZoom_Click"><MenuItem.Icon><controls:IconView Drawing="Project"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.150}" Tag="1.5" Click="UiZoom_Click"><MenuItem.Icon><controls:IconView Drawing="Project"/></MenuItem.Icon></MenuItem></MenuItem>
                <MenuItem Header="{DynamicResource Shell.Theme}"><MenuItem Header="{DynamicResource Enum.AppTheme.System}" Tag="Default" Click="Theme_Click"><MenuItem.Icon><controls:IconView Drawing="Palette"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Enum.AppTheme.Dark}" Tag="Dark" Click="Theme_Click"><MenuItem.Icon><controls:IconView Drawing="Palette"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Enum.AppTheme.Light}" Tag="Light" Click="Theme_Click"><MenuItem.Icon><controls:IconView Drawing="Palette"/></MenuItem.Icon></MenuItem></MenuItem>
                <MenuItem Header="{DynamicResource Shell.Language}"><MenuItem Header="{DynamicResource Shell.English}" Tag="EN" Click="Language_Click"><MenuItem.Icon><controls:IconView Drawing="Project"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.Deutsch}" Tag="DE" Click="Language_Click"><MenuItem.Icon><controls:IconView Drawing="Project"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.Français}" Tag="FR" Click="Language_Click"><MenuItem.Icon><controls:IconView Drawing="Project"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.Nederlands}" Tag="NL" Click="Language_Click"><MenuItem.Icon><controls:IconView Drawing="Project"/></MenuItem.Icon></MenuItem></MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuHelp}"><MenuItem Header="{DynamicResource MenuHelpManual}" Click="Manual_Click"><MenuItem.Icon><controls:IconView Drawing="Open"/></MenuItem.Icon></MenuItem><MenuItem Header="{DynamicResource Shell.AccessAboutdiagnostics}" Click="Diagnostics_Click"><MenuItem.Icon><controls:IconView Drawing="Project"/></MenuItem.Icon></MenuItem></MenuItem>
        </Menu>
        <Border Grid.Row="1" Background="{DynamicResource WorkspaceHeader}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="0,1,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Button Click="NewProject_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="New"/><TextBlock Text="{DynamicResource Shell.New}"/></StackPanel></Button>
                <Button Click="OpenProject_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Open"/><TextBlock Text="{DynamicResource Shell.Open}"/></StackPanel></Button>
                <Button Click="SaveProject_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Save"/><TextBlock Text="{DynamicResource Shell.Save}"/></StackPanel></Button>
                <Separator Width="8"/>
                <Button Click="Start_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Play"/><TextBlock Text="{DynamicResource Shell.Run}"/></StackPanel></Button>
                <Button Click="Pause_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Pause"/><TextBlock Text="{DynamicResource Shell.Pause}"/></StackPanel></Button>
                <Button Click="Reset_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Reset"/><TextBlock Text="{DynamicResource Shell.Reset}"/></StackPanel></Button>
                <Button Click="ApplyChanges_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Apply"/><TextBlock Text="{DynamicResource Shell.Apply}"/></StackPanel></Button>
                <Button Click="Undo_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Undo"/><TextBlock Text="{DynamicResource Shell.Undo}"/></StackPanel></Button>
                <Button Click="Redo_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Redo"/><TextBlock Text="{DynamicResource Shell.Redo}"/></StackPanel></Button>
                <Separator Width="8"/>
                <Button Click="AddSource_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Source" PlusBadge="True"/><TextBlock Text="{DynamicResource Shell.Source}"/></StackPanel></Button>
                <Button Tag="LensPart" Click="AddPart_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Lens" PlusBadge="True"/><TextBlock Text="{DynamicResource Shell.Lens}"/></StackPanel></Button>
                <Button Click="AddProbe_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Probe" PlusBadge="True"/><TextBlock Text="{DynamicResource Shell.Probe}"/></StackPanel></Button>
                <CheckBox x:Name="AutoApply" Content="{DynamicResource Shell.Autorerun}" IsChecked="True" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
        <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnDefinitions="240,5,*,5,340" Margin="4">
            <Border x:Name="TreeHost" Grid.Column="0" Background="{DynamicResource WorkspacePane}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1">
                <panes:ProjectTree x:Name="ProjectTreeControl"/>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="{DynamicResource WorkspaceBorder}"/>
            <Grid x:Name="PreviewGrid" Grid.Column="2" ColumnDefinitions="*,5,*">
                <Border x:Name="FieldHost" Grid.Column="0" Background="{DynamicResource WorkspaceCanvas}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Border Background="{DynamicResource WorkspaceBackground}" Padding="6,4"><TextBlock Text="{DynamicResource Shell.Field}" FontWeight="SemiBold"/></Border>
                        <Grid Grid.Row="1" ClipToBounds="True">
                            <Image x:Name="FieldImage" AutomationProperties.AccessibilityView="Raw" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                            <controls:SceneCanvas x:Name="FieldCanvas"/>
                        </Grid>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="{DynamicResource WorkspaceBorder}"/>
                <Border x:Name="IntensityHost" Grid.Column="2" Background="{DynamicResource WorkspaceCanvas}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <Border Background="{DynamicResource WorkspaceBackground}" Padding="6,4"><TextBlock Text="{DynamicResource Shell.Intensity}" FontWeight="SemiBold"/></Border>
                        <Grid Grid.Row="1" ClipToBounds="True">
                            <Image x:Name="IntensityImage" AutomationProperties.AccessibilityView="Raw" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                            <controls:SceneCanvas x:Name="IntensityCanvas"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3" Width="5" ResizeDirection="Columns" Background="{DynamicResource WorkspaceBorder}"/>
            <Border x:Name="PropertiesHost" Grid.Column="4" Background="{DynamicResource WorkspacePane}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="{DynamicResource WorkspaceBackground}" Padding="6,4"><TextBlock Text="{DynamicResource Shell.Properties}" FontWeight="SemiBold"/></Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <panes:PropertiesPane x:Name="PropertiesEditor"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource WorkspacePane}" Padding="8,5" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button ToolTip.Tip="{DynamicResource Shell.Firstframe}" AutomationProperties.Name="{DynamicResource Shell.Firstframe}" Tag="First" Click="Seek_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="First"/></StackPanel></Button>
                    <Button ToolTip.Tip="{DynamicResource Shell.Previousframe}" AutomationProperties.Name="{DynamicResource Shell.Previousframe}" Tag="Previous" Click="Seek_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Previous"/></StackPanel></Button>
                    <Button x:Name="PlayButton" Click="PlayPause_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Play"/><TextBlock Text="{DynamicResource Shell.Play}"/></StackPanel></Button>
                    <Button ToolTip.Tip="{DynamicResource Shell.Nextframe}" AutomationProperties.Name="{DynamicResource Shell.Nextframe}" Tag="Next" Click="Seek_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Next"/></StackPanel></Button>
                    <Button ToolTip.Tip="{DynamicResource Shell.Lastframe}" AutomationProperties.Name="{DynamicResource Shell.Lastframe}" Tag="Last" Click="Seek_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:IconView Drawing="Last"/></StackPanel></Button>
                </StackPanel>
                <Slider x:Name="TimelineSlider" AutomationProperties.Name="{DynamicResource Shell.Frametimeline}" Grid.Column="1" Minimum="0" Maximum="0" Value="0" Margin="12,0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Timeline_Changed"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <CheckBox x:Name="LoopPlayback" Content="{DynamicResource Shell.Loop}"/>
                    <TextBlock Text="{DynamicResource Shell.Speed}" VerticalAlignment="Center"/>
                    <NumericUpDown x:Name="PlaybackSpeed" AutomationProperties.Name="{DynamicResource Shell.Playbackspeed}" Value="1" Minimum="0.1" Maximum="8" Increment="0.1" Width="85"/>
                </StackPanel>
                <TextBlock x:Name="FrameText" Grid.Row="1" Grid.ColumnSpan="3" Text="{DynamicResource Shell.Frame0}" Foreground="{DynamicResource WorkspaceMuted}" Margin="0,3,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="4" Background="#007ACC" Padding="8,4">
            <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Text="{DynamicResource Shell.Ready}" Foreground="White"/>
        </Border>
    </Grid></LayoutTransformControl>
</Window>
