
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WaveDudeNext.Avalonia.MainWindow"
        Title="WaveDudeNext - Linux"
        Width="1100"
        Height="650"
        Background="#171B22">

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="12"
          RowSpacing="10">

        <StackPanel Orientation="Horizontal"
                    Spacing="8">
             <Button Content="Open Project" Click="OpenProject_Click"/>
            <Button Content="Start" Click="Start_Click"/>
            <Button Content="Pause" Click="Pause_Click"/>
            <Button Content="Reset" Click="Reset_Click"/>
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="10">

            <Border Background="#10151E"
                    Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Wave Field"
                               Foreground="White"/>
                    <Image x:Name="FieldImage"
                           Grid.Row="1"
                           Stretch="Uniform"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#10151E"
                    Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Intensity"
                               Foreground="White"/>
                    <Image x:Name="IntensityImage"
                           Grid.Row="1"
                           Stretch="Uniform"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Text="Ready"
                   Foreground="#AAAAAA"/>
    </Grid>
</Window>

