<UserControl x:Class="WaveDudeNext.WPF.Views.PolygonPartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<views:ShapeMaterialView />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:PolygonPart.Sides}" />
				<controls:NumberBox Text="{Binding Sides}" Minimum="3" Maximum="64" ToolTip="{meta:Hint model:PolygonPart.Sides}" AutomationProperties.AutomationId="PartSides" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:PolygonPart.Side}" />
				<controls:NumberBox Text="{Binding Side}" Minimum="2" Increment="10" ToolTip="{meta:Hint model:PolygonPart.Side}" AutomationProperties.AutomationId="PartSide" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
