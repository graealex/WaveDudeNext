<UserControl x:Class="WaveDudeNext.WPF.Views.SceneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:commands="clr-namespace:WaveDudeNext.WPF.Commands"
             xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:local="clr-namespace:WaveDudeNext.WPF"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<UserControl.Resources>
		<converters:ImageInfoConverter x:Key="ImageInfo" />
		<!-- the size applies to a blank canvas; the image rows (name, file, embedded size) show for an image scene and are gone
		     for a canvas (2026-10-26, Jeroen's report: the path of an image no longer in use kept showing) -->
		<Style x:Key="CanvasOnly" TargetType="{x:Type controls:NumberBox}" BasedOn="{StaticResource {x:Type controls:NumberBox}}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding Mode}" Value="Image">
					<Setter Property="IsEnabled" Value="False" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="ImageRow" TargetType="{x:Type FrameworkElement}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding Mode}" Value="Canvas">
					<Setter Property="Visibility" Value="Collapsed" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="ImageRowLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FormLabel}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding Mode}" Value="Canvas">
					<Setter Property="Visibility" Value="Collapsed" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionCanvas}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.Mode}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:SceneMode}"
				          SelectedItem="{Binding Mode}" ToolTip="{meta:Hint model:Scene.Mode}" />

				<TextBlock Style="{StaticResource ImageRowLabel}" Text="{meta:Label model:Scene.Image}" />
				<!-- the name of the embedded image (or a legacy path), the picker that embeds a file, and the X that removes the image
				     (2026-10-26, Jeroen's report: there was no way to drop one), leaving a blank canvas of the image's size; the X is
				     the panes' close glyph in the button's text colour, so it greys with the button -->
				<DockPanel Style="{StaticResource ImageRow}">
					<Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="7,0" ToolTip="{DynamicResource TipRemoveSceneImage}"
					        AutomationProperties.Name="{DynamicResource TipRemoveSceneImage}" Command="{x:Static commands:ProjectCommands.RemoveSceneImage}"
					        AutomationProperties.AutomationId="SceneRemoveImage">
						<Path Data="{StaticResource CloseGeometry}" Width="8" Height="8" Stretch="Uniform" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
					</Button>
					<Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,0" Content="{DynamicResource ButtonBrowse}"
					        ToolTip="{DynamicResource TipBrowseSceneImage}" Command="{x:Static commands:ProjectCommands.BrowseSceneImage}"
					        AutomationProperties.AutomationId="SceneBrowse" />
					<TextBox Text="{Binding Image, UpdateSourceTrigger=PropertyChanged}" ToolTip="{meta:Hint model:Scene.Image}" />
				</DockPanel>

				<TextBlock Style="{StaticResource ImageRowLabel}" Text="{meta:Label model:Scene.ImagePath}" />
				<!-- the path and, when the file is not on disk, a note (the window checks; the embedded image is what is simulated) -->
				<DockPanel Style="{StaticResource ImageRow}">
					<TextBlock DockPanel.Dock="Right" Margin="4,0,0,0" VerticalAlignment="Center" Text="{DynamicResource SceneImageNotFound}"
					           Visibility="{Binding SceneImageFileMissing, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Converter={StaticResource BoolToVisibility}}"
					           AutomationProperties.AutomationId="SceneImageNotFound" />
					<TextBlock VerticalAlignment="Center" Text="{Binding ImagePath}" TextTrimming="CharacterEllipsis" ToolTip="{meta:Hint model:Scene.ImagePath}"
					           AutomationProperties.AutomationId="SceneImagePath" />
				</DockPanel>

				<TextBlock Style="{StaticResource ImageRowLabel}" Text="{DynamicResource LabelEmbeddedImage}" />
				<DockPanel Style="{StaticResource ImageRow}">
					<TextBlock VerticalAlignment="Center" Text="{Binding ImageData, Converter={StaticResource ImageInfo}}"
					           ToolTip="{DynamicResource TipEmbeddedImage}" AutomationProperties.AutomationId="SceneImageInfo" />
				</DockPanel>

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.Width}" />
				<controls:NumberBox Style="{StaticResource CanvasOnly}" Text="{Binding Width}" Minimum="8" Maximum="16384" ToolTip="{meta:Hint model:Scene.Width}" AutomationProperties.AutomationId="SceneWidth" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.Height}" />
				<controls:NumberBox Style="{StaticResource CanvasOnly}" Text="{Binding Height}" Minimum="8" Maximum="16384" ToolTip="{meta:Hint model:Scene.Height}" AutomationProperties.AutomationId="SceneHeight" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.Edges}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:EdgeMode}"
				          SelectedItem="{Binding Edges}" ToolTip="{meta:Hint model:Scene.Edges}" AutomationProperties.AutomationId="SceneEdges" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.DampingEdge}" />
				<controls:NumberBox Text="{Binding DampingEdge}" Minimum="-8192" Maximum="8192" ToolTip="{meta:Hint model:Scene.DampingEdge}" AutomationProperties.AutomationId="SceneDampingEdge" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.RefractiveIndex}" />
				<controls:NumberBox Text="{Binding RefractiveIndex}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip="{meta:Hint model:Scene.RefractiveIndex}" />
			</controls:FormPanel>

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionImageSources}" />
			<controls:FormPanel>
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:Scene.ImageSources}"
				          IsChecked="{Binding ImageSources}" ToolTip="{meta:Hint model:Scene.ImageSources}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.ImageSourceScale}" />
				<controls:NumberBox Text="{Binding ImageSourceScale}" Minimum="0" Maximum="1000" Increment="0.1" IsEnabled="{Binding ImageSources}" ToolTip="{meta:Hint model:Scene.ImageSourceScale}" />

				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:Scene.ObjectSources}"
				          IsChecked="{Binding ObjectSources}" ToolTip="{meta:Hint model:Scene.ObjectSources}" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
