<UserControl x:Class="WaveDudeNext.WPF.Views.RectanglePartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<views:ShapeMaterialView />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<!-- the two sizes with the chain beside them spanning both rows, as the image editors draw it; one row of the
				     form, laid out to the form's label column -->
				<Grid controls:FormPanel.FullWidth="True">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="{Binding LabelWidth, RelativeSource={RelativeSource AncestorType={x:Type controls:FormPanel}}}" />
						<ColumnDefinition Width="8" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="4" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:RectanglePart.Length}" />
					<controls:NumberBox Grid.Column="2" Text="{Binding Length}" Minimum="1" Increment="10" ToolTip="{meta:Hint model:RectanglePart.Length}" AutomationProperties.AutomationId="PartLength" />
					<TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="{meta:Label model:RectanglePart.Width}" />
					<controls:NumberBox Grid.Row="2" Grid.Column="2" Text="{Binding Width}" Minimum="1" Increment="10" ToolTip="{meta:Hint model:RectanglePart.Width}" AutomationProperties.AutomationId="PartWidth" />
					<ToggleButton Grid.Column="3" Grid.RowSpan="3" Style="{StaticResource LinkToggle}" Margin="4,0,0,0" VerticalAlignment="Center"
					              IsChecked="{Binding Linked}" ToolTip="{meta:Hint model:RectanglePart.Linked}" AutomationProperties.Name="{meta:Label model:RectanglePart.Linked}" AutomationProperties.AutomationId="PartLinked" />
				</Grid>
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
