<UserControl x:Class="WaveDudeNext.WPF.Views.RectanglePartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:commands="clr-namespace:WaveDudeNext.WPF.Commands"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<UserControl.CommandBindings>
		<CommandBinding Command="{x:Static commands:PartCommands.MakeSquare}" CanExecute="CanMakeSquare" Executed="OnMakeSquare" />
	</UserControl.CommandBindings>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<views:ShapeMaterialView />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:RectanglePart.Length}" />
				<controls:NumberBox Text="{Binding Length}" Minimum="1" Increment="10" ToolTip="{meta:Hint model:RectanglePart.Length}" AutomationProperties.AutomationId="PartLength" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:RectanglePart.Width}" />
				<controls:NumberBox Text="{Binding Width}" Minimum="1" Increment="10" ToolTip="{meta:Hint model:RectanglePart.Width}" AutomationProperties.AutomationId="PartWidth" />

				<!-- the Square button (the user's request, 2026-10-18): the width takes the length -->
				<Button controls:FormPanel.FullWidth="True" HorizontalAlignment="Left" Padding="8,2" Margin="0,2,0,0" Content="{DynamicResource ButtonSquare}" ToolTip="{DynamicResource TipSquare}"
				        Command="{x:Static commands:PartCommands.MakeSquare}" AutomationProperties.AutomationId="PartSquare" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
