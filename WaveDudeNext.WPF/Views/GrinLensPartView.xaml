<UserControl x:Class="WaveDudeNext.WPF.Views.GrinLensPartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionMaterial}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:GrinLensPart.CentreIndex}" />
				<controls:NumberBox Text="{Binding CentreIndex}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip="{meta:Hint model:GrinLensPart.CentreIndex}" AutomationProperties.AutomationId="PartCentreIndex" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:GrinLensPart.EdgeIndex}" />
				<controls:NumberBox Text="{Binding EdgeIndex}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip="{meta:Hint model:GrinLensPart.EdgeIndex}" AutomationProperties.AutomationId="PartEdgeIndex" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:GrinLensPart.Coating}" />
				<controls:NumberBox Text="{Binding Coating}" Minimum="0" Maximum="50" ToolTip="{meta:Hint model:GrinLensPart.Coating}" AutomationProperties.AutomationId="PartCoating" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:CoatedPart.CoatingProfile}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:CoatingProfile}" SelectedItem="{Binding CoatingProfile}"
				          ToolTip="{meta:Hint model:CoatedPart.CoatingProfile}" AutomationProperties.AutomationId="PartCoatingProfile" />

				<!-- the faces by their outward normal: the end faces across the axis are front and back, the long sides the sides -->
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:CoatedPart.FrontCoated}"
				          IsChecked="{Binding FrontCoated}" ToolTip="{meta:Hint model:CoatedPart.FrontCoated}" AutomationProperties.AutomationId="PartFrontCoated" />
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:CoatedPart.BackCoated}"
				          IsChecked="{Binding BackCoated}" ToolTip="{meta:Hint model:CoatedPart.BackCoated}" AutomationProperties.AutomationId="PartBackCoated" />
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:CoatedPart.SidesCoated}"
				          IsChecked="{Binding SidesCoated}" ToolTip="{meta:Hint model:CoatedPart.SidesCoated}" AutomationProperties.AutomationId="PartSidesCoated" />
			</controls:FormPanel>

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:GrinLensPart.Length}" />
				<controls:NumberBox Text="{Binding Length}" Minimum="1" Increment="10" ToolTip="{meta:Hint model:GrinLensPart.Length}" AutomationProperties.AutomationId="PartLength" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:GrinLensPart.Diameter}" />
				<controls:NumberBox Text="{Binding Diameter}" Minimum="2" Increment="10" ToolTip="{meta:Hint model:GrinLensPart.Diameter}" AutomationProperties.AutomationId="PartDiameter" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
