<UserControl x:Class="WaveDudeNext.WPF.Views.OutlinePartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views">

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<views:ShapeMaterialView />
			<views:PartPointsView HintText="{DynamicResource HintPolygonPoints}" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
