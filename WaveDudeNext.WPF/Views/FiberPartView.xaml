<UserControl x:Class="WaveDudeNext.WPF.Views.FiberPartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionCore}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FiberPart.CoreIndex}" />
				<controls:NumberBox Text="{Binding CoreIndex}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip="{meta:Hint model:FiberPart.CoreIndex}" AutomationProperties.AutomationId="PartCoreIndex" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FiberPart.CoreDiameter}" />
				<controls:NumberBox Text="{Binding CoreDiameter}" Minimum="2" ToolTip="{meta:Hint model:FiberPart.CoreDiameter}" AutomationProperties.AutomationId="PartCoreDiameter" />
			</controls:FormPanel>

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionCladding}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FiberPart.CladdingIndex}" />
				<controls:NumberBox Text="{Binding CladdingIndex}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip="{meta:Hint model:FiberPart.CladdingIndex}" AutomationProperties.AutomationId="PartCladdingIndex" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FiberPart.CladdingThickness}" />
				<controls:NumberBox Text="{Binding CladdingThickness}" Minimum="0" ToolTip="{meta:Hint model:FiberPart.CladdingThickness}" AutomationProperties.AutomationId="PartCladdingThickness" />

				<!-- the cladding's absorbing band, a hump in its outer part (2026-10-29) -->
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FiberPart.Absorption}" />
				<controls:NumberBox Text="{Binding Absorption}" Minimum="0" Maximum="255" Increment="5" ToolTip="{meta:Hint model:FiberPart.Absorption}" AutomationProperties.AutomationId="PartAbsorption" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FiberPart.AbsorptionRamp}" />
				<controls:NumberBox Text="{Binding AbsorptionRamp}" Minimum="1" Maximum="400" ToolTip="{meta:Hint model:FiberPart.AbsorptionRamp}" AutomationProperties.AutomationId="PartAbsorptionRamp" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FiberPart.Coating}" />
				<controls:NumberBox Text="{Binding Coating}" Minimum="0" Maximum="50" ToolTip="{meta:Hint model:FiberPart.Coating}" AutomationProperties.AutomationId="PartCoating" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:CoatedPart.CoatingProfile}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:CoatingProfile}" SelectedItem="{Binding CoatingProfile}"
				          ToolTip="{meta:Hint model:CoatedPart.CoatingProfile}" AutomationProperties.AutomationId="PartCoatingProfile" />

				<!-- the faces: the start face is the front, the end face the back, the tube the sides (2026-10-29) -->
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:CoatedPart.FrontCoated}"
				          IsChecked="{Binding FrontCoated}" ToolTip="{meta:Hint model:CoatedPart.FrontCoated}" AutomationProperties.AutomationId="PartFrontCoated" />
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:CoatedPart.BackCoated}"
				          IsChecked="{Binding BackCoated}" ToolTip="{meta:Hint model:CoatedPart.BackCoated}" AutomationProperties.AutomationId="PartBackCoated" />
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:CoatedPart.SidesCoated}"
				          IsChecked="{Binding SidesCoated}" ToolTip="{meta:Hint model:CoatedPart.SidesCoated}" AutomationProperties.AutomationId="PartSidesCoated" />
			</controls:FormPanel>

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:FiberPart.Ends}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:FiberEnds}"
				          SelectedItem="{Binding Ends}" ToolTip="{meta:Hint model:FiberPart.Ends}" AutomationProperties.AutomationId="PartEnds" />
			</controls:FormPanel>

			<views:FiberPathView />
		</StackPanel>
	</ScrollViewer>
</UserControl>
