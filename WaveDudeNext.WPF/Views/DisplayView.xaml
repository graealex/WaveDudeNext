<UserControl x:Class="WaveDudeNext.WPF.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionField}" />
			<local:DisplayLayerView DataContext="{Binding Field}" Kind="Field" />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionIntensity}" />
			<local:DisplayLayerView DataContext="{Binding Intensity}" Kind="Intensity" />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionExportRange}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Display.ExportFrom}" />
				<controls:NumberBox Text="{Binding ExportFrom}" Minimum="0" ToolTip="{meta:Hint model:Display.ExportFrom}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Display.ExportTo}" />
				<controls:NumberBox Text="{Binding ExportTo}" Minimum="0" ToolTip="{meta:Hint model:Display.ExportTo}" />

				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:Display.ProbeGraphsInExport}"
				          IsChecked="{Binding ProbeGraphsInExport}" ToolTip="{meta:Hint model:Display.ProbeGraphsInExport}" />
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:Display.ProbeMarkersInExport}"
				          IsChecked="{Binding ProbeMarkersInExport}" ToolTip="{meta:Hint model:Display.ProbeMarkersInExport}" />
			</controls:FormPanel>

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionVideo}" />
			<controls:FormPanel DataContext="{Binding Video}">
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Video.Fps}" />
				<controls:NumberBox Text="{Binding Fps}" Minimum="1" Maximum="240" ToolTip="{meta:Hint model:Video.Fps}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Video.Quality}" />
				<controls:NumberBox Text="{Binding Quality}" Minimum="1" Maximum="100" ToolTip="{meta:Hint model:Video.Quality}" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
