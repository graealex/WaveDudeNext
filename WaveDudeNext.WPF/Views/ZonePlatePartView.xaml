<UserControl x:Class="WaveDudeNext.WPF.Views.ZonePlatePartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<UserControl.Resources>
		<converters:ZonePlateConverter x:Key="Plate" />
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionDesign}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:ZonePlatePart.DesignFrequency}" />
				<controls:NumberBox Text="{Binding DesignFrequency}" Minimum="1" Maximum="255" DragStep="0.1" Decimals="2" ToolTip="{meta:Hint model:ZonePlatePart.DesignFrequency}" AutomationProperties.AutomationId="PartDesignFrequency" />

				<!-- read-only: the wavelength the frequency gives with the project's frequency scale -->
				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource LabelWavelength}" />
				<TextBlock Style="{StaticResource FormReadout}" ToolTip="{DynamicResource TipGateWavelength}" AutomationProperties.AutomationId="PartWavelength">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Plate}" ConverterParameter="Wavelength">
							<Binding /><Binding Path="Wavelength" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:ZonePlatePart.FocalLength}" />
				<controls:NumberBox Text="{Binding FocalLength}" Minimum="1" Increment="10" ToolTip="{meta:Hint model:ZonePlatePart.FocalLength}" AutomationProperties.AutomationId="PartFocalLength" />

				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:ZonePlatePart.Inverse}"
				          IsChecked="{Binding Inverse}" ToolTip="{meta:Hint model:ZonePlatePart.Inverse}" AutomationProperties.AutomationId="PartInverse" />
			</controls:FormPanel>

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:ZonePlatePart.Diameter}" />
				<controls:NumberBox Text="{Binding Diameter}" Minimum="2" Increment="10" ToolTip="{meta:Hint model:ZonePlatePart.Diameter}" AutomationProperties.AutomationId="PartDiameter" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:ZonePlatePart.Thickness}" />
				<controls:NumberBox Text="{Binding Thickness}" Minimum="1" ToolTip="{meta:Hint model:ZonePlatePart.Thickness}" AutomationProperties.AutomationId="PartThickness" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:ZonePlatePart.Coating}" />
				<controls:NumberBox Text="{Binding Coating}" Minimum="0" Maximum="400" ToolTip="{meta:Hint model:ZonePlatePart.Coating}" AutomationProperties.AutomationId="PartCoating" />

				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:ZonePlatePart.Mount}"
				          IsChecked="{Binding Mount}" ToolTip="{meta:Hint model:ZonePlatePart.Mount}" AutomationProperties.AutomationId="PartMount" />

				<!-- the mount's width, only while there is a mount -->
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:ZonePlatePart.MountWidth}" />
				<controls:NumberBox Text="{Binding MountWidth}" Minimum="1" Increment="10" IsEnabled="{Binding Mount}" ToolTip="{meta:Hint model:ZonePlatePart.MountWidth}" AutomationProperties.AutomationId="PartMountWidth" />
			</controls:FormPanel>

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionZones}" />
			<controls:FormPanel ToolTip="{DynamicResource TipZones}">
				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource LabelZoneCount}" />
				<TextBlock Style="{StaticResource FormReadout}" AutomationProperties.AutomationId="PartZoneCount">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Plate}" ConverterParameter="Zones">
							<Binding /><Binding Path="ZoneCount" /><Binding Path="Diameter" /><Binding Path="FocalLength" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>

				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource LabelOuterZone}" />
				<TextBlock Style="{StaticResource FormReadout}" AutomationProperties.AutomationId="PartOuterZone">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource Plate}" ConverterParameter="OuterZone">
							<Binding /><Binding Path="ZoneCount" /><Binding Path="Diameter" /><Binding Path="FocalLength" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
