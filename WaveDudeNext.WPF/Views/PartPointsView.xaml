<UserControl x:Class="WaveDudeNext.WPF.Views.PartPointsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:commands="clr-namespace:WaveDudeNext.WPF.Commands"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<UserControl.CommandBindings>
		<CommandBinding Command="{x:Static commands:PartCommands.AddPoint}" CanExecute="CanAddPoint" Executed="OnAddPoint" />
		<CommandBinding Command="{x:Static commands:PartCommands.RemovePoint}" CanExecute="CanRemovePoint" Executed="OnRemovePoint" />
	</UserControl.CommandBindings>

	<!-- the point list of a polygon outline (the data context is the part): one row per point with X
	     and Y relative to the centre, before rotation, a remove button, and an add button below -->
	<StackPanel>
		<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionPoints}" />
		<TextBlock Margin="0,0,0,4" Foreground="{DynamicResource GrayText}" TextWrapping="Wrap" Text="{Binding HintText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
		<DockPanel Margin="0,0,0,2">
			<Border DockPanel.Dock="Right" Width="22" />
			<UniformGrid Columns="2">
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:PartPoint.X}" Margin="2,0" />
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:PartPoint.Y}" Margin="2,0" />
			</UniformGrid>
		</DockPanel>
		<ItemsControl x:Name="list" ItemsSource="{Binding Points}" Focusable="False">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<DockPanel Margin="0,0,0,4">
						<Button DockPanel.Dock="Right" Style="{StaticResource RemovePointButton}" ToolTip="{DynamicResource TipRemovePoint}" AutomationProperties.Name="{DynamicResource TipRemovePoint}"
						        Command="{x:Static commands:PartCommands.RemovePoint}" CommandParameter="{Binding}" />
						<UniformGrid Columns="2">
							<controls:NumberBox Margin="0,0,2,0" Text="{Binding X}" ToolTip="{DynamicResource Hint.PartPoint.X}" />
							<controls:NumberBox Margin="2,0,0,0" Text="{Binding Y}" ToolTip="{DynamicResource Hint.PartPoint.Y}" />
						</UniformGrid>
					</DockPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
			<Button Padding="8,2" Margin="0,2,6,0" Content="{DynamicResource ButtonAddPoint}" ToolTip="{DynamicResource TipAddPoint}"
			        Command="{x:Static commands:PartCommands.AddPoint}" AutomationProperties.AutomationId="PartAddPoint" />
		</StackPanel>
	</StackPanel>
</UserControl>
