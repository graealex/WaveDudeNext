<UserControl x:Class="WaveDudeNext.WPF.Views.BraggReflectorPartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionLayers}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:BraggReflectorPart.Pairs}" />
				<controls:NumberBox Text="{Binding Pairs}" Minimum="1" Maximum="200" ToolTip="{meta:Hint model:BraggReflectorPart.Pairs}" AutomationProperties.AutomationId="PartPairs" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:BraggReflectorPart.Thickness1}" />
				<controls:NumberBox Text="{Binding Thickness1}" Minimum="1" ToolTip="{meta:Hint model:BraggReflectorPart.Thickness1}" AutomationProperties.AutomationId="PartThickness1" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:BraggReflectorPart.Index1}" />
				<controls:NumberBox Text="{Binding Index1}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip="{meta:Hint model:BraggReflectorPart.Index1}" AutomationProperties.AutomationId="PartIndex1" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:BraggReflectorPart.Thickness2}" />
				<controls:NumberBox Text="{Binding Thickness2}" Minimum="1" ToolTip="{meta:Hint model:BraggReflectorPart.Thickness2}" AutomationProperties.AutomationId="PartThickness2" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:BraggReflectorPart.Index2}" />
				<controls:NumberBox Text="{Binding Index2}" Minimum="1" Maximum="2.55" Increment="0.01" ToolTip="{meta:Hint model:BraggReflectorPart.Index2}" AutomationProperties.AutomationId="PartIndex2" />
			</controls:FormPanel>

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:BraggReflectorPart.Width}" />
				<controls:NumberBox Text="{Binding Width}" Minimum="2" Increment="10" ToolTip="{meta:Hint model:BraggReflectorPart.Width}" AutomationProperties.AutomationId="PartWidth" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
