<UserControl x:Class="WaveDudeNext.WPF.Views.ColorSchemeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:commands="clr-namespace:WaveDudeNext.WPF.Commands"
             xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:rendering="clr-namespace:WaveDudeNext.Rendering;assembly=WaveDudeNext">

	<UserControl.Resources>
		<converters:ColorSchemeBrushConverter x:Key="ColorSchemeBrush" />
		<converters:RgbBrushConverter x:Key="RgbBrush" />
		<StreamGeometry x:Key="MinusGeometry">M0,4 L8,4</StreamGeometry>
		<!-- the "reduce" step applies to a sampled table only -->
		<Style x:Key="RemoveStopButton" TargetType="{x:Type Button}">
			<Setter Property="Width" Value="18" />
			<Setter Property="Height" Value="18" />
			<Setter Property="Margin" Value="4,0,0,0" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True">
							<Path Data="{StaticResource MinusGeometry}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
							      HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.4" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<UserControl.CommandBindings>
		<CommandBinding Command="{x:Static commands:ColorSchemeCommands.AddStop}" CanExecute="CanAddStop" Executed="OnAddStop" />
		<CommandBinding Command="{x:Static commands:ColorSchemeCommands.RemoveStop}" CanExecute="CanRemoveStop" Executed="OnRemoveStop" />
	</UserControl.CommandBindings>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionGeneral}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label rendering:ColorScheme.Name}" />
				<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{meta:Hint rendering:ColorScheme.Name}"
				         AutomationProperties.AutomationId="SchemeName" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label rendering:ColorScheme.Kind}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues rendering:ColorSchemeKind}"
				          SelectedItem="{Binding Kind}" ToolTip="{meta:Hint rendering:ColorScheme.Kind}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label rendering:ColorScheme.Description}" />
				<TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False"
				         ToolTip="{meta:Hint rendering:ColorScheme.Description}" />
			</controls:FormPanel>

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionStops}" />
			<!-- start from any existing scheme: picking one copies its stops, kind, category and description into this one -->
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource LabelBasedOn}" />
				<ComboBox x:Name="basedOn" ToolTip="{DynamicResource TipBasedOn}" SelectionChanged="OnBasedOnChanged"
				          AutomationProperties.AutomationId="SchemeBasedOn">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<DockPanel Margin="0,0,18,0">
								<Rectangle DockPanel.Dock="Left" Width="56" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" StrokeThickness="0.5"
								           Stroke="{DynamicResource TextBoxBorder}" Fill="{Binding Stops, Converter={StaticResource ColorSchemeBrush}}" />
								<TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
							</DockPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</controls:FormPanel>
			<!-- the whole gradient; the binding to Stops re-evaluates on every edit -->
			<Rectangle Height="18" Margin="0,0,0,6" Stroke="{DynamicResource TextBoxBorder}" StrokeThickness="1"
			           Fill="{Binding Stops, Converter={StaticResource ColorSchemeBrush}}" AutomationProperties.AutomationId="SchemeGradient" />

			<!-- one row per stop: position (0..1), swatch (the picker), colour as #RRGGBB, remove -->
			<ItemsControl ItemsSource="{Binding Stops}" Focusable="False">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<DockPanel Margin="0,0,0,4">
							<Button DockPanel.Dock="Right" Style="{StaticResource RemoveStopButton}" ToolTip="{DynamicResource TipRemoveStop}"
							        Command="{x:Static commands:ColorSchemeCommands.RemoveStop}" CommandParameter="{Binding}" />
							<controls:NumberBox DockPanel.Dock="Left" Width="64" Minimum="0" Maximum="1" Increment="0.01" Text="{Binding Position}"
							                    ToolTip="{DynamicResource TipStopPosition}" />
							<!-- the swatch opens the colour picker (Space, Enter, Down); ids carry the stop's position -->
							<controls:ColorPickerButton DockPanel.Dock="Left" Margin="4,0" Color="{Binding Color}" ToolTip="{DynamicResource TipStopSwatch}"
							                            AutomationProperties.AutomationId="{Binding Position, StringFormat='StopSwatch:{0}'}" />
							<TextBox Text="{Binding Color}" ToolTip="{DynamicResource TipStopColor}"
							         AutomationProperties.AutomationId="{Binding Position, StringFormat='StopColor:{0}'}" />
						</DockPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<StackPanel Orientation="Horizontal">
				<Button Padding="8,2" Margin="0,2,6,0" Content="{DynamicResource ButtonAddStop}" ToolTip="{DynamicResource TipAddStop}"
				        Command="{x:Static commands:ColorSchemeCommands.AddStop}" AutomationProperties.AutomationId="SchemeAddStop" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
