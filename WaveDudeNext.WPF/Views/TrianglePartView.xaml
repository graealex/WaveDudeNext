<UserControl x:Class="WaveDudeNext.WPF.Views.TrianglePartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:views="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<UserControl.Resources>
		<converters:TriangleApexConverter x:Key="ApexAngle" />
		<!-- the presets fix the angles: A is typed for the isosceles and custom types, B for custom only -->
		<Style x:Key="AngleABox" TargetType="{x:Type controls:NumberBox}" BasedOn="{StaticResource {x:Type controls:NumberBox}}">
			<Setter Property="IsEnabled" Value="False" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Type}" Value="Isosceles">
					<Setter Property="IsEnabled" Value="True" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Type}" Value="Custom">
					<Setter Property="IsEnabled" Value="True" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="AngleBBox" TargetType="{x:Type controls:NumberBox}" BasedOn="{StaticResource {x:Type controls:NumberBox}}">
			<Setter Property="IsEnabled" Value="False" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Type}" Value="Custom">
					<Setter Property="IsEnabled" Value="True" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<views:PartCommonView />
			<views:ShapeMaterialView />

			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionShape}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:TrianglePart.Type}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:TriangleType}"
				          SelectedItem="{Binding Type}" ToolTip="{meta:Hint model:TrianglePart.Type}" AutomationProperties.AutomationId="PartTriangleType" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:TrianglePart.Base}" />
				<controls:NumberBox Text="{Binding Base}" Minimum="2" Increment="10" ToolTip="{meta:Hint model:TrianglePart.Base}" AutomationProperties.AutomationId="PartBase" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:TrianglePart.AngleA}" />
				<controls:NumberBox Style="{StaticResource AngleABox}" Text="{Binding AngleA}" Minimum="1" Maximum="178" ToolTip="{meta:Hint model:TrianglePart.AngleA}" AutomationProperties.AutomationId="PartAngleA" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:TrianglePart.AngleB}" />
				<controls:NumberBox Style="{StaticResource AngleBBox}" Text="{Binding AngleB}" Minimum="1" Maximum="178" ToolTip="{meta:Hint model:TrianglePart.AngleB}" AutomationProperties.AutomationId="PartAngleB" />

				<!-- read-only: what the two base angles leave for the apex -->
				<TextBlock Style="{StaticResource FormLabel}" Text="{DynamicResource LabelApexAngle}" />
				<TextBlock VerticalAlignment="Center" ToolTip="{DynamicResource TipApexAngle}" AutomationProperties.AutomationId="PartApexAngle">
					<TextBlock.Text>
						<MultiBinding Converter="{StaticResource ApexAngle}">
							<Binding Path="Type" />
							<Binding Path="AngleA" />
							<Binding Path="AngleB" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
