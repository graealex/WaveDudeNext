<UserControl x:Class="WaveDudeNext.WPF.Views.FiberPathView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:commands="clr-namespace:WaveDudeNext.WPF.Commands"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<UserControl.CommandBindings>
		<CommandBinding Command="{x:Static commands:PartCommands.AddPoint}" CanExecute="CanAddNode" Executed="OnAddNode" />
		<CommandBinding Command="{x:Static commands:PartCommands.RemovePoint}" CanExecute="CanRemoveNode" Executed="OnRemoveNode" />
	</UserControl.CommandBindings>

	<!-- the node list of a fibre's path (the data context is the part): one block per node with the node's X and Y, the
	     Smooth flag and a remove button on the first row, the in- and out-handle offsets on the rows below (relative to
	     the node, before rotation), and an add button under the list. Inside the template the string keys are referenced
	     directly: a template rejects the resource reference the meta extensions wrap (2026-10-22) -->
	<StackPanel>
		<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionNodes}" />
		<TextBlock Margin="0,0,0,4" Foreground="{DynamicResource GrayText}" TextWrapping="Wrap" Text="{DynamicResource HintFiberNodes}" />
		<Grid Margin="0,0,0,2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="36" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="1" Style="{StaticResource FormLabel}" Text="{meta:Label model:FiberNode.X}" Margin="2,0" />
			<TextBlock Grid.Column="2" Style="{StaticResource FormLabel}" Text="{meta:Label model:FiberNode.Y}" Margin="2,0" />
		</Grid>
		<ItemsControl ItemsSource="{Binding Nodes}" Focusable="False">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Grid Margin="0,0,0,6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="36" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabel}" Text="{DynamicResource LabelNodePoint}" />
						<controls:NumberBox Grid.Row="0" Grid.Column="1" Margin="0,0,2,2" Text="{Binding X}" ToolTip="{DynamicResource Hint.FiberNode.X}" />
						<controls:NumberBox Grid.Row="0" Grid.Column="2" Margin="2,0,0,2" Text="{Binding Y}" ToolTip="{DynamicResource Hint.FiberNode.Y}" />
						<StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
							<!-- the label as a TextBlock child, which also names the box for automation (Content would show the reference, not the text) -->
							<CheckBox Margin="6,0,0,2" VerticalAlignment="Center" IsChecked="{Binding Smooth}" ToolTip="{DynamicResource Hint.FiberNode.Smooth}">
								<TextBlock Text="{DynamicResource Label.FiberNode.Smooth}" />
							</CheckBox>
							<Button Style="{StaticResource RemovePointButton}" ToolTip="{DynamicResource TipRemoveNode}" AutomationProperties.Name="{DynamicResource TipRemoveNode}"
							        Command="{x:Static commands:PartCommands.RemovePoint}" CommandParameter="{Binding}" />
						</StackPanel>
						<TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel}" Text="{DynamicResource LabelNodeIn}" />
						<controls:NumberBox Grid.Row="1" Grid.Column="1" Margin="0,0,2,2" Text="{Binding InX}" ToolTip="{DynamicResource Hint.FiberNode.InX}" />
						<controls:NumberBox Grid.Row="1" Grid.Column="2" Margin="2,0,0,2" Text="{Binding InY}" ToolTip="{DynamicResource Hint.FiberNode.InY}" />
						<TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabel}" Text="{DynamicResource LabelNodeOut}" />
						<controls:NumberBox Grid.Row="2" Grid.Column="1" Margin="0,0,2,0" Text="{Binding OutX}" ToolTip="{DynamicResource Hint.FiberNode.OutX}" />
						<controls:NumberBox Grid.Row="2" Grid.Column="2" Margin="2,0,0,0" Text="{Binding OutY}" ToolTip="{DynamicResource Hint.FiberNode.OutY}" />
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
			<Button Padding="8,2" Margin="0,2,6,0" Content="{DynamicResource ButtonAddNode}" ToolTip="{DynamicResource TipAddNode}"
			        Command="{x:Static commands:PartCommands.AddPoint}" AutomationProperties.AutomationId="PartAddNode" />
		</StackPanel>
	</StackPanel>
</UserControl>
