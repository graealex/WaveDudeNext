<UserControl x:Class="WaveDudeNext.WPF.Panes.ProjectTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WaveDudeNext.WPF.Panes"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:commands="clr-namespace:WaveDudeNext.WPF.Commands"
             xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext"
             xmlns:rendering="clr-namespace:WaveDudeNext.Rendering;assembly=WaveDudeNext">

	<UserControl.Resources>
		<converters:EnumerateConverter x:Key="Enumerate" />
		<converters:NamedCollectionConverter x:Key="NamedCollections" />
		<converters:ColorSchemeBrushConverter x:Key="ColorSchemeBrush" />
		<converters:TreeIdConverter x:Key="TreeId" />
		<converters:IsTypeConverter x:Key="IsType" />
		<converters:PartIconConverter x:Key="PartIcon" />

		<StreamGeometry x:Key="PlusGeometry">M4,0 L4,8 M0,4 L8,4</StreamGeometry>
		<StreamGeometry x:Key="MinusGeometry">M0,4 L8,4</StreamGeometry>
		<StreamGeometry x:Key="ChevronUpGeometry">M0,6 L4,2 L8,6</StreamGeometry>
		<StreamGeometry x:Key="ChevronDownGeometry">M0,2 L4,6 L8,2</StreamGeometry>

		<!-- stroked-glyph button for the rows (out of the Tab cycle: the toolbar and the context menu do the same) and,
		     through ToolGlyphButton, for the toolbar; Content is the geometry -->
		<Style x:Key="GlyphButton" TargetType="{x:Type Button}">
			<Setter Property="Width" Value="18" />
			<Setter Property="Height" Value="18" />
			<Setter Property="Margin" Value="1,0" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
							<Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
							      HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
								<Setter Property="Opacity" Value="0.5" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- the toolbar's buttons are in the Tab cycle (2026-10-15, the keyboard-first rule) -->
		<Style x:Key="ToolGlyphButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GlyphButton}">
			<Setter Property="Focusable" Value="True" />
			<Setter Property="IsTabStop" Value="True" />
		</Style>
		<Style x:Key="TextButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="MinHeight" Value="20" />
			<Setter Property="Margin" Value="1,0" />
		</Style>
		<!-- the part entries, the optics first and the plain shapes after a separator, in one place for both menus that offer
		     them (the menu of kinds and the tree rows' Add part): each entry adds its kind, the class as the parameter. Not
		     shared, so every menu that lists them gets its own entries (added to its items by ProjectTree.MenuEntries) -->
		<x:Array x:Key="PartMenuEntries" x:Shared="False" Type="{x:Type FrameworkElement}">
			<MenuItem Header="{DynamicResource MenuAddLens}" controls:MenuIcon.Drawing="Lens" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:LensPart}" AutomationProperties.AutomationId="AddPart:Lens" />
			<MenuItem Header="{DynamicResource MenuAddFiber}" controls:MenuIcon.Drawing="Fiber" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:FiberPart}" AutomationProperties.AutomationId="AddPart:Fiber" />
			<MenuItem Header="{DynamicResource MenuAddBraggReflector}" controls:MenuIcon.Drawing="BraggReflector" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:BraggReflectorPart}" AutomationProperties.AutomationId="AddPart:BraggReflector" />
			<MenuItem Header="{DynamicResource MenuAddGrinLens}" controls:MenuIcon.Drawing="GrinLens" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:GrinLensPart}" AutomationProperties.AutomationId="AddPart:GrinLens" />
			<MenuItem Header="{DynamicResource MenuAddZonePlate}" controls:MenuIcon.Drawing="ZonePlate" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:ZonePlatePart}" AutomationProperties.AutomationId="AddPart:ZonePlate" />
			<Separator />
			<MenuItem Header="{DynamicResource MenuAddPolygon}" controls:MenuIcon.Drawing="Polygon" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:PolygonPart}" AutomationProperties.AutomationId="AddPart:Polygon" />
			<MenuItem Header="{DynamicResource MenuAddRectangle}" controls:MenuIcon.Drawing="Rectangle" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:RectanglePart}" AutomationProperties.AutomationId="AddPart:Rectangle" />
			<MenuItem Header="{DynamicResource MenuAddEllipse}" controls:MenuIcon.Drawing="Ellipse" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:EllipsePart}" AutomationProperties.AutomationId="AddPart:Ellipse" />
			<MenuItem Header="{DynamicResource MenuAddTriangle}" controls:MenuIcon.Drawing="Triangle" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:TrianglePart}" AutomationProperties.AutomationId="AddPart:Triangle" />
			<MenuItem Header="{DynamicResource MenuAddOutline}" controls:MenuIcon.Drawing="Outline" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:OutlinePart}" AutomationProperties.AutomationId="AddPart:Outline" />
			<Separator />
			<!-- optical logic: one entry per gate (2026-10-21 and 22, the user's requests: XOR, then AND and OR) -->
			<MenuItem Header="{DynamicResource MenuAddOpticalLogic}" controls:MenuIcon.Drawing="OpticalLogic" AutomationProperties.AutomationId="AddPart:OpticalLogic">
				<MenuItem Header="{DynamicResource MenuAddXorGate}" controls:MenuIcon.Drawing="XorGate" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:XorGatePart}" AutomationProperties.AutomationId="AddPart:XorGate" />
				<MenuItem Header="{DynamicResource MenuAddAndGate}" controls:MenuIcon.Drawing="AndGate" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:AndGatePart}" AutomationProperties.AutomationId="AddPart:AndGate" />
				<MenuItem Header="{DynamicResource MenuAddOrGate}" controls:MenuIcon.Drawing="OrGate" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Type model:OrGatePart}" AutomationProperties.AutomationId="AddPart:OrGate" />
			</MenuItem>
		</x:Array>
		<!-- the menu of part kinds: the "+ Part" button and the Parts folder's plus open it (AddPart without a parameter opens
		     the invoking element's context menu). One instance per button -->
		<ContextMenu x:Key="PartKindMenu" x:Shared="False" local:ProjectTree.MenuEntries="{StaticResource PartMenuEntries}">
			<ContextMenu.Resources>
				<Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
					<Setter Property="CommandTarget" Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
				</Style>
			</ContextMenu.Resources>
		</ContextMenu>
	</UserControl.Resources>

	<DockPanel>

		<!-- pane toolbar: acts on the tree selection -->
		<Border DockPanel.Dock="Top" BorderBrush="{DynamicResource ToolWindowBorder}" BorderThickness="0,0,0,1" Padding="2,2">
			<StackPanel Orientation="Horizontal">
				<Button Style="{StaticResource TextButton}" Content="{DynamicResource ToolAddSource}" ToolTip="{DynamicResource TipAddSource}" AutomationProperties.Name="{DynamicResource TipAddSource}"
				        Command="{x:Static commands:ProjectCommands.AddSource}" AutomationProperties.AutomationId="ToolAddSource" />
				<Button Style="{StaticResource TextButton}" Content="{DynamicResource ToolAddPart}" ToolTip="{DynamicResource TipAddPart}" AutomationProperties.Name="{DynamicResource TipAddPart}"
				        Command="{x:Static commands:ProjectCommands.AddPart}" ContextMenu="{StaticResource PartKindMenu}" AutomationProperties.AutomationId="ToolAddPart" />
				<Button Style="{StaticResource TextButton}" Content="{DynamicResource ToolAddProbe}" ToolTip="{DynamicResource TipAddProbe}" AutomationProperties.Name="{DynamicResource TipAddProbe}"
				        Command="{x:Static commands:ProjectCommands.AddProbe}" AutomationProperties.AutomationId="ToolAddProbe" />
				<Rectangle Width="1" Margin="4,2" Fill="{DynamicResource ToolWindowBorder}" />
				<Button Style="{StaticResource ToolGlyphButton}" Content="{StaticResource ChevronUpGeometry}" ToolTip="{DynamicResource TipMoveUp}" AutomationProperties.Name="{DynamicResource TipMoveUp}"
				        Command="{x:Static commands:ProjectCommands.MoveUp}" AutomationProperties.AutomationId="ToolMoveUp" />
				<Button Style="{StaticResource ToolGlyphButton}" Content="{StaticResource ChevronDownGeometry}" ToolTip="{DynamicResource TipMoveDown}" AutomationProperties.Name="{DynamicResource TipMoveDown}"
				        Command="{x:Static commands:ProjectCommands.MoveDown}" AutomationProperties.AutomationId="ToolMoveDown" />
				<Button Style="{StaticResource ToolGlyphButton}" Content="{StaticResource MinusGeometry}" ToolTip="{DynamicResource TipRemove}" AutomationProperties.Name="{DynamicResource TipRemove}"
				        Command="{x:Static commands:ProjectCommands.Remove}" AutomationProperties.AutomationId="ToolRemove" />
			</StackPanel>
		</Border>

		<!-- the root object is wrapped in a one-element list so it shows as the top node -->
		<TreeView x:Name="tree" AllowDrop="True"
		          ItemsSource="{Binding Project, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectTree}}, Converter={StaticResource Enumerate}}"
		          SelectedItemChanged="OnSelectedItemChanged"
		          PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown" PreviewMouseMove="OnPreviewMouseMove"
		          DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

			<!-- keys act on the selection; only while the tree has focus. Insert and Ctrl+Space put the row into the selection or
			     take it out, Ctrl+A selects every item (2026-10-19); Shift with the arrows extends a range through the TreeView's own
			     selection change (the code-behind) -->
			<TreeView.InputBindings>
				<KeyBinding Key="Delete" Command="{x:Static commands:ProjectCommands.Remove}" />
				<KeyBinding Key="Space" Command="{x:Static commands:ProjectCommands.ToggleEnabled}" />
				<KeyBinding Key="Insert" Command="{x:Static commands:ProjectCommands.ToggleSelected}" />
				<KeyBinding Key="Space" Modifiers="Ctrl" Command="{x:Static commands:ProjectCommands.ToggleSelected}" />
				<KeyBinding Key="A" Modifiers="Ctrl" Command="{x:Static commands:ProjectCommands.SelectAll}" />
				<KeyBinding Key="D" Modifiers="Ctrl" Command="{x:Static commands:ProjectCommands.Duplicate}" />
				<KeyBinding Key="Up" Modifiers="Alt" Command="{x:Static commands:ProjectCommands.MoveUp}" />
				<KeyBinding Key="Down" Modifiers="Alt" Command="{x:Static commands:ProjectCommands.MoveDown}" />
			</TreeView.InputBindings>

			<TreeView.ItemContainerStyle>
				<Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
					<Setter Property="IsExpanded" Value="True" />
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<!-- "Tree:<name>" so a harness can Tab to a row and act on it -->
					<Setter Property="AutomationProperties.AutomationId" Value="{Binding Converter={StaticResource TreeId}}" />
					<!-- context menu: the node is the data context, the row is the command target -->
					<Setter Property="ContextMenu">
						<Setter.Value>
							<ContextMenu>
								<ContextMenu.Resources>
									<Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
										<Setter Property="CommandTarget" Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
										<Setter Property="CommandParameter" Value="{Binding}" />
									</Style>
								</ContextMenu.Resources>
								<MenuItem Header="{DynamicResource MenuProjectAddSource}" Command="{x:Static commands:ProjectCommands.AddSource}" controls:MenuIcon.Glyph="&#xE710;" />
								<MenuItem Header="{DynamicResource MenuProjectAddPart}" local:ProjectTree.MenuEntries="{StaticResource PartMenuEntries}" controls:MenuIcon.Glyph="&#xE710;" />
								<MenuItem Header="{DynamicResource MenuProjectAddProbe}" Command="{x:Static commands:ProjectCommands.AddProbe}" controls:MenuIcon.Glyph="&#xE710;" />
								<Separator />
								<MenuItem Header="{DynamicResource MenuProjectToggleSelected}" controls:MenuIcon.Glyph="&#xE762;" Command="{x:Static commands:ProjectCommands.ToggleSelected}" InputGestureText="Ins" AutomationProperties.AutomationId="ContextToggleSelected" />
								<MenuItem Header="{DynamicResource MenuProjectSelectAll}" Command="{x:Static commands:ProjectCommands.SelectAll}" InputGestureText="Ctrl+A" AutomationProperties.AutomationId="ContextSelectAll" controls:MenuIcon.Glyph="&#xE8B3;" />
								<Separator />
								<MenuItem Header="{DynamicResource MenuProjectToggleEnabled}" Command="{x:Static commands:ProjectCommands.ToggleEnabled}" InputGestureText="Space" controls:MenuIcon.Glyph="&#xE73A;" />
								<MenuItem Header="{DynamicResource MenuProjectDuplicate}" Command="{x:Static commands:ProjectCommands.Duplicate}" InputGestureText="Ctrl+D" controls:MenuIcon.Glyph="&#xF413;" />
								<MenuItem Header="{DynamicResource MenuEditCut}" controls:MenuIcon.Glyph="&#xE8C6;" Command="ApplicationCommands.Cut" />
								<MenuItem Header="{DynamicResource MenuEditCopy}" controls:MenuIcon.Glyph="&#xE8C8;" Command="ApplicationCommands.Copy" />
								<MenuItem Header="{DynamicResource MenuEditPaste}" controls:MenuIcon.Glyph="&#xE77F;" Command="ApplicationCommands.Paste" />
								<MenuItem Header="{DynamicResource MenuProjectRemove}" Command="{x:Static commands:ProjectCommands.Remove}" InputGestureText="Del" controls:MenuIcon.Glyph="&#xE738;" />
								<Separator />
								<MenuItem Header="{DynamicResource MenuProjectMoveUp}" Command="{x:Static commands:ProjectCommands.MoveUp}" InputGestureText="Alt+Up" controls:MenuIcon.Glyph="&#xE74A;" />
								<MenuItem Header="{DynamicResource MenuProjectMoveDown}" Command="{x:Static commands:ProjectCommands.MoveDown}" InputGestureText="Alt+Down" controls:MenuIcon.Glyph="&#xE74B;" />
								<!-- a probe's recording as CSV (2026-10-18): only a probe node shows the entry -->
								<Separator Visibility="{Binding Converter={StaticResource IsType}, ConverterParameter={x:Type model:Probe}}" />
								<MenuItem Header="{DynamicResource MenuExportProbeCsv}" Command="{x:Static commands:ExportCommands.ProbeCsv}" AutomationProperties.AutomationId="ContextExportProbeCsv"
								          Visibility="{Binding Converter={StaticResource IsType}, ConverterParameter={x:Type model:Probe}}" controls:MenuIcon.Glyph="&#xEDE1;" />
							</ContextMenu>
						</Setter.Value>
					</Setter>
					<Style.Triggers>
						<!-- a row in the selection beside the current one: the inactive-selection colours; the TreeView's own
						     selection (the current row) is drawn by the template's trigger and wins. The status tells a harness -->
						<Trigger Property="local:ProjectTree.IsInSelection" Value="True">
							<Setter Property="Background" Value="{DynamicResource TreeViewItemSelectedInactive}" />
							<Setter Property="Foreground" Value="{DynamicResource TreeViewItemSelectedInactiveForeground}" />
							<Setter Property="AutomationProperties.ItemStatus" Value="InSelection" />
						</Trigger>
					</Style.Triggers>
				</Style>
			</TreeView.ItemContainerStyle>

			<TreeView.Resources>
				<!-- one template per model type; children come from the bound properties, lists become folders -->
				<HierarchicalDataTemplate DataType="{x:Type model:Project}">
					<HierarchicalDataTemplate.ItemsSource>
						<MultiBinding Converter="{StaticResource NamedCollections}" ConverterParameter=",,,TreeSources,TreeParts,TreeProbes,TreeColorSchemes">
							<Binding Path="Scene" />
							<Binding Path="Simulation" />
							<Binding Path="Display" />
							<Binding Path="Sources" />
							<Binding Path="Parts" />
							<Binding Path="Probes" />
							<Binding Path="ColorSchemes" />
						</MultiBinding>
					</HierarchicalDataTemplate.ItemsSource>
					<StackPanel Orientation="Horizontal">
						<controls:IconView Drawing="Project" Margin="0,0,4,0" VerticalAlignment="Center" />
						<TextBlock Text="{DynamicResource TreeProject}" VerticalAlignment="Center" />
					</StackPanel>
				</HierarchicalDataTemplate>

				<DataTemplate DataType="{x:Type model:Scene}">
					<StackPanel Orientation="Horizontal">
						<controls:IconView Glyph="&#xEB9F;" Margin="0,0,4,0" VerticalAlignment="Center" />
						<TextBlock Text="{DynamicResource TreeScene}" VerticalAlignment="Center" />
					</StackPanel>
				</DataTemplate>
				<DataTemplate DataType="{x:Type model:Simulation}">
					<StackPanel Orientation="Horizontal">
						<controls:IconView Glyph="&#xE916;" Margin="0,0,4,0" VerticalAlignment="Center" />
						<TextBlock Text="{DynamicResource TreeSimulation}" VerticalAlignment="Center" />
					</StackPanel>
				</DataTemplate>
				<DataTemplate DataType="{x:Type model:Display}">
					<StackPanel Orientation="Horizontal">
						<controls:IconView Glyph="&#xE7F4;" Margin="0,0,4,0" VerticalAlignment="Center" />
						<TextBlock Text="{DynamicResource TreeDisplay}" VerticalAlignment="Center" />
					</StackPanel>
				</DataTemplate>

				<!-- folder row: name and an add button; the Parts folder's button carries the menu of kinds, which Add opens -->
				<HierarchicalDataTemplate DataType="{x:Type converters:NamedCollection}" ItemsSource="{Binding Items}">
					<DockPanel>
						<Button DockPanel.Dock="Right" Content="{StaticResource PlusGeometry}"
						        ToolTip="{DynamicResource TipAdd}" AutomationProperties.Name="{DynamicResource TipAdd}" Command="{x:Static commands:ProjectCommands.Add}" CommandParameter="{Binding}">
							<Button.Style>
								<Style TargetType="{x:Type Button}" BasedOn="{StaticResource GlyphButton}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Key}" Value="TreeParts">
											<Setter Property="ContextMenu" Value="{StaticResource PartKindMenu}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
						</Button>
						<!-- the folder shows the icon of what it holds: the handle glyphs, the palette for schemes -->
						<controls:IconView DockPanel.Dock="Left" Margin="0,0,4,0" VerticalAlignment="Center">
							<controls:IconView.Style>
								<Style TargetType="{x:Type controls:IconView}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Key}" Value="TreeSources">
											<Setter Property="Drawing" Value="Source" />
										</DataTrigger>
										<DataTrigger Binding="{Binding Key}" Value="TreeParts">
											<Setter Property="Drawing" Value="Part" />
										</DataTrigger>
										<DataTrigger Binding="{Binding Key}" Value="TreeProbes">
											<Setter Property="Drawing" Value="Probe" />
										</DataTrigger>
										<DataTrigger Binding="{Binding Key}" Value="TreeColorSchemes">
											<Setter Property="Glyph" Value="&#xE790;" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</controls:IconView.Style>
						</controls:IconView>
						<TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
					</DockPanel>
				</HierarchicalDataTemplate>

				<!-- item rows: name, move up/down and remove -->
				<DataTemplate DataType="{x:Type model:Source}">
					<DockPanel>
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource MinusGeometry}"
						        ToolTip="{DynamicResource TipRemove}" AutomationProperties.Name="{DynamicResource TipRemove}" Command="{x:Static commands:ProjectCommands.Remove}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronDownGeometry}"
						        ToolTip="{DynamicResource TipMoveDown}" AutomationProperties.Name="{DynamicResource TipMoveDown}" Command="{x:Static commands:ProjectCommands.MoveDown}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronUpGeometry}"
						        ToolTip="{DynamicResource TipMoveUp}" AutomationProperties.Name="{DynamicResource TipMoveUp}" Command="{x:Static commands:ProjectCommands.MoveUp}" CommandParameter="{Binding}" />
						<!-- the enabled check box (Space on the selected row toggles it too); the name greys out when off -->
						<CheckBox DockPanel.Dock="Left" Focusable="False" IsTabStop="False" MinHeight="0" Margin="0,0,4,0" VerticalAlignment="Center"
						          IsChecked="{Binding Enabled}" ToolTip="{DynamicResource TipSourceEnabled}"
						          AutomationProperties.Name="{DynamicResource TipSourceEnabled}" AutomationProperties.AutomationId="{Binding Name, StringFormat='Enabled:{0}'}" />
						<controls:IconView DockPanel.Dock="Left" Drawing="Source" Margin="0,0,4,0" VerticalAlignment="Center">
							<controls:IconView.Style>
								<Style TargetType="{x:Type controls:IconView}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Enabled}" Value="False">
											<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</controls:IconView.Style>
						</controls:IconView>
						<TextBlock Text="{Binding Name}" VerticalAlignment="Center">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Enabled}" Value="False">
											<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</DockPanel>
				</DataTemplate>
				<!-- an optical part: like a source, the enabled check box, the name, move and remove -->
				<DataTemplate DataType="{x:Type model:OpticalPart}">
					<DockPanel>
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource MinusGeometry}"
						        ToolTip="{DynamicResource TipRemove}" AutomationProperties.Name="{DynamicResource TipRemove}" Command="{x:Static commands:ProjectCommands.Remove}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronDownGeometry}"
						        ToolTip="{DynamicResource TipMoveDown}" AutomationProperties.Name="{DynamicResource TipMoveDown}" Command="{x:Static commands:ProjectCommands.MoveDown}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronUpGeometry}"
						        ToolTip="{DynamicResource TipMoveUp}" AutomationProperties.Name="{DynamicResource TipMoveUp}" Command="{x:Static commands:ProjectCommands.MoveUp}" CommandParameter="{Binding}" />
						<CheckBox DockPanel.Dock="Left" Focusable="False" IsTabStop="False" MinHeight="0" Margin="0,0,4,0" VerticalAlignment="Center"
						          IsChecked="{Binding Enabled}" ToolTip="{DynamicResource TipPartEnabled}"
						          AutomationProperties.Name="{DynamicResource TipPartEnabled}" AutomationProperties.AutomationId="{Binding Name, StringFormat='Enabled:{0}'}" />
						<controls:IconView DockPanel.Dock="Left" Drawing="{Binding Converter={StaticResource PartIcon}}" Margin="0,0,4,0" VerticalAlignment="Center">
							<controls:IconView.Style>
								<Style TargetType="{x:Type controls:IconView}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Enabled}" Value="False">
											<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</controls:IconView.Style>
						</controls:IconView>
						<TextBlock Text="{Binding Name}" VerticalAlignment="Center">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Enabled}" Value="False">
											<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</DockPanel>
				</DataTemplate>
				<!-- a project colour scheme: its gradient and name -->
				<DataTemplate DataType="{x:Type rendering:ColorScheme}">
					<DockPanel>
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource MinusGeometry}"
						        ToolTip="{DynamicResource TipRemove}" AutomationProperties.Name="{DynamicResource TipRemove}" Command="{x:Static commands:ProjectCommands.Remove}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronDownGeometry}"
						        ToolTip="{DynamicResource TipMoveDown}" AutomationProperties.Name="{DynamicResource TipMoveDown}" Command="{x:Static commands:ProjectCommands.MoveDown}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronUpGeometry}"
						        ToolTip="{DynamicResource TipMoveUp}" AutomationProperties.Name="{DynamicResource TipMoveUp}" Command="{x:Static commands:ProjectCommands.MoveUp}" CommandParameter="{Binding}" />
						<Rectangle DockPanel.Dock="Left" Width="36" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" StrokeThickness="0.5"
						           Stroke="{DynamicResource TextBoxBorder}" Fill="{Binding Stops, Converter={StaticResource ColorSchemeBrush}}" />
						<TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
					</DockPanel>
				</DataTemplate>
				<DataTemplate DataType="{x:Type model:Probe}">
					<DockPanel>
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource MinusGeometry}"
						        ToolTip="{DynamicResource TipRemove}" AutomationProperties.Name="{DynamicResource TipRemove}" Command="{x:Static commands:ProjectCommands.Remove}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronDownGeometry}"
						        ToolTip="{DynamicResource TipMoveDown}" AutomationProperties.Name="{DynamicResource TipMoveDown}" Command="{x:Static commands:ProjectCommands.MoveDown}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronUpGeometry}"
						        ToolTip="{DynamicResource TipMoveUp}" AutomationProperties.Name="{DynamicResource TipMoveUp}" Command="{x:Static commands:ProjectCommands.MoveUp}" CommandParameter="{Binding}" />
						<!-- the enabled check box (Space on the selected row toggles it too); the name greys out when off -->
						<CheckBox DockPanel.Dock="Left" Focusable="False" IsTabStop="False" MinHeight="0" Margin="0,0,4,0" VerticalAlignment="Center"
						          IsChecked="{Binding Active}" ToolTip="{DynamicResource TipProbeActive}"
						          AutomationProperties.Name="{DynamicResource TipProbeActive}" AutomationProperties.AutomationId="{Binding Name, StringFormat='Enabled:{0}'}" />
						<controls:IconView DockPanel.Dock="Left" Drawing="Probe" Margin="0,0,4,0" VerticalAlignment="Center">
							<controls:IconView.Style>
								<Style TargetType="{x:Type controls:IconView}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Active}" Value="False">
											<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</controls:IconView.Style>
						</controls:IconView>
						<TextBlock Text="{Binding Name}" VerticalAlignment="Center">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Active}" Value="False">
											<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</DockPanel>
				</DataTemplate>
			</TreeView.Resources>
		</TreeView>
	</DockPanel>
</UserControl>
