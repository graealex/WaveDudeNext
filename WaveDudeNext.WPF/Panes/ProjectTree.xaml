<UserControl x:Class="WaveDudeNext.WPF.Panes.ProjectTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WaveDudeNext.WPF.Panes"
             xmlns:commands="clr-namespace:WaveDudeNext.WPF.Commands"
             xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext"
             xmlns:rendering="clr-namespace:WaveDudeNext.Rendering;assembly=WaveDudeNext">

	<UserControl.Resources>
		<converters:EnumerateConverter x:Key="Enumerate" />
		<converters:NamedCollectionConverter x:Key="NamedCollections" />
		<converters:ColorSchemeBrushConverter x:Key="ColorSchemeBrush" />
		<converters:TreeIdConverter x:Key="TreeId" />
		<converters:IsTypeConverter x:Key="IsType" />

		<StreamGeometry x:Key="PlusGeometry">M4,0 L4,8 M0,4 L8,4</StreamGeometry>
		<StreamGeometry x:Key="MinusGeometry">M0,4 L8,4</StreamGeometry>
		<StreamGeometry x:Key="ChevronUpGeometry">M0,6 L4,2 L8,6</StreamGeometry>
		<StreamGeometry x:Key="ChevronDownGeometry">M0,2 L4,6 L8,2</StreamGeometry>

		<!-- stroked-glyph button for the rows (out of the Tab cycle: the toolbar and the context menu do the same) and,
		     through ToolGlyphButton, for the toolbar; Content is the geometry -->
		<Style x:Key="GlyphButton" TargetType="{x:Type Button}">
			<Setter Property="Width" Value="18" />
			<Setter Property="Height" Value="18" />
			<Setter Property="Margin" Value="1,0" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
							<Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
							      HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
								<Setter Property="Opacity" Value="0.5" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- the toolbar's buttons are in the Tab cycle (2026-10-15, the keyboard-first rule) -->
		<Style x:Key="ToolGlyphButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GlyphButton}">
			<Setter Property="Focusable" Value="True" />
			<Setter Property="IsTabStop" Value="True" />
		</Style>
		<Style x:Key="TextButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="MinHeight" Value="20" />
			<Setter Property="Margin" Value="1,0" />
		</Style>
		<!-- the menu of part kinds, the optics first and the plain shapes after a separator: the "+ Part" button and the Parts
		     folder's plus open it (AddPart without a parameter opens the invoking element's context menu; each entry adds its
		     kind). One instance per button -->
		<ContextMenu x:Key="PartKindMenu" x:Shared="False">
			<ContextMenu.Resources>
				<Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
					<Setter Property="CommandTarget" Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
				</Style>
			</ContextMenu.Resources>
			<MenuItem Header="{DynamicResource MenuAddLens}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.Lens}" AutomationProperties.AutomationId="AddPart:Lens" />
			<MenuItem Header="{DynamicResource MenuAddFiber}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.Fiber}" AutomationProperties.AutomationId="AddPart:Fiber" />
			<MenuItem Header="{DynamicResource MenuAddBraggReflector}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.BraggReflector}" AutomationProperties.AutomationId="AddPart:BraggReflector" />
			<MenuItem Header="{DynamicResource MenuAddGrinLens}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.GrinLens}" AutomationProperties.AutomationId="AddPart:GrinLens" />
			<Separator />
			<MenuItem Header="{DynamicResource MenuAddPolygon}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.Polygon}" AutomationProperties.AutomationId="AddPart:Polygon" />
			<MenuItem Header="{DynamicResource MenuAddRectangle}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.Rectangle}" AutomationProperties.AutomationId="AddPart:Rectangle" />
			<MenuItem Header="{DynamicResource MenuAddTriangle}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.Triangle}" AutomationProperties.AutomationId="AddPart:Triangle" />
			<MenuItem Header="{DynamicResource MenuAddOutline}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.Outline}" AutomationProperties.AutomationId="AddPart:Outline" />
		</ContextMenu>
	</UserControl.Resources>

	<DockPanel>

		<!-- pane toolbar: acts on the tree selection -->
		<Border DockPanel.Dock="Top" BorderBrush="{DynamicResource ToolWindowBorder}" BorderThickness="0,0,0,1" Padding="2,2">
			<StackPanel Orientation="Horizontal">
				<Button Style="{StaticResource TextButton}" Content="{DynamicResource ToolAddSource}" ToolTip="{DynamicResource TipAddSource}" AutomationProperties.Name="{DynamicResource TipAddSource}"
				        Command="{x:Static commands:ProjectCommands.AddSource}" AutomationProperties.AutomationId="ToolAddSource" />
				<Button Style="{StaticResource TextButton}" Content="{DynamicResource ToolAddPart}" ToolTip="{DynamicResource TipAddPart}" AutomationProperties.Name="{DynamicResource TipAddPart}"
				        Command="{x:Static commands:ProjectCommands.AddPart}" ContextMenu="{StaticResource PartKindMenu}" AutomationProperties.AutomationId="ToolAddPart" />
				<Button Style="{StaticResource TextButton}" Content="{DynamicResource ToolAddProbe}" ToolTip="{DynamicResource TipAddProbe}" AutomationProperties.Name="{DynamicResource TipAddProbe}"
				        Command="{x:Static commands:ProjectCommands.AddProbe}" AutomationProperties.AutomationId="ToolAddProbe" />
				<Rectangle Width="1" Margin="4,2" Fill="{DynamicResource ToolWindowBorder}" />
				<Button Style="{StaticResource ToolGlyphButton}" Content="{StaticResource ChevronUpGeometry}" ToolTip="{DynamicResource TipMoveUp}" AutomationProperties.Name="{DynamicResource TipMoveUp}"
				        Command="{x:Static commands:ProjectCommands.MoveUp}" AutomationProperties.AutomationId="ToolMoveUp" />
				<Button Style="{StaticResource ToolGlyphButton}" Content="{StaticResource ChevronDownGeometry}" ToolTip="{DynamicResource TipMoveDown}" AutomationProperties.Name="{DynamicResource TipMoveDown}"
				        Command="{x:Static commands:ProjectCommands.MoveDown}" AutomationProperties.AutomationId="ToolMoveDown" />
				<Button Style="{StaticResource ToolGlyphButton}" Content="{StaticResource MinusGeometry}" ToolTip="{DynamicResource TipRemove}" AutomationProperties.Name="{DynamicResource TipRemove}"
				        Command="{x:Static commands:ProjectCommands.Remove}" AutomationProperties.AutomationId="ToolRemove" />
			</StackPanel>
		</Border>

		<!-- the root object is wrapped in a one-element list so it shows as the top node -->
		<TreeView x:Name="tree" AllowDrop="True"
		          ItemsSource="{Binding Project, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectTree}}, Converter={StaticResource Enumerate}}"
		          SelectedItemChanged="OnSelectedItemChanged"
		          PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown" PreviewMouseMove="OnPreviewMouseMove"
		          DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

			<!-- keys act on the selection; only while the tree has focus -->
			<TreeView.InputBindings>
				<KeyBinding Key="Delete" Command="{x:Static commands:ProjectCommands.Remove}" />
				<KeyBinding Key="Space" Command="{x:Static commands:ProjectCommands.ToggleEnabled}" />
				<KeyBinding Key="D" Modifiers="Ctrl" Command="{x:Static commands:ProjectCommands.Duplicate}" />
				<KeyBinding Key="Up" Modifiers="Alt" Command="{x:Static commands:ProjectCommands.MoveUp}" />
				<KeyBinding Key="Down" Modifiers="Alt" Command="{x:Static commands:ProjectCommands.MoveDown}" />
			</TreeView.InputBindings>

			<TreeView.ItemContainerStyle>
				<Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
					<Setter Property="IsExpanded" Value="True" />
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<!-- "Tree:<name>" so a harness can Tab to a row and act on it -->
					<Setter Property="AutomationProperties.AutomationId" Value="{Binding Converter={StaticResource TreeId}}" />
					<!-- context menu: the node is the data context, the row is the command target -->
					<Setter Property="ContextMenu">
						<Setter.Value>
							<ContextMenu>
								<ContextMenu.Resources>
									<Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
										<Setter Property="CommandTarget" Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
										<Setter Property="CommandParameter" Value="{Binding}" />
									</Style>
								</ContextMenu.Resources>
								<MenuItem Header="{DynamicResource MenuProjectAddSource}" Command="{x:Static commands:ProjectCommands.AddSource}" />
								<MenuItem Header="{DynamicResource MenuProjectAddPart}">
									<MenuItem Header="{DynamicResource MenuAddLens}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.Lens}" />
									<MenuItem Header="{DynamicResource MenuAddFiber}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.Fiber}" />
									<MenuItem Header="{DynamicResource MenuAddBraggReflector}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.BraggReflector}" />
									<MenuItem Header="{DynamicResource MenuAddGrinLens}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.GrinLens}" />
									<Separator />
									<MenuItem Header="{DynamicResource MenuAddPolygon}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.Polygon}" />
									<MenuItem Header="{DynamicResource MenuAddRectangle}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.Rectangle}" />
									<MenuItem Header="{DynamicResource MenuAddTriangle}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.Triangle}" />
									<MenuItem Header="{DynamicResource MenuAddOutline}" Command="{x:Static commands:ProjectCommands.AddPart}" CommandParameter="{x:Static model:PartKind.Outline}" />
								</MenuItem>
								<MenuItem Header="{DynamicResource MenuProjectAddProbe}" Command="{x:Static commands:ProjectCommands.AddProbe}" />
								<Separator />
								<MenuItem Header="{DynamicResource MenuProjectToggleEnabled}" Command="{x:Static commands:ProjectCommands.ToggleEnabled}" InputGestureText="Space" />
								<MenuItem Header="{DynamicResource MenuProjectDuplicate}" Command="{x:Static commands:ProjectCommands.Duplicate}" InputGestureText="Ctrl+D" />
								<MenuItem Header="{DynamicResource MenuProjectRemove}" Command="{x:Static commands:ProjectCommands.Remove}" InputGestureText="Del" />
								<Separator />
								<MenuItem Header="{DynamicResource MenuProjectMoveUp}" Command="{x:Static commands:ProjectCommands.MoveUp}" InputGestureText="Alt+Up" />
								<MenuItem Header="{DynamicResource MenuProjectMoveDown}" Command="{x:Static commands:ProjectCommands.MoveDown}" InputGestureText="Alt+Down" />
								<!-- a probe's recording as CSV (2026-10-18): only a probe node shows the entry -->
								<Separator Visibility="{Binding Converter={StaticResource IsType}, ConverterParameter={x:Type model:Probe}}" />
								<MenuItem Header="{DynamicResource MenuExportProbeCsv}" Command="{x:Static commands:ExportCommands.ProbeCsv}" AutomationProperties.AutomationId="ContextExportProbeCsv"
								          Visibility="{Binding Converter={StaticResource IsType}, ConverterParameter={x:Type model:Probe}}" />
							</ContextMenu>
						</Setter.Value>
					</Setter>
				</Style>
			</TreeView.ItemContainerStyle>

			<TreeView.Resources>
				<!-- one template per model type; children come from the bound properties, lists become folders -->
				<HierarchicalDataTemplate DataType="{x:Type model:Project}">
					<HierarchicalDataTemplate.ItemsSource>
						<MultiBinding Converter="{StaticResource NamedCollections}" ConverterParameter=",,,TreeSources,TreeParts,TreeProbes,TreeColorSchemes">
							<Binding Path="Scene" />
							<Binding Path="Simulation" />
							<Binding Path="Display" />
							<Binding Path="Sources" />
							<Binding Path="Parts" />
							<Binding Path="Probes" />
							<Binding Path="ColorSchemes" />
						</MultiBinding>
					</HierarchicalDataTemplate.ItemsSource>
					<TextBlock Text="{DynamicResource TreeProject}" />
				</HierarchicalDataTemplate>

				<DataTemplate DataType="{x:Type model:Scene}">
					<TextBlock Text="{DynamicResource TreeScene}" />
				</DataTemplate>
				<DataTemplate DataType="{x:Type model:Simulation}">
					<TextBlock Text="{DynamicResource TreeSimulation}" />
				</DataTemplate>
				<DataTemplate DataType="{x:Type model:Display}">
					<TextBlock Text="{DynamicResource TreeDisplay}" />
				</DataTemplate>

				<!-- folder row: name and an add button; the Parts folder's button carries the menu of kinds, which Add opens -->
				<HierarchicalDataTemplate DataType="{x:Type converters:NamedCollection}" ItemsSource="{Binding Items}">
					<DockPanel>
						<Button DockPanel.Dock="Right" Content="{StaticResource PlusGeometry}"
						        ToolTip="{DynamicResource TipAdd}" AutomationProperties.Name="{DynamicResource TipAdd}" Command="{x:Static commands:ProjectCommands.Add}" CommandParameter="{Binding}">
							<Button.Style>
								<Style TargetType="{x:Type Button}" BasedOn="{StaticResource GlyphButton}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Key}" Value="TreeParts">
											<Setter Property="ContextMenu" Value="{StaticResource PartKindMenu}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
						</Button>
						<TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
					</DockPanel>
				</HierarchicalDataTemplate>

				<!-- item rows: name, move up/down and remove -->
				<DataTemplate DataType="{x:Type model:Source}">
					<DockPanel>
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource MinusGeometry}"
						        ToolTip="{DynamicResource TipRemove}" AutomationProperties.Name="{DynamicResource TipRemove}" Command="{x:Static commands:ProjectCommands.Remove}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronDownGeometry}"
						        ToolTip="{DynamicResource TipMoveDown}" AutomationProperties.Name="{DynamicResource TipMoveDown}" Command="{x:Static commands:ProjectCommands.MoveDown}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronUpGeometry}"
						        ToolTip="{DynamicResource TipMoveUp}" AutomationProperties.Name="{DynamicResource TipMoveUp}" Command="{x:Static commands:ProjectCommands.MoveUp}" CommandParameter="{Binding}" />
						<!-- the enabled check box (Space on the selected row toggles it too); the name greys out when off -->
						<CheckBox DockPanel.Dock="Left" Focusable="False" IsTabStop="False" MinHeight="0" Margin="0,0,4,0" VerticalAlignment="Center"
						          IsChecked="{Binding Enabled}" ToolTip="{DynamicResource TipSourceEnabled}"
						          AutomationProperties.Name="{DynamicResource TipSourceEnabled}" AutomationProperties.AutomationId="{Binding Name, StringFormat='Enabled:{0}'}" />
						<TextBlock Text="{Binding Name}" VerticalAlignment="Center">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Enabled}" Value="False">
											<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</DockPanel>
				</DataTemplate>
				<!-- an optical part: like a source, the enabled check box, the name, move and remove -->
				<DataTemplate DataType="{x:Type model:OpticalPart}">
					<DockPanel>
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource MinusGeometry}"
						        ToolTip="{DynamicResource TipRemove}" AutomationProperties.Name="{DynamicResource TipRemove}" Command="{x:Static commands:ProjectCommands.Remove}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronDownGeometry}"
						        ToolTip="{DynamicResource TipMoveDown}" AutomationProperties.Name="{DynamicResource TipMoveDown}" Command="{x:Static commands:ProjectCommands.MoveDown}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronUpGeometry}"
						        ToolTip="{DynamicResource TipMoveUp}" AutomationProperties.Name="{DynamicResource TipMoveUp}" Command="{x:Static commands:ProjectCommands.MoveUp}" CommandParameter="{Binding}" />
						<CheckBox DockPanel.Dock="Left" Focusable="False" IsTabStop="False" MinHeight="0" Margin="0,0,4,0" VerticalAlignment="Center"
						          IsChecked="{Binding Enabled}" ToolTip="{DynamicResource TipPartEnabled}"
						          AutomationProperties.Name="{DynamicResource TipPartEnabled}" AutomationProperties.AutomationId="{Binding Name, StringFormat='Enabled:{0}'}" />
						<TextBlock Text="{Binding Name}" VerticalAlignment="Center">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Enabled}" Value="False">
											<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</DockPanel>
				</DataTemplate>
				<!-- a project colour scheme: its gradient and name -->
				<DataTemplate DataType="{x:Type rendering:ColorScheme}">
					<DockPanel>
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource MinusGeometry}"
						        ToolTip="{DynamicResource TipRemove}" AutomationProperties.Name="{DynamicResource TipRemove}" Command="{x:Static commands:ProjectCommands.Remove}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronDownGeometry}"
						        ToolTip="{DynamicResource TipMoveDown}" AutomationProperties.Name="{DynamicResource TipMoveDown}" Command="{x:Static commands:ProjectCommands.MoveDown}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronUpGeometry}"
						        ToolTip="{DynamicResource TipMoveUp}" AutomationProperties.Name="{DynamicResource TipMoveUp}" Command="{x:Static commands:ProjectCommands.MoveUp}" CommandParameter="{Binding}" />
						<Rectangle DockPanel.Dock="Left" Width="36" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" StrokeThickness="0.5"
						           Stroke="{DynamicResource TextBoxBorder}" Fill="{Binding Stops, Converter={StaticResource ColorSchemeBrush}}" />
						<TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
					</DockPanel>
				</DataTemplate>
				<DataTemplate DataType="{x:Type model:Probe}">
					<DockPanel>
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource MinusGeometry}"
						        ToolTip="{DynamicResource TipRemove}" AutomationProperties.Name="{DynamicResource TipRemove}" Command="{x:Static commands:ProjectCommands.Remove}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronDownGeometry}"
						        ToolTip="{DynamicResource TipMoveDown}" AutomationProperties.Name="{DynamicResource TipMoveDown}" Command="{x:Static commands:ProjectCommands.MoveDown}" CommandParameter="{Binding}" />
						<Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="{StaticResource ChevronUpGeometry}"
						        ToolTip="{DynamicResource TipMoveUp}" AutomationProperties.Name="{DynamicResource TipMoveUp}" Command="{x:Static commands:ProjectCommands.MoveUp}" CommandParameter="{Binding}" />
						<!-- the enabled check box (Space on the selected row toggles it too); the name greys out when off -->
						<CheckBox DockPanel.Dock="Left" Focusable="False" IsTabStop="False" MinHeight="0" Margin="0,0,4,0" VerticalAlignment="Center"
						          IsChecked="{Binding Active}" ToolTip="{DynamicResource TipProbeActive}"
						          AutomationProperties.Name="{DynamicResource TipProbeActive}" AutomationProperties.AutomationId="{Binding Name, StringFormat='Enabled:{0}'}" />
						<TextBlock Text="{Binding Name}" VerticalAlignment="Center">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Active}" Value="False">
											<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</DockPanel>
				</DataTemplate>
			</TreeView.Resources>
		</TreeView>
	</DockPanel>
</UserControl>
