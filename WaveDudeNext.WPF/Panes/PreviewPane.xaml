<UserControl x:Class="WaveDudeNext.WPF.Panes.PreviewPane" x:Name="pane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WaveDudeNext.WPF.Panes"
             xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:commands="clr-namespace:WaveDudeNext.WPF.Commands"
             Background="{DynamicResource DocumentBackground}" Focusable="True" IsTabStop="False">

	<UserControl.Resources>
		<converters:EnumBooleanConverter x:Key="EnumBoolean" />
		<converters:DoubleTextConverter x:Key="DoubleText" />
		<converters:FrameToStepConverter x:Key="FrameToStep" />
		<converters:NotNullConverter x:Key="NotNull" />

		<!-- "run": a play triangle inside a ring (the author asked for an explicit start button, 2026-10-13) -->
		<StreamGeometry x:Key="RunGeometry">M0,7 A7,7 0 1 1 14,7 A7,7 0 1 1 0,7 Z M1.4,7 A5.6,5.6 0 1 0 12.6,7 A5.6,5.6 0 1 0 1.4,7 Z M5.2,3.5 L10.8,7 L5.2,10.5 Z</StreamGeometry>
		<!-- "stop": the same ring with a square inside; the Run button shows it while a run is in progress (2026-10-16) -->
		<StreamGeometry x:Key="StopGeometry">M0,7 A7,7 0 1 1 14,7 A7,7 0 1 1 0,7 Z M1.4,7 A5.6,5.6 0 1 0 12.6,7 A5.6,5.6 0 1 0 1.4,7 Z M4.7,4.7 L9.3,4.7 L9.3,9.3 L4.7,9.3 Z</StreamGeometry>
		<!-- the two pictures: a wave for the field, a sun for the intensity -->
		<StreamGeometry x:Key="FieldGeometry">M0,6 C1.5,1 2.5,1 4,6 C5.5,11 6.5,11 8,6 C9,3 10,3 11,6 L11,7.5 C10,5 9,5 8,7.5 C6.5,12.5 5.5,12.5 4,7.5 C2.5,2.5 1.5,2.5 0,7.5 Z</StreamGeometry>
		<StreamGeometry x:Key="IntensityGeometry">M3,5 A2,2 0 1 1 7,5 A2,2 0 1 1 3,5 Z M4.4,0 L5.6,0 L5.6,2 L4.4,2 Z M4.4,8 L5.6,8 L5.6,10 L4.4,10 Z M0,4.4 L2,4.4 L2,5.6 L0,5.6 Z M8,4.4 L10,4.4 L10,5.6 L8,5.6 Z</StreamGeometry>
		<StreamGeometry x:Key="PlayGeometry">M0,0 L9,5 L0,10 Z</StreamGeometry>
		<StreamGeometry x:Key="PauseGeometry">M0,0 L3,0 L3,10 L0,10 Z M6,0 L9,0 L9,10 L6,10 Z</StreamGeometry>
		<StreamGeometry x:Key="SideBySideGeometry">M0,0 L5,0 L5,10 L0,10 Z M7,0 L12,0 L12,10 L7,10 Z</StreamGeometry>
		<StreamGeometry x:Key="StackedGeometry">M0,0 L12,0 L12,4 L0,4 Z M0,6 L12,6 L12,10 L0,10 Z</StreamGeometry>
		<!-- frame step: the triangle leaves a bar behind it ("◀|" "|▶", the editors' frame-step look); a bar in front of the
		     triangle is the players' skip to start/end, which the author read it as (point 1, changed 2026-10-13) -->
		<StreamGeometry x:Key="StepBackGeometry">M7,0 L9,0 L9,10 L7,10 Z M0,5 L6,0 L6,10 Z</StreamGeometry>
		<StreamGeometry x:Key="StepForwardGeometry">M0,0 L2,0 L2,10 L0,10 Z M3,0 L9,5 L3,10 Z</StreamGeometry>
		<StreamGeometry x:Key="SetInGeometry">M0,0 L4,0 L4,2 L2,2 L2,8 L4,8 L4,10 L0,10 Z M6,2 L11,5 L6,8 Z</StreamGeometry>
		<StreamGeometry x:Key="SetOutGeometry">M11,0 L7,0 L7,2 L9,2 L9,8 L7,8 L7,10 L11,10 Z M5,2 L0,5 L5,8 Z</StreamGeometry>
		<StreamGeometry x:Key="ClearRangeGeometry">M0,1.5 L1.5,0 L5,3.5 L8.5,0 L10,1.5 L6.5,5 L10,8.5 L8.5,10 L5,6.5 L1.5,10 L0,8.5 L3.5,5 Z</StreamGeometry>
		<!-- "repeat": two arrows chasing each other (the loop-shaped one read oddly, 2026-10-14) -->
		<StreamGeometry x:Key="LoopGeometry">M1,2 L8,2 L8,0 L12,3 L8,6 L8,4 L3,4 L3,6 L1,6 Z M11,8 L4,8 L4,10 L0,7 L4,4 L4,6 L9,6 L9,4 L11,4 Z</StreamGeometry>
		<!-- "live": a dot inside a ring (even-odd fill makes the ring hollow) -->
		<StreamGeometry x:Key="LiveGeometry">M0.5,5 A4.5,4.5 0 1 1 9.5,5 A4.5,4.5 0 1 1 0.5,5 Z M1.5,5 A3.5,3.5 0 1 0 8.5,5 A3.5,3.5 0 1 0 1.5,5 Z M3.5,5 A1.5,1.5 0 1 1 6.5,5 A1.5,1.5 0 1 1 3.5,5 Z</StreamGeometry>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />

		<!-- the spinner over a dimmed picture while a frame computes: a three-quarter ring turning once a second while visible -->
		<StreamGeometry x:Key="SpinnerGeometry">M18,3 A15,15 0 1 1 3,18</StreamGeometry>
		<Style x:Key="Spinner" TargetType="{x:Type Path}">
			<Setter Property="Data" Value="{StaticResource SpinnerGeometry}" />
			<Setter Property="Width" Value="36" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Stroke" Value="White" />
			<Setter Property="StrokeThickness" Value="3" />
			<Setter Property="StrokeStartLineCap" Value="Round" />
			<Setter Property="StrokeEndLineCap" Value="Round" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
			<Setter Property="RenderTransform">
				<Setter.Value>
					<RotateTransform />
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsVisible" Value="True">
					<Trigger.EnterActions>
						<BeginStoryboard Name="Spin">
							<Storyboard>
								<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
							</Storyboard>
						</BeginStoryboard>
					</Trigger.EnterActions>
					<Trigger.ExitActions>
						<StopStoryboard BeginStoryboardName="Spin" />
					</Trigger.ExitActions>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- filled-glyph transport button; Content is the geometry. A tab stop: keyboard focus shows as an accent border -->
		<Style x:Key="TransportButton" TargetType="{x:Type Button}">
			<Setter Property="Width" Value="22" />
			<Setter Property="Height" Value="22" />
			<Setter Property="Margin" Value="1,0" />
			<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
							<Path Data="{TemplateBinding Content}" Fill="{TemplateBinding Foreground}"
							      HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressed}" />
								<Setter Property="Foreground" Value="White" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
								<Setter Property="Opacity" Value="0.5" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- glyph toggle (and radio) button; the checked one stays pressed. Used for the loop toggle and
		     the split radios, whose group is one tab stop with Left/Right inside (see the StackPanel below) -->
		<!-- the toggles share the buttons' look, including the greyed, half-transparent disabled state (Live without a run, 2026-10-14) -->
		<Style x:Key="TransportToggle" TargetType="{x:Type ToggleButton}">
			<Setter Property="Width" Value="22" />
			<Setter Property="Height" Value="22" />
			<Setter Property="Margin" Value="1,0" />
			<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ToggleButton}">
						<Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
							<Path Data="{TemplateBinding Content}" Fill="{TemplateBinding Foreground}"
							      HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressed}" />
								<Setter Property="Foreground" Value="White" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
								<Setter Property="Opacity" Value="0.5" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- the handles of the sources and probes on the pictures: a ring for a source, a square for a probe
		     point, each with four crosshair ticks outside it and a gap around the exact pixel; every stroke is
		     drawn twice, a dark halo first, so the glyph reads on any picture. The selected item's handle and
		     the focused handle show the accent. Glyphs are 20 x 20 with the point at (10, 10) -->
		<StreamGeometry x:Key="SourceGlyph">M4,10 A6,6 0 1 1 16,10 A6,6 0 1 1 4,10 M10,0 L10,2.5 M10,17.5 L10,20 M0,10 L2.5,10 M17.5,10 L20,10</StreamGeometry>
		<StreamGeometry x:Key="ProbeGlyph">M4.5,4.5 L15.5,4.5 L15.5,15.5 L4.5,15.5 Z M10,0 L10,2.5 M10,17.5 L10,20 M0,10 L2.5,10 M17.5,10 L20,10</StreamGeometry>
		<Style x:Key="MarkerBase" TargetType="{x:Type controls:MarkerThumb}">
			<Setter Property="Width" Value="20" />
			<Setter Property="Height" Value="20" />
			<Setter Property="Cursor" Value="SizeAll" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="Background" Value="#60000000" />
			<Setter Property="BorderBrush" Value="White" />
			<Setter Property="StrokeThickness" Value="1.5" />
			<Style.Triggers>
				<Trigger Property="IsSelectedMarker" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
					<Setter Property="Foreground" Value="{DynamicResource Accent}" />
				</Trigger>
				<Trigger Property="IsKeyboardFocused" Value="True">
					<Setter Property="Background" Value="{DynamicResource DropPreviewFill}" />
					<Setter Property="StrokeThickness" Value="2.5" />
				</Trigger>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="StrokeThickness" Value="2.5" />
				</Trigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="SourceMarker" TargetType="{x:Type controls:MarkerThumb}" BasedOn="{StaticResource MarkerBase}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type controls:MarkerThumb}">
						<Grid Background="Transparent">
							<Ellipse Width="12" Height="12" Fill="{TemplateBinding Background}" />
							<Path Data="{StaticResource SourceGlyph}" Stroke="Black" StrokeThickness="{TemplateBinding HaloThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.75" />
							<Path Data="{StaticResource SourceGlyph}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding StrokeThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
							<Ellipse Width="5" Height="5" Fill="Black" Opacity="0.75" />
							<Ellipse Width="3" Height="3" Fill="{TemplateBinding Foreground}" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- an optical part: the source's circular crosshair with an inner ring instead of the dot (a lens-shaped glyph read as squashed, 2026-10-18) -->
		<StreamGeometry x:Key="PartGlyph">M4,10 A6,6 0 1 1 16,10 A6,6 0 1 1 4,10 M7.5,10 A2.5,2.5 0 1 1 12.5,10 A2.5,2.5 0 1 1 7.5,10 M10,0 L10,2.5 M10,17.5 L10,20 M0,10 L2.5,10 M17.5,10 L20,10</StreamGeometry>
		<Style x:Key="PartMarker" TargetType="{x:Type controls:MarkerThumb}" BasedOn="{StaticResource MarkerBase}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type controls:MarkerThumb}">
						<Grid Background="Transparent">
							<Ellipse Width="12" Height="12" Fill="{TemplateBinding Background}" />
							<Path Data="{StaticResource PartGlyph}" Stroke="Black" StrokeThickness="{TemplateBinding HaloThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.75" />
							<Path Data="{StaticResource PartGlyph}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding StrokeThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<StreamGeometry x:Key="AngleGlyph">M15,10 A5,5 0 1 1 12.5,5.67 M12.5,5.67 L9.2,5.3 M12.5,5.67 L13,9</StreamGeometry>
		<Style x:Key="AngleMarker" TargetType="{x:Type controls:MarkerThumb}" BasedOn="{StaticResource MarkerBase}">
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type controls:MarkerThumb}">
						<Grid Background="Transparent">
							<Ellipse Width="14" Height="14" Fill="{TemplateBinding Background}" />
							<Path Data="{StaticResource AngleGlyph}" Stroke="Black" StrokeThickness="{TemplateBinding HaloThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.75" />
							<Path Data="{StaticResource AngleGlyph}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding StrokeThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="ProbeMarker" TargetType="{x:Type controls:MarkerThumb}" BasedOn="{StaticResource MarkerBase}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type controls:MarkerThumb}">
						<Grid Background="Transparent">
							<Rectangle Width="11" Height="11" Fill="{TemplateBinding Background}" />
							<Path Data="{StaticResource ProbeGlyph}" Stroke="Black" StrokeThickness="{TemplateBinding HaloThickness}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.75" />
							<Path Data="{StaticResource ProbeGlyph}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding StrokeThickness}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
							<Rectangle Width="5" Height="5" Fill="Black" Opacity="0.75" />
							<Rectangle Width="3" Height="3" Fill="{TemplateBinding Foreground}" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<!-- a probe's graph box: the thumb covering the box (transparent; focus and hover show a border) and the
		     resize grip at its bottom-right corner. The box itself is drawn by the overlay -->
		<Style x:Key="ProbeBoxThumb" TargetType="{x:Type controls:MarkerThumb}">
			<Setter Property="Cursor" Value="SizeAll" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type controls:MarkerThumb}">
						<Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True" />
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#80FFFFFF" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
								<Setter TargetName="Bd" Property="BorderThickness" Value="2" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<StreamGeometry x:Key="ResizeGripGlyph">M11,1 L11,3 L3,11 L1,11 Z M11,6 L11,8 L8,11 L6,11 Z</StreamGeometry>
		<Style x:Key="ProbeBoxCornerThumb" TargetType="{x:Type controls:MarkerThumb}">
			<Setter Property="Width" Value="12" />
			<Setter Property="Height" Value="12" />
			<Setter Property="Cursor" Value="SizeNWSE" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Foreground" Value="#A0FFFFFF" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type controls:MarkerThumb}">
						<Grid Background="Transparent">
							<Path Data="{StaticResource ResizeGripGlyph}" Fill="{TemplateBinding Foreground}" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Foreground" Value="White" />
				</Trigger>
				<Trigger Property="IsKeyboardFocused" Value="True">
					<Setter Property="Foreground" Value="{DynamicResource Accent}" />
				</Trigger>
			</Style.Triggers>
		</Style>
		<!-- the time axis: theme colours for the custom-drawn bar -->
		<Style TargetType="{x:Type controls:TimelineBar}">
			<Setter Property="Background" Value="{DynamicResource ScrollBarBackground}" />
			<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
			<Setter Property="TickBrush" Value="{DynamicResource ControlBorder}" />
			<Setter Property="LabelBrush" Value="{DynamicResource GrayText}" />
			<Setter Property="AccentBrush" Value="{DynamicResource Accent}" />
			<Setter Property="AvailableBrush" Value="{DynamicResource DropPreviewFill}" />
			<Setter Property="Margin" Value="4,2" />
			<Style.Triggers>
				<!-- the project was edited since the run: its frames are shaded grey instead of accent -->
				<DataTrigger Binding="{Binding IsStale, ElementName=pane}" Value="True">
					<Setter Property="AvailableBrush" Value="#50808080" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<UserControl.CommandBindings>
		<CommandBinding Command="MediaCommands.Play" CanExecute="CanPlay" Executed="OnPlay" />
		<CommandBinding Command="MediaCommands.Pause" CanExecute="CanPause" Executed="OnPause" />
		<CommandBinding Command="MediaCommands.TogglePlayPause" CanExecute="CanTogglePlayPause" Executed="OnTogglePlayPause" />
		<!-- Home/End are gestures of the commands, the letter keys are the InputBindings below; CanTransport refuses all of them inside a text box -->
		<CommandBinding Command="{x:Static commands:PreviewCommands.StepBack}" CanExecute="CanTransport" Executed="OnStepBack" />
		<CommandBinding Command="{x:Static commands:PreviewCommands.StepForward}" CanExecute="CanTransport" Executed="OnStepForward" />
		<CommandBinding Command="{x:Static commands:PreviewCommands.GoToStart}" CanExecute="CanTransport" Executed="OnGoToStart" />
		<CommandBinding Command="{x:Static commands:PreviewCommands.GoToEnd}" CanExecute="CanTransport" Executed="OnGoToEnd" />
		<CommandBinding Command="{x:Static commands:PreviewCommands.SetInPoint}" CanExecute="CanEditRange" Executed="OnSetInPoint" />
		<CommandBinding Command="{x:Static commands:PreviewCommands.SetOutPoint}" CanExecute="CanEditRange" Executed="OnSetOutPoint" />
		<CommandBinding Command="{x:Static commands:PreviewCommands.ClearRange}" CanExecute="CanClearRange" Executed="OnClearRange" />
		<CommandBinding Command="{x:Static commands:PreviewCommands.ToggleLoop}" CanExecute="CanTransport" Executed="OnToggleLoop" />
		<CommandBinding Command="{x:Static commands:PreviewCommands.ToggleLive}" CanExecute="CanToggleLive" Executed="OnToggleLive" />
	</UserControl.CommandBindings>
	<!-- plain letters are not valid KeyGestures on a command, so these live here; CanTransport keeps them out of text boxes -->
	<UserControl.InputBindings>
		<KeyBinding Key="Space" Command="MediaCommands.TogglePlayPause" />
		<KeyBinding Key="OemComma" Command="{x:Static commands:PreviewCommands.StepBack}" />
		<KeyBinding Key="OemPeriod" Command="{x:Static commands:PreviewCommands.StepForward}" />
		<KeyBinding Key="I" Command="{x:Static commands:PreviewCommands.SetInPoint}" />
		<KeyBinding Key="O" Command="{x:Static commands:PreviewCommands.SetOutPoint}" />
		<KeyBinding Key="X" Command="{x:Static commands:PreviewCommands.ClearRange}" />
		<KeyBinding Key="L" Command="{x:Static commands:PreviewCommands.ToggleLoop}" />
		<KeyBinding Key="F" Command="{x:Static commands:PreviewCommands.ToggleLive}" />
	</UserControl.InputBindings>

	<DockPanel>

		<!-- transport bar: play, pause, frame steps, in/out/clear, loop, live, frame and step readout, speed,
		     split. Tab order (TabIndex) is left to right; the DockPanel declares the right-docked items
		     first, so it cannot be the declaration order. The timeline is the row above (declared after
		     this one, since both dock to the bottom) and follows in the tab order. -->
		<Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource ToolWindowBorder}" BorderThickness="0,1,0,0" Padding="4,3">
			<DockPanel KeyboardNavigation.TabNavigation="Local">
				<!-- an explicit "run the simulation" next to Play (Play alone starts one only when needed); while a run is in
				     progress the same button is Stop (the user's rule, 2026-10-16): glyph, command and tooltip come from the
				     style, since a local value would win over the trigger. Its id stays PreviewRun; a harness tells the two
				     apart by the name -->
				<Button DockPanel.Dock="Left" TabIndex="0" AutomationProperties.AutomationId="PreviewRun">
					<Button.Style>
						<Style TargetType="{x:Type Button}" BasedOn="{StaticResource TransportButton}">
							<Setter Property="Content" Value="{StaticResource RunGeometry}" />
							<Setter Property="Command" Value="{x:Static commands:SimulationCommands.Run}" />
							<Setter Property="ToolTip" Value="{DynamicResource TipPreviewRun}" />
							<Setter Property="AutomationProperties.Name" Value="{DynamicResource TipPreviewRun}" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Run.IsActive, ElementName=pane, FallbackValue=False}" Value="True">
									<Setter Property="Content" Value="{StaticResource StopGeometry}" />
									<Setter Property="Command" Value="{x:Static commands:SimulationCommands.Stop}" />
									<Setter Property="ToolTip" Value="{DynamicResource TipPreviewStop}" />
									<Setter Property="AutomationProperties.Name" Value="{DynamicResource TipPreviewStop}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
				<Rectangle DockPanel.Dock="Left" Width="1" Margin="4,2" Fill="{DynamicResource ToolWindowBorder}" />
				<Button x:Name="playButton" DockPanel.Dock="Left" TabIndex="1" Style="{StaticResource TransportButton}" Content="{StaticResource PlayGeometry}"
				        Command="MediaCommands.Play" ToolTip="{DynamicResource TipPreviewPlay}"
				        AutomationProperties.Name="{DynamicResource TipPreviewPlay}" AutomationProperties.AutomationId="PreviewPlay" />
				<Button x:Name="pauseButton" DockPanel.Dock="Left" TabIndex="2" Style="{StaticResource TransportButton}" Content="{StaticResource PauseGeometry}"
				        Command="MediaCommands.Pause" ToolTip="{DynamicResource TipPreviewPause}"
				        AutomationProperties.Name="{DynamicResource TipPreviewPause}" AutomationProperties.AutomationId="PreviewPause" />
				<Rectangle DockPanel.Dock="Left" Width="1" Margin="4,2" Fill="{DynamicResource ToolWindowBorder}" />
				<Button DockPanel.Dock="Left" TabIndex="3" Style="{StaticResource TransportButton}" Content="{StaticResource StepBackGeometry}"
				        Command="{x:Static commands:PreviewCommands.StepBack}" ToolTip="{DynamicResource TipPreviewStepBack}"
				        AutomationProperties.Name="{DynamicResource TipPreviewStepBack}" AutomationProperties.AutomationId="PreviewStepBack" />
				<Button DockPanel.Dock="Left" TabIndex="4" Style="{StaticResource TransportButton}" Content="{StaticResource StepForwardGeometry}"
				        Command="{x:Static commands:PreviewCommands.StepForward}" ToolTip="{DynamicResource TipPreviewStepForward}"
				        AutomationProperties.Name="{DynamicResource TipPreviewStepForward}" AutomationProperties.AutomationId="PreviewStepForward" />
				<Rectangle DockPanel.Dock="Left" Width="1" Margin="4,2" Fill="{DynamicResource ToolWindowBorder}" />
				<Button DockPanel.Dock="Left" TabIndex="5" Style="{StaticResource TransportButton}" Content="{StaticResource SetInGeometry}"
				        Command="{x:Static commands:PreviewCommands.SetInPoint}" ToolTip="{DynamicResource TipPreviewSetIn}"
				        AutomationProperties.Name="{DynamicResource TipPreviewSetIn}" AutomationProperties.AutomationId="PreviewSetIn" />
				<Button DockPanel.Dock="Left" TabIndex="6" Style="{StaticResource TransportButton}" Content="{StaticResource SetOutGeometry}"
				        Command="{x:Static commands:PreviewCommands.SetOutPoint}" ToolTip="{DynamicResource TipPreviewSetOut}"
				        AutomationProperties.Name="{DynamicResource TipPreviewSetOut}" AutomationProperties.AutomationId="PreviewSetOut" />
				<Button DockPanel.Dock="Left" TabIndex="7" Style="{StaticResource TransportButton}" Content="{StaticResource ClearRangeGeometry}"
				        Command="{x:Static commands:PreviewCommands.ClearRange}" ToolTip="{DynamicResource TipPreviewClearRange}"
				        AutomationProperties.Name="{DynamicResource TipPreviewClearRange}" AutomationProperties.AutomationId="PreviewClearRange" />
				<ToggleButton DockPanel.Dock="Left" TabIndex="8" Style="{StaticResource TransportToggle}" Content="{StaticResource LoopGeometry}"
				              IsChecked="{Binding IsLooping, ElementName=pane}" ToolTip="{DynamicResource TipPreviewLoop}"
				              AutomationProperties.Name="{DynamicResource TipPreviewLoop}" AutomationProperties.AutomationId="PreviewLoop" />
				<ToggleButton DockPanel.Dock="Left" TabIndex="9" Style="{StaticResource TransportToggle}" Content="{StaticResource LiveGeometry}"
				              IsChecked="{Binding IsLive, ElementName=pane}" ToolTip="{DynamicResource TipPreviewLive}"
				              IsEnabled="{Binding Run.IsActive, ElementName=pane, FallbackValue=False}"
				              AutomationProperties.Name="{DynamicResource TipPreviewLive}" AutomationProperties.AutomationId="PreviewLive" />
				<Rectangle DockPanel.Dock="Left" Width="1" Margin="4,2" Fill="{DynamicResource ToolWindowBorder}" />

				<!-- right-docked items: the first declared is the rightmost -->
				<!-- one tab stop, the checked radio (IsTabStop follows IsChecked); the arrow keys move to the
				     neighbour and check it, in code, since WPF's directional navigation skips non-tab-stops -->
				<StackPanel x:Name="splitGroup" DockPanel.Dock="Right" Orientation="Horizontal" KeyboardNavigation.TabIndex="13"
				            KeyDown="OnSplitGroupKeyDown">
					<RadioButton Style="{StaticResource TransportToggle}" Content="{StaticResource SideBySideGeometry}" GroupName="Split"
					             ToolTip="{DynamicResource TipPreviewSideBySide}"
					             AutomationProperties.Name="{DynamicResource TipPreviewSideBySide}" AutomationProperties.AutomationId="PreviewSideBySide"
					             IsChecked="{Binding Orientation, ElementName=pane, Converter={StaticResource EnumBoolean}, ConverterParameter={x:Static Orientation.Horizontal}}"
					             IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}, Mode=OneWay}" />
					<RadioButton Style="{StaticResource TransportToggle}" Content="{StaticResource StackedGeometry}" GroupName="Split"
					             ToolTip="{DynamicResource TipPreviewStacked}"
					             AutomationProperties.Name="{DynamicResource TipPreviewStacked}" AutomationProperties.AutomationId="PreviewStacked"
					             IsChecked="{Binding Orientation, ElementName=pane, Converter={StaticResource EnumBoolean}, ConverterParameter={x:Static Orientation.Vertical}}"
					             IsTabStop="{Binding IsChecked, RelativeSource={RelativeSource Self}, Mode=OneWay}" />
				</StackPanel>
				<!-- show or hide each picture (the layer's Preview setting; the author wanted one picture at a time, point 4) -->
				<ToggleButton DockPanel.Dock="Right" TabIndex="12" Style="{StaticResource TransportToggle}" Content="{StaticResource IntensityGeometry}"
				              IsChecked="{Binding IntensitySettings.Preview, ElementName=pane, Mode=TwoWay}"
				              IsEnabled="{Binding IntensitySettings, ElementName=pane, Converter={StaticResource NotNull}}"
				              ToolTip="{DynamicResource TipPreviewShowIntensity}"
				              AutomationProperties.Name="{DynamicResource TipPreviewShowIntensity}" AutomationProperties.AutomationId="PreviewShowIntensity" />
				<ToggleButton DockPanel.Dock="Right" TabIndex="11" Style="{StaticResource TransportToggle}" Content="{StaticResource FieldGeometry}"
				              IsChecked="{Binding FieldSettings.Preview, ElementName=pane, Mode=TwoWay}"
				              IsEnabled="{Binding FieldSettings, ElementName=pane, Converter={StaticResource NotNull}}"
				              ToolTip="{DynamicResource TipPreviewShowField}"
				              AutomationProperties.Name="{DynamicResource TipPreviewShowField}" AutomationProperties.AutomationId="PreviewShowField" />
				<Rectangle DockPanel.Dock="Right" Width="1" Margin="4,2" Fill="{DynamicResource ToolWindowBorder}" />
				<ComboBox x:Name="speedBox" DockPanel.Dock="Right" TabIndex="10" Width="64" IsEditable="True" ItemsSource="{x:Static local:PreviewPane.SpeedPresets}"
				          Text="{Binding Speed, ElementName=pane, Mode=TwoWay, Converter={StaticResource DoubleText}}" ToolTip="{DynamicResource TipPreviewSpeed}"
				          AutomationProperties.Name="{DynamicResource LabelPreviewSpeed}" AutomationProperties.AutomationId="PreviewSpeed"
				          PreviewKeyDown="OnSpeedBoxPreviewKeyDown" />
				<TextBlock DockPanel.Dock="Right" Style="{StaticResource FormLabel}" Margin="8,0,4,0" Text="{DynamicResource LabelPreviewSpeed}" />

				<!-- readout: "frame / last" and, dimmer, the simulation step of that frame -->
				<TextBlock DockPanel.Dock="Left" Style="{StaticResource FormLabel}" Margin="4,0" ToolTip="{DynamicResource TipPreviewFrame}"
				           AutomationProperties.AutomationId="PreviewFrame">
					<TextBlock.Text>
						<MultiBinding StringFormat="{}{0} / {1}">
							<Binding Path="Position" ElementName="pane" />
							<Binding Path="LastFrame" ElementName="pane" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
				<TextBlock DockPanel.Dock="Left" Style="{StaticResource FormValue}" ToolTip="{DynamicResource TipPreviewStep}"
				           AutomationProperties.AutomationId="PreviewStep">
					<Run Text="{DynamicResource LabelPreviewStep}" /><Run Text=" " /><Run>
						<Run.Text>
							<MultiBinding Converter="{StaticResource FrameToStep}" Mode="OneWay">
								<Binding Path="Position" ElementName="pane" />
								<Binding Path="Project.Simulation.VisualizeEvery" ElementName="pane" />
							</MultiBinding>
						</Run.Text>
					</Run>
				</TextBlock>
				<Rectangle Fill="Transparent" />
			</DockPanel>
		</Border>

		<!-- the time axis, full width above the transport bar -->
		<controls:TimelineBar x:Name="timeline" DockPanel.Dock="Bottom"
		                      Maximum="{Binding PlannedLastFrame, ElementName=pane}" Available="{Binding Available, ElementName=pane}"
		                      Value="{Binding Position, ElementName=pane}"
		                      RangeStart="{Binding InPoint, ElementName=pane}" RangeEnd="{Binding OutPoint, ElementName=pane}"
		                      SetRangeStartCommand="{x:Static commands:PreviewCommands.SetInPoint}"
		                      SetRangeEndCommand="{x:Static commands:PreviewCommands.SetOutPoint}"
		                      ToolTip="{DynamicResource TipPreviewTimeline}"
		                      AutomationProperties.Name="{DynamicResource TipPreviewTimeline}" AutomationProperties.AutomationId="PreviewTimeline" />

		<!-- the two pictures, side by side (columns 0 and 2) or stacked (rows 0 and 2), with a splitter in
		     the middle definition. The unused dimension is bridged by spanning all three of its
		     definitions, so a drag in one orientation survives a switch to the other. Each picture is
		     centred in its cell. A click here focuses the pane so that Space works. -->
		<Grid x:Name="pictures" Margin="4" Background="Transparent" MouseDown="OnPicturesMouseDown">
			<Grid.Resources>
				<!-- a picture with its section header; Content is the ImageSource, Tag the automation id of the image -->
				<Style x:Key="PictureCell" TargetType="{x:Type HeaderedContentControl}">
					<Setter Property="HorizontalAlignment" Value="Center" />
					<Setter Property="VerticalAlignment" Value="Center" />
					<Setter Property="Focusable" Value="False" />
					<Setter Property="Margin" Value="4" />
					<Setter Property="Grid.RowSpan" Value="3" />
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="{x:Type HeaderedContentControl}">
								<!-- the label goes above the picture, or rotated to its left when the cell is wider than the picture -->
								<controls:PictureFrame>
									<TextBlock Style="{StaticResource PictureLabel}" Text="{TemplateBinding Header}" />
									<!-- the picture with the source/probe handles over it; both fill the same rectangle -->
									<Grid>
										<Image Source="{TemplateBinding Content}" Stretch="Uniform" AutomationProperties.AutomationId="{TemplateBinding Tag}" />
										<!-- the scene outline, a translucent layer of the same pixel size, so it lands exactly on the frame -->
										<Image Source="{Binding Path=(local:PreviewPane.OverlayImage), RelativeSource={RelativeSource TemplatedParent}}"
										       Stretch="Uniform" IsHitTestVisible="False" />
										<!-- the handles: sources, emitter dots, probe points and lines. Styled here, not implicitly: WPF applies
										     implicit styles inside a template only to Controls, and the overlay is a Panel -->
										<controls:SceneOverlay SourceStyle="{StaticResource SourceMarker}" PartStyle="{StaticResource PartMarker}" ProbeStyle="{StaticResource ProbeMarker}" AngleStyle="{StaticResource AngleMarker}"
										                       LineBrush="White" LabelBrush="White" AccentBrush="{DynamicResource Accent}"
										                       Project="{Binding Project, RelativeSource={RelativeSource AncestorType={x:Type local:PreviewPane}}}"
										                       CanvasWidth="{Binding CanvasWidth, RelativeSource={RelativeSource AncestorType={x:Type local:PreviewPane}}}"
										                       CanvasHeight="{Binding CanvasHeight, RelativeSource={RelativeSource AncestorType={x:Type local:PreviewPane}}}"
										                       Layer="{Binding Path=(local:PreviewPane.Layer), RelativeSource={RelativeSource TemplatedParent}}"
										                       SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type local:PreviewPane}}, Mode=TwoWay}" />
										<!-- the probes' graph boxes, over the handles: no handle or emitter dot is ever drawn on a graph (the user's
										     rule, 2026-10-18; until then the boxes lay under the handles, to keep a handle over a box grabbable, and
										     a handle under a box is reached by Tab or the tree instead); which probes depends on the cell's layer
										     (the attached PreviewPane.Layer) -->
										<controls:ProbeGraphOverlay BoxStyle="{StaticResource ProbeBoxThumb}" CornerStyle="{StaticResource ProbeBoxCornerThumb}"
										                            AccentBrush="{DynamicResource Accent}"
										                            Layer="{Binding Path=(local:PreviewPane.Layer), RelativeSource={RelativeSource TemplatedParent}}"
										                            Project="{Binding Project, RelativeSource={RelativeSource AncestorType={x:Type local:PreviewPane}}}"
										                            Run="{Binding Run, RelativeSource={RelativeSource AncestorType={x:Type local:PreviewPane}}}"
										                            Scratch="{Binding GraphScratch, RelativeSource={RelativeSource AncestorType={x:Type local:PreviewPane}}}"
										                            Frame="{Binding Position, RelativeSource={RelativeSource AncestorType={x:Type local:PreviewPane}}}"
										                            CanvasWidth="{Binding CanvasWidth, RelativeSource={RelativeSource AncestorType={x:Type local:PreviewPane}}}"
										                            CanvasHeight="{Binding CanvasHeight, RelativeSource={RelativeSource AncestorType={x:Type local:PreviewPane}}}"
										                            SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type local:PreviewPane}}, Mode=TwoWay}" />
										<!-- a frame for this position is being computed (longer than a moment): the stale picture dims and a spinner
										     turns, so the wait reads as work in progress and not as a preview that does not update (2026-10-14) -->
										<Grid IsHitTestVisible="False" Visibility="{Binding IsBusyOverlayVisible, RelativeSource={RelativeSource AncestorType={x:Type local:PreviewPane}}, Converter={StaticResource BoolToVisibility}}">
											<Rectangle Fill="Black" Opacity="0.45" />
											<Path Style="{StaticResource Spinner}" />
										</Grid>
									</Grid>
								</controls:PictureFrame>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
					<Style.Triggers>
						<DataTrigger Binding="{Binding Orientation, ElementName=pane}" Value="{x:Static Orientation.Vertical}">
							<Setter Property="Grid.RowSpan" Value="1" />
							<Setter Property="Grid.ColumnSpan" Value="3" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
				<Style x:Key="SecondPictureCell" TargetType="{x:Type HeaderedContentControl}" BasedOn="{StaticResource PictureCell}">
					<Setter Property="Grid.Column" Value="2" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding Orientation, ElementName=pane}" Value="{x:Static Orientation.Vertical}">
							<Setter Property="Grid.RowSpan" Value="1" />
							<Setter Property="Grid.ColumnSpan" Value="3" />
							<Setter Property="Grid.Column" Value="0" />
							<Setter Property="Grid.Row" Value="2" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
				<!-- the splitter: a tab stop, arrows move it, Enter or a double-click puts it back in the middle -->
				<Style x:Key="PictureSplitter" TargetType="{x:Type GridSplitter}" BasedOn="{StaticResource {x:Type GridSplitter}}">
					<Setter Property="Grid.Column" Value="1" />
					<Setter Property="Grid.RowSpan" Value="3" />
					<Setter Property="Width" Value="4" />
					<Setter Property="HorizontalAlignment" Value="Center" />
					<Setter Property="VerticalAlignment" Value="Stretch" />
					<Setter Property="ResizeDirection" Value="Columns" />
					<Setter Property="ResizeBehavior" Value="PreviousAndNext" />
					<Setter Property="KeyboardIncrement" Value="10" />
					<Setter Property="FocusVisualStyle" Value="{x:Null}" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding Orientation, ElementName=pane}" Value="{x:Static Orientation.Vertical}">
							<Setter Property="Grid.Column" Value="0" />
							<Setter Property="Grid.Row" Value="1" />
							<Setter Property="Grid.RowSpan" Value="1" />
							<Setter Property="Grid.ColumnSpan" Value="3" />
							<Setter Property="Width" Value="Auto" />
							<Setter Property="Height" Value="4" />
							<Setter Property="HorizontalAlignment" Value="Stretch" />
							<Setter Property="VerticalAlignment" Value="Center" />
							<Setter Property="ResizeDirection" Value="Rows" />
						</DataTrigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{DynamicResource ButtonHover}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter Property="Background" Value="{DynamicResource Accent}" />
						</Trigger>
					</Style.Triggers>
				</Style>
			</Grid.Resources>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<HeaderedContentControl x:Name="fieldCell" Style="{StaticResource PictureCell}" Header="{DynamicResource SectionField}"
			                        Content="{Binding FieldImage, ElementName=pane}" Tag="PreviewFieldImage" local:PreviewPane.Layer="Field"
			                        local:PreviewPane.OverlayImage="{Binding FieldOverlay, ElementName=pane}"
			                        Visibility="{Binding FieldSettings.Preview, ElementName=pane, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}">
				<HeaderedContentControl.ContextMenu>
					<!-- export of this picture first, then the other and both; the commands route from the cell (CommandTarget) up to the window -->
					<ContextMenu>
						<ContextMenu.Resources>
							<Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
								<Setter Property="CommandTarget" Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
							</Style>
						</ContextMenu.Resources>
						<MenuItem Header="{DynamicResource MenuExportThisFrame}" Command="{x:Static commands:ExportCommands.FieldFrame}" AutomationProperties.AutomationId="ContextExportFrame" />
						<Separator />
						<MenuItem Header="{DynamicResource MenuFileExportField}" Command="{x:Static commands:ExportCommands.Field}" AutomationProperties.AutomationId="ContextExportField" />
						<MenuItem Header="{DynamicResource MenuFileExportIntensity}" Command="{x:Static commands:ExportCommands.Intensity}" AutomationProperties.AutomationId="ContextExportIntensity" />
						<MenuItem Header="{DynamicResource MenuFileExportBoth}" Command="{x:Static commands:ExportCommands.Both}" AutomationProperties.AutomationId="ContextExportBoth" />
					</ContextMenu>
				</HeaderedContentControl.ContextMenu>
			</HeaderedContentControl>
			<GridSplitter x:Name="pictureSplitter" Style="{StaticResource PictureSplitter}" ToolTip="{DynamicResource TipPreviewSplitter}"
			              AutomationProperties.Name="{DynamicResource TipPreviewSplitter}" AutomationProperties.AutomationId="PreviewSplitter"
			              MouseDoubleClick="OnSplitterMouseDoubleClick" KeyDown="OnSplitterKeyDown" />
			<HeaderedContentControl x:Name="intensityCell" Style="{StaticResource SecondPictureCell}" Header="{DynamicResource SectionIntensity}"
			                        Content="{Binding IntensityImage, ElementName=pane}" Tag="PreviewIntensityImage" local:PreviewPane.Layer="Intensity"
			                        local:PreviewPane.OverlayImage="{Binding IntensityOverlay, ElementName=pane}"
			                        Visibility="{Binding IntensitySettings.Preview, ElementName=pane, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}">
				<HeaderedContentControl.ContextMenu>
					<!-- export of this picture first, then the other and both; the commands route from the cell (CommandTarget) up to the window -->
					<ContextMenu>
						<ContextMenu.Resources>
							<Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
								<Setter Property="CommandTarget" Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
							</Style>
						</ContextMenu.Resources>
						<MenuItem Header="{DynamicResource MenuExportThisFrame}" Command="{x:Static commands:ExportCommands.IntensityFrame}" AutomationProperties.AutomationId="ContextExportFrame" />
						<Separator />
						<MenuItem Header="{DynamicResource MenuFileExportIntensity}" Command="{x:Static commands:ExportCommands.Intensity}" AutomationProperties.AutomationId="ContextExportIntensity" />
						<MenuItem Header="{DynamicResource MenuFileExportField}" Command="{x:Static commands:ExportCommands.Field}" AutomationProperties.AutomationId="ContextExportField" />
						<MenuItem Header="{DynamicResource MenuFileExportBoth}" Command="{x:Static commands:ExportCommands.Both}" AutomationProperties.AutomationId="ContextExportBoth" />
					</ContextMenu>
				</HeaderedContentControl.ContextMenu>
			</HeaderedContentControl>
		</Grid>

	</DockPanel>
</UserControl>
