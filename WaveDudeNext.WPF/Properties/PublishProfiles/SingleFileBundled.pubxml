<?xml version="1.0" encoding="utf-8"?>
<!-- Single-file, self-contained publish for 64-bit Windows: one EXE in bin\PublishBundled with the .NET runtime inside,
     so nothing has to be installed on the user's machine, named WaveDudeNext-<version>-bundled.exe for the release by the
     project's NameReleaseFile target, no symbol files beside it. The counterpart of SingleFile.pubxml, which leaves the
     runtime to the machine (2026-10-31, the user's request, to compare the two).
     dotnet publish WaveDudeNext.WPF/WaveDudeNext.WPF.csproj -p:PublishProfile=SingleFileBundled -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\PublishBundled\</PublishDir>
    <NameReleaseFile>true</NameReleaseFile>
    <ReleaseFileSuffix>-bundled</ReleaseFileSuffix>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
