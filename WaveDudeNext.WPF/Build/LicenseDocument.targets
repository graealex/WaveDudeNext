<!-- Build action: LICENSE.md becomes a WPF FlowDocument (obj/<Configuration>/License.xaml), embedded as the resource
     "License.xaml", which Help > About loads with XamlReader into a FlowDocumentScrollViewer. The Markdown subset is
     what the FSF's file uses: headings (#, ##, ###), paragraphs with hard line breaks, a rule of three dashes, bullet lists
     with indented continuation lines, indented code blocks and <https://...> autolinks; backslash escapes are
     undone. The converter is an inline C# task (RoslynCodeTaskFactory, part of MSBuild), so the app carries no
     Markdown code and the build needs no package. Regenerated only when LICENSE.md is newer than the output. -->
<Project>

  <UsingTask TaskName="MarkdownToFlowDocument" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.IO;
using System.Text;
using System.Text.RegularExpressions;

public class MarkdownToFlowDocument : Microsoft.Build.Utilities.Task
{
	[Microsoft.Build.Framework.Required] public string Source { get; set; }
	[Microsoft.Build.Framework.Required] public string Destination { get; set; }

	private static readonly Regex Item = new Regex(@"^[-*+]\s+");
	private static readonly Regex Rule = new Regex(@"^-{3,}\s*$");
	private static readonly Regex AutoLink = new Regex(@"<(https?://[^\s>]+)>");
	private static readonly Regex Escaped = new Regex(@"\\([\\`*_{}\[\]()#+\-.!<>])");

	public override bool Execute()
	{
		try
		{
			string[] lines = File.ReadAllLines(Source);
			var sb = new StringBuilder();
			sb.AppendLine("<FlowDocument xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\" FontFamily=\"Segoe UI\" FontSize=\"12\" PagePadding=\"10\" TextAlignment=\"Left\" IsHyphenationEnabled=\"False\">");
			int i = 0, n = lines.Length;
			while (i < n)
			{
				string line = lines[i];
				if (line.Trim().Length == 0) { i++; continue; }
				if (line.StartsWith("#"))
				{
					int level = line.Length - line.TrimStart('#').Length;
					string text = line.Substring(level).Trim();
					string style = level == 1 ? "FontSize=\"18\" FontWeight=\"SemiBold\" Margin=\"0,6,0,10\""
						: level == 2 ? "FontSize=\"15\" FontWeight=\"SemiBold\" Margin=\"0,14,0,8\""
						: "FontSize=\"13\" FontWeight=\"SemiBold\" Margin=\"0,10,0,6\"";
					sb.AppendLine("<Paragraph " + style + ">" + Inline(text) + "</Paragraph>");
					i++;
					continue;
				}
				if (Rule.IsMatch(line))
				{
					sb.AppendLine("<Paragraph BorderThickness=\"0,0,0,1\" BorderBrush=\"{DynamicResource ControlBorder}\" Margin=\"0,6,0,14\" FontSize=\"1\" />");
					i++;
					continue;
				}
				if (line.StartsWith("    "))
				{
					var code = new List<string>();
					int j = i;
					while (j < n && (lines[j].StartsWith("    ") || lines[j].Trim().Length == 0)) { code.Add(lines[j]); j++; }
					while (code.Count > 0 && code[code.Count - 1].Trim().Length == 0) { code.RemoveAt(code.Count - 1); }
					int indent = int.MaxValue;
					foreach (string c in code) { if (c.Trim().Length > 0) { indent = Math.Min(indent, c.Length - c.TrimStart(' ').Length); } }
					var parts = new List<string>();
					foreach (string c in code) { parts.Add(Escape(c.Length >= indent ? c.Substring(indent) : "")); }
					sb.AppendLine("<Paragraph FontFamily=\"Consolas\" FontSize=\"11\" Margin=\"16,0,0,10\" xml:space=\"preserve\">" + string.Join("<LineBreak />", parts) + "</Paragraph>");
					i = j;
					continue;
				}
				if (Item.IsMatch(line))
				{
					sb.AppendLine("<List MarkerStyle=\"Disc\" Margin=\"0,0,0,10\" Padding=\"20,0,0,0\">");
					while (i < n)
					{
						if (lines[i].Trim().Length == 0)
						{
							int k = i;
							while (k < n && lines[k].Trim().Length == 0) { k++; }
							if (k < n && Item.IsMatch(lines[k])) { i = k; } else { break; }
						}
						if (!Item.IsMatch(lines[i])) { break; }
						string text = Item.Replace(lines[i], "").Trim();
						i++;
						while (i < n && lines[i].Trim().Length > 0 && !Item.IsMatch(lines[i])) { text += " " + lines[i].Trim(); i++; }
						sb.AppendLine("<ListItem Margin=\"0,0,0,4\"><Paragraph>" + Inline(text) + "</Paragraph></ListItem>");
					}
					sb.AppendLine("</List>");
					continue;
				}
				string para = line.Trim();
				i++;
				while (i < n && lines[i].Trim().Length > 0 && !lines[i].StartsWith("#") && !Item.IsMatch(lines[i]) && !lines[i].StartsWith("    ")) { para += " " + lines[i].Trim(); i++; }
				sb.AppendLine("<Paragraph Margin=\"0,0,0,10\">" + Inline(para) + "</Paragraph>");
			}
			sb.AppendLine("</FlowDocument>");
			Directory.CreateDirectory(Path.GetDirectoryName(Destination));
			File.WriteAllText(Destination, sb.ToString(), new UTF8Encoding(false));
			Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Normal, "License document: " + Destination + " from " + Source);
			return true;
		}
		catch (Exception ex)
		{
			Log.LogErrorFromException(ex);
			return false;
		}
	}

	private static string Escape(string s) => s.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;");

	// text with its <https://...> autolinks as Hyperlinks and the rest escaped
	private static string Inline(string text)
	{
		text = Escaped.Replace(text, "$1");
		var sb = new StringBuilder();
		int last = 0;
		foreach (Match m in AutoLink.Matches(text))
		{
			sb.Append(Escape(text.Substring(last, m.Index - last)));
			string url = Escape(m.Groups[1].Value);
			sb.Append("<Hyperlink NavigateUri=\"" + url + "\">" + url + "</Hyperlink>");
			last = m.Index + m.Length;
		}
		sb.Append(Escape(text.Substring(last)));
		return sb.ToString();
	}
}
]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <LicenseMarkdown>$(MSBuildThisFileDirectory)..\..\LICENSE.md</LicenseMarkdown>
  </PropertyGroup>

  <!-- the conversion, skipped while the output is newer than LICENSE.md -->
  <Target Name="GenerateLicenseDocument" Inputs="$(LicenseMarkdown);$(MSBuildThisFileFullPath)" Outputs="$(IntermediateOutputPath)License.xaml">
    <MarkdownToFlowDocument Source="$(LicenseMarkdown)" Destination="$(IntermediateOutputPath)License.xaml" />
  </Target>

  <!-- the embedding; a target of its own, so the item is added even when the conversion was skipped as up to date -->
  <Target Name="EmbedLicenseDocument" BeforeTargets="BeforeBuild" DependsOnTargets="GenerateLicenseDocument">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)License.xaml" LogicalName="License.xaml" />
    </ItemGroup>
  </Target>

</Project>
