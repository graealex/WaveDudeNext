	<s:String x:Key="Label.Simulation.VisualizeEvery">Darstellen alle</s:String>
	<s:String x:Key="Hint.Simulation.VisualizeEvery">Alle so viele Schritte ein Bild rendern, exportieren und die Sonden abtasten.</s:String>
