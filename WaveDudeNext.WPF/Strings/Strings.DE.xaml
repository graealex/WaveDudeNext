	<s:String x:Key="Hint.Source.X">X des Strahlers bzw. der Anordnungsmitte, in Leinwandpixeln.</s:String>
	<s:String x:Key="Label.Source.Y">Y</s:String>
	<s:String x:Key="Hint.Source.Y">Y des Strahlers bzw. der Anordnungsmitte, in Leinwandpixeln.</s:String>
	<s:String x:Key="Label.Source.Frequency">Frequenz</s:String>
	<s:String x:Key="Hint.Source.Frequency">Frequenz als Stufe bis 255, Dezimalstellen erlaubt, dieselbe Skala wie der Grünkanal der Bildquellen. Über 255 kann das Gitter die Welle nicht mehr abtasten.</s:String>
	<s:String x:Key="Label.Source.Amplitude">Amplitude</s:String>
	<s:String x:Key="Hint.Source.Amplitude">Amplitude in Prozent, 0 bis 100, Dezimalstellen erlaubt.</s:String>
	<s:String x:Key="Label.Source.Phase">Phase</s:String>
	<s:String x:Key="Hint.Source.Phase">Phasenversatz in Grad, -180 bis 180.</s:String>
	<s:String x:Key="Label.Source.Mode">Modus</s:String>
	<s:String x:Key="Hint.Source.Mode">Durchgehend oder in Pulsen abstrahlen.</s:String>
	<s:String x:Key="Label.Source.PulseShape">Pulsform</s:String>
	<s:String x:Key="Hint.Source.PulseShape">Hüllkurve jedes Pulses; nur im Pulsmodus.</s:String>
	<s:String x:Key="Label.Source.PulseWidth">Pulsbreite</s:String>
	<s:String x:Key="Hint.Source.PulseWidth">Länge jedes Pulses in Perioden der Quellfrequenz; nur im Pulsmodus.</s:String>
	<s:String x:Key="Label.Source.OffWidth">Pausenbreite</s:String>
	<s:String x:Key="Hint.Source.OffWidth">Länge der Lücke zwischen Pulsen in Perioden; nur im Pulsmodus.</s:String>
	<s:String x:Key="Label.Source.DetachAfter">Abschalten nach Schritt</s:String>
	<s:String x:Key="Hint.Source.DetachAfter">Simulationsschritt, bei dem die Quelle ausblendet; -1 lässt sie den ganzen Lauf an.</s:String>
	<s:String x:Key="Label.Source.Array">Anordnung</s:String>
	<s:String x:Key="Hint.Source.Array">Raster von Strahlern um die Position; leer für einen einzelnen Strahler.</s:String>
	<s:String x:Key="Label.Source.IsComposite">Zusammengesetzte Quelle</s:String>
	<s:String x:Key="Hint.Source.IsComposite">Aus einer Anordnung von Strahlern statt aus einem einzelnen Punkt abstrahlen.</s:String>
	<s:String x:Key="Label.SourceArray.SizeX">Spalten</s:String>
	<s:String x:Key="Hint.SourceArray.SizeX">Anzahl der Strahler nebeneinander. Ungerade Anzahlen halten den mittleren Strahler auf der Quellposition.</s:String>
	<s:String x:Key="Label.SourceArray.SizeY">Zeilen</s:String>
	<s:String x:Key="Hint.SourceArray.SizeY">Anzahl der Strahler untereinander.</s:String>
	<s:String x:Key="Label.SourceArray.SpacingX">Horizontaler Abstand</s:String>
	<s:String x:Key="Hint.SourceArray.SpacingX">Abstand benachbarter Spalten in Leinwandpixeln.</s:String>
	<s:String x:Key="Label.SourceArray.SpacingY">Vertikaler Abstand</s:String>
	<s:String x:Key="Hint.SourceArray.SpacingY">Abstand benachbarter Zeilen in Leinwandpixeln.</s:String>
	<s:String x:Key="Label.SourceArray.Angle">Drehung</s:String>
	<s:String x:Key="Hint.SourceArray.Angle">Drehung des Rasters um die Quellposition in Grad, auf dem Bildschirm gegen den Uhrzeigersinn. 0 lässt die Zeilen waagerecht.</s:String>
	<s:String x:Key="Label.SourceArray.RandomFrequency">Frequenz</s:String>
	<s:String x:Key="Hint.SourceArray.RandomFrequency">Die Stufe jedes Strahlers wird um bis zu ± diesen Betrag versetzt. 0 schaltet es ab.</s:String>
	<s:String x:Key="Label.SourceArray.RandomPhase">Phase</s:String>
	<s:String x:Key="Hint.SourceArray.RandomPhase">Die Phase jedes Strahlers wird um bis zu ± so viele Grad versetzt. 0 schaltet es ab.</s:String>
	<s:String x:Key="Label.SourceArray.RandomOffWidth">Pausenbreite</s:String>
	<s:String x:Key="Hint.SourceArray.RandomOffWidth">Jede Lücke zwischen Pulsen wird um bis zu ± so viele Perioden versetzt, jede Periode neu gezogen. 0 schaltet es ab.</s:String>
	<s:String x:Key="Label.SourceArray.RandomPosition">Position</s:String>
	<s:String x:Key="Hint.SourceArray.RandomPosition">Jeder Strahler wird um bis zu ± so viele Pixel in X und Y verschoben. 0 schaltet es ab.</s:String>
	<s:String x:Key="Label.ColorStop.Position">Position</s:String>
	<s:String x:Key="Hint.ColorStop.Position">Position im Verlauf, 0 beim kleinsten Wert bis 1 beim größten.</s:String>
	<s:String x:Key="Label.ColorStop.Color">Farbe</s:String>
	<s:String x:Key="Hint.ColorStop.Color">Farbe an dieser Position, als #RRGGBB.</s:String>
	<s:String x:Key="Label.ColorScheme.Name">Name</s:String>
	<s:String x:Key="Hint.ColorScheme.Name">Name, auf den sich die Darstellungseinstellungen beziehen.</s:String>
	<s:String x:Key="Label.ColorScheme.Kind">Art</s:String>
	<s:String x:Key="Hint.ColorScheme.Kind">Ausgabe, für die das Schema gedacht ist; die Auswahllisten führen es nur dort auf.</s:String>
	<s:String x:Key="Label.ColorScheme.Description">Beschreibung</s:String>
	<s:String x:Key="Hint.ColorScheme.Description">Freier Text: was das Schema ist, woher es stammt.</s:String>
	<s:String x:Key="Enum.ProbeLayer.Field">Feld</s:String>
	<s:String x:Key="Enum.ProbeLayer.Intensity">Intensität</s:String>
