	<s:String x:Key="Label.Simulation.SourceFrequencyScale">Quellfrequenzfaktor</s:String>
	<s:String x:Key="Hint.Simulation.SourceFrequencyScale">Faktor der Zuordnung von Stufe zu Frequenz: ω = Stufe / 255 × 0,5 × Faktor, in Radiant pro Schritt.</s:String>
	<s:String x:Key="Label.Simulation.IntensityScale">Intensitätsfaktor</s:String>
	<s:String x:Key="Hint.Simulation.IntensityScale">Faktor auf die von der Engine erzeugten Intensitätswerte.</s:String>
