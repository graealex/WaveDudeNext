	<s:String x:Key="Hint.Simulation.FourthOrderLaplacian">Das Schema 4. Ordnung mit Zwischenschritten statt des 9-Punkt-Schemas verwenden. Genauer, langsamer.</s:String>
	<s:String x:Key="Label.Simulation.WaveSpeed">Wellengeschwindigkeit</s:String>
