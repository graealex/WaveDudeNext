<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
                    xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
                    xmlns:localization="clr-namespace:WaveDudeNext.WPF.Localization">

	<!-- editors used by the property views: VS look, colours from the theme table -->

	<Style TargetType="{x:Type TextBox}">
		<Setter Property="Background" Value="{DynamicResource TextBoxBackground}" />
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorder}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="3,2" />
		<Setter Property="MinHeight" Value="22" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="CaretBrush" Value="{DynamicResource WindowForeground}" />
		<Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
		<Setter Property="AllowDrop" Value="True" />
		<!-- Enter commits the edit, Escape reverts it (EditBehavior) -->
		<Setter Property="controls:EditBehavior.CommitOnEnter" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type TextBox}">
					<Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
						<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextBoxHoverBorder}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocusWithin" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource WindowBackground}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- NumberBox: the text box plus a column of two small repeat buttons (Up/Down keys, wheel and buttons step the value) -->
	<Style x:Key="SpinButton" TargetType="{x:Type RepeatButton}">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Delay" Value="400" />
		<Setter Property="Interval" Value="60" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border x:Name="Bd" Background="Transparent" Width="14">
						<Path x:Name="Glyph" Data="{TemplateBinding Content}" Stroke="{DynamicResource ComboBoxGlyph}" StrokeThickness="1"
						      Width="6" Height="3" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressed}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="{x:Type controls:NumberBox}" BasedOn="{StaticResource {x:Type TextBox}}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:NumberBox}">
					<Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
							<Grid x:Name="Spinner" Grid.Column="1">
								<Grid.RowDefinitions>
									<RowDefinition Height="*" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
								<RepeatButton x:Name="PART_Up" Style="{StaticResource SpinButton}" Content="{StaticResource ChevronUpGeometry}" />
								<RepeatButton x:Name="PART_Down" Grid.Row="1" Style="{StaticResource SpinButton}" Content="{StaticResource ChevronDownGeometry}" />
							</Grid>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextBoxHoverBorder}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocusWithin" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource WindowBackground}" />
							<Setter TargetName="Spinner" Property="Visibility" Value="Hidden" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type CheckBox}">
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="MinHeight" Value="22" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type CheckBox}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
						<Border x:Name="Box" Width="14" Height="14" Background="{DynamicResource CheckBoxBackground}"
						        BorderBrush="{DynamicResource CheckBoxBorder}" BorderThickness="1" SnapsToDevicePixels="True">
							<Path x:Name="Glyph" Data="{StaticResource CheckGeometry}" Stroke="{DynamicResource WindowForeground}"
							      StrokeThickness="1.5" Stretch="Uniform" Margin="2" Visibility="Collapsed" />
						</Border>
						<ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
					</StackPanel>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
							<Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource GrayText}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type ComboBoxItem}">
		<Setter Property="Foreground" Value="{DynamicResource MenuForeground}" />
		<Setter Property="Padding" Value="6,3" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ComboBoxItem}">
					<Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
						<ContentPresenter VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsHighlighted" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboBoxItemHover}" />
							<Setter Property="Foreground" Value="{DynamicResource ComboBoxItemHoverForeground}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type ComboBox}">
		<!-- the item style travels with the container: a container discarded on an ItemsSource change would otherwise
		     fall back to the theme style, whose ancestor bindings then fail and log errors (2026-10-13) -->
		<Setter Property="ItemContainerStyle" Value="{DynamicResource {x:Type ComboBoxItem}}" />
		<Setter Property="Background" Value="{DynamicResource ComboBoxBackground}" />
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorder}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="4,2" />
		<Setter Property="MinHeight" Value="22" />
		<Setter Property="MaxDropDownHeight" Value="300" />
		<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ComboBox}">
					<Grid>
						<ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
						              BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
						              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
							<ToggleButton.Template>
								<ControlTemplate TargetType="{x:Type ToggleButton}">
									<Border x:Name="Bd" Background="{DynamicResource ComboBoxBackground}" BorderBrush="{TemplateBinding BorderBrush}"
									        BorderThickness="1" SnapsToDevicePixels="True">
										<Path Data="{StaticResource DropDownGeometry}" Fill="{DynamicResource ComboBoxGlyph}"
										      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboBoxHover}" />
											<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextBoxHoverBorder}" />
										</Trigger>
										<Trigger Property="IsChecked" Value="True">
											<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</ToggleButton.Template>
						</ToggleButton>
						<ContentPresenter x:Name="Selection" Content="{TemplateBinding SelectionBoxItem}"
						                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
						                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
						                  Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
						                  HorizontalAlignment="Stretch" IsHitTestVisible="False" />
						<!-- the text box of an editable combo (IsEditable); leaves the drop-down glyph its 18 px on the right -->
						<TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="0,0,18,0" BorderThickness="0" Background="Transparent"
						         Padding="{TemplateBinding Padding}" IsReadOnly="{TemplateBinding IsReadOnly}" />
						<Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
						       AllowsTransparency="True" PopupAnimation="None" Focusable="False">
							<Border Background="{DynamicResource ComboBoxListBackground}" BorderBrush="{DynamicResource MenuPopupBorder}"
							        BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
							        SnapsToDevicePixels="True">
								<ScrollViewer>
									<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEditable" Value="True">
							<Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
							<Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<!-- keyboard focus (on the combo or inside its text box) shows like a focused text box -->
						<Trigger Property="IsKeyboardFocusWithin" Value="True">
							<Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- horizontal slider: thin track, flat thumb; a click on the track jumps there -->
	<Style x:Key="SliderTrackButtonStyle" TargetType="{x:Type RepeatButton}">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SliderThumbStyle" TargetType="{x:Type Thumb}">
		<Setter Property="Width" Value="10" />
		<Setter Property="Height" Value="18" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Thumb}">
					<Border x:Name="Bd" Background="{DynamicResource ButtonBackground}" BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="1" SnapsToDevicePixels="True" />
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
						<Trigger Property="IsDragging" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressed}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="{x:Type Slider}">
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
		<Setter Property="IsMoveToPointEnabled" Value="True" />
		<Setter Property="MinHeight" Value="22" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Slider}">
					<Grid Height="18" VerticalAlignment="Center">
						<Border Height="4" VerticalAlignment="Center" Background="{DynamicResource ScrollBarBackground}"
						        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" SnapsToDevicePixels="True" />
						<Track x:Name="PART_Track">
							<Track.DecreaseRepeatButton>
								<RepeatButton Style="{StaticResource SliderTrackButtonStyle}" Command="Slider.DecreaseLarge" />
							</Track.DecreaseRepeatButton>
							<Track.IncreaseRepeatButton>
								<RepeatButton Style="{StaticResource SliderTrackButtonStyle}" Command="Slider.IncreaseLarge" />
							</Track.IncreaseRepeatButton>
							<Track.Thumb>
								<Thumb x:Name="Thumb" Style="{StaticResource SliderThumbStyle}" />
							</Track.Thumb>
						</Track>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Thumb" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.5" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- enum pickers show the values as words ("Smoothed square") -->
	<converters:EnumNameConverter x:Key="EnumName" />
	<Style x:Key="EnumComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
		<Setter Property="ItemTemplate">
			<Setter.Value>
				<DataTemplate>
					<!-- the language is a second input, so the words follow a switch -->
					<TextBlock>
						<TextBlock.Text>
							<MultiBinding Converter="{StaticResource EnumName}">
								<Binding />
								<Binding Path="Current" Source="{x:Static localization:LanguageController.Instance}" />
							</MultiBinding>
						</TextBlock.Text>
					</TextBlock>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- the colour scheme drop-down: a gradient strip, the name, a grey tag; actions in italics -->
	<converters:ColorSchemeBrushConverter x:Key="ColorSchemeBrush" />
	<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
	<Style TargetType="{x:Type controls:ColorSchemePicker}" BasedOn="{StaticResource {x:Type ComboBox}}">
		<Setter Property="ItemTemplate">
			<Setter.Value>
				<DataTemplate>
					<!-- the right margin keeps the selection box clear of the drop-down glyph; a long name is trimmed -->
					<DockPanel Margin="0,0,18,0">
						<Rectangle DockPanel.Dock="Left" Width="56" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" StrokeThickness="0.5"
						           Stroke="{DynamicResource TextBoxBorder}" Fill="{Binding Scheme, Converter={StaticResource ColorSchemeBrush}}"
						           Visibility="{Binding HasScheme, Converter={StaticResource BoolToVisibility}}" />
						<TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Tag}" Foreground="{DynamicResource GrayText}" />
						<TextBlock VerticalAlignment="Center" Text="{Binding Label}" FontStyle="{Binding FontStyle}" TextTrimming="CharacterEllipsis">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsMissing}" Value="True">
											<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</DockPanel>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- property forms -->
	<!-- a group header in the Properties pane: the name over a rule across the width, so the groups read apart
	     (2026-10-15, after the Field and Intensity groups of the Display view were taken for one list) -->
	<!-- the colour picker (2026-10-15): the square is the pure hue under a white-to-clear and a clear-to-black overlay,
	     the strip the hue circle top to bottom; the markers are placed by the control; square and strip take the focus -->
	<converters:RgbBrushConverter x:Key="RgbBrush" />
	<Style TargetType="{x:Type controls:ColorPicker}">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:ColorPicker}">
					<StackPanel Margin="8">
						<DockPanel>
							<Thumb x:Name="PART_Square" DockPanel.Dock="Left" Width="160" Height="160" Focusable="True" FocusVisualStyle="{x:Null}"
							       BorderThickness="1" BorderBrush="{DynamicResource TextBoxBorder}" ToolTip="{DynamicResource TipColorSquare}"
							       AutomationProperties.AutomationId="ColorSquare">
								<Thumb.Template>
									<ControlTemplate TargetType="{x:Type Thumb}">
										<Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
											<Grid Background="{Binding HueBrush, RelativeSource={RelativeSource AncestorType={x:Type controls:ColorPicker}}}">
												<Rectangle>
													<Rectangle.Fill>
														<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
															<GradientStop Color="#FFFFFFFF" Offset="0" />
															<GradientStop Color="#00FFFFFF" Offset="1" />
														</LinearGradientBrush>
													</Rectangle.Fill>
												</Rectangle>
												<Rectangle>
													<Rectangle.Fill>
														<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
															<GradientStop Color="#00000000" Offset="0" />
															<GradientStop Color="#FF000000" Offset="1" />
														</LinearGradientBrush>
													</Rectangle.Fill>
												</Rectangle>
												<Canvas IsHitTestVisible="False">
													<Grid x:Name="PART_SquareMarker" Width="13" Height="13">
														<Ellipse Stroke="Black" StrokeThickness="3" />
														<Ellipse Stroke="White" StrokeThickness="1.5" Margin="0.75" />
													</Grid>
												</Canvas>
											</Grid>
										</Border>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
							<Thumb x:Name="PART_HueStrip" Width="20" Height="160" Margin="8,0,0,0" HorizontalAlignment="Left" Focusable="True" FocusVisualStyle="{x:Null}"
							       BorderThickness="1" BorderBrush="{DynamicResource TextBoxBorder}" ToolTip="{DynamicResource TipColorHue}"
							       AutomationProperties.AutomationId="ColorHue">
								<Thumb.Template>
									<ControlTemplate TargetType="{x:Type Thumb}">
										<Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
											<Grid>
												<Rectangle>
													<Rectangle.Fill>
														<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
															<GradientStop Color="#FF0000" Offset="0" />
															<GradientStop Color="#FFFF00" Offset="0.1667" />
															<GradientStop Color="#00FF00" Offset="0.3333" />
															<GradientStop Color="#00FFFF" Offset="0.5" />
															<GradientStop Color="#0000FF" Offset="0.6667" />
															<GradientStop Color="#FF00FF" Offset="0.8333" />
															<GradientStop Color="#FF0000" Offset="1" />
														</LinearGradientBrush>
													</Rectangle.Fill>
												</Rectangle>
												<Canvas IsHitTestVisible="False">
													<Border x:Name="PART_HueMarker" Width="22" Height="7" Canvas.Left="-2" BorderBrush="White" BorderThickness="1">
														<Border BorderBrush="Black" BorderThickness="1" />
													</Border>
												</Canvas>
											</Grid>
										</Border>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</DockPanel>
						<DockPanel Margin="0,8,0,0">
							<TextBlock DockPanel.Dock="Left" Text="R" VerticalAlignment="Center" Margin="0,0,3,0" />
							<controls:NumberBox DockPanel.Dock="Left" Width="56" Minimum="0" Maximum="255" Increment="1" ToolTip="{DynamicResource TipColorChannel}"
							                    Text="{Binding Red, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.AutomationId="ColorRed" />
							<TextBlock DockPanel.Dock="Left" Text="G" VerticalAlignment="Center" Margin="8,0,3,0" />
							<controls:NumberBox DockPanel.Dock="Left" Width="56" Minimum="0" Maximum="255" Increment="1" ToolTip="{DynamicResource TipColorChannel}"
							                    Text="{Binding Green, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.AutomationId="ColorGreen" />
							<TextBlock DockPanel.Dock="Left" Text="B" VerticalAlignment="Center" Margin="8,0,3,0" />
							<controls:NumberBox DockPanel.Dock="Left" Width="56" Minimum="0" Maximum="255" Increment="1" ToolTip="{DynamicResource TipColorChannel}"
							                    Text="{Binding Blue, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.AutomationId="ColorBlue" />
							<TextBox Margin="8,0,0,0" ToolTip="{DynamicResource TipStopColor}" AutomationProperties.AutomationId="ColorHex"
							         Text="{Binding Color, RelativeSource={RelativeSource TemplatedParent}}" />
						</DockPanel>
					</StackPanel>
					<ControlTemplate.Triggers>
						<Trigger SourceName="PART_Square" Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="PART_Square" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
						<Trigger SourceName="PART_HueStrip" Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="PART_HueStrip" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- the swatch that opens the picker in a popup below it; the popup's open state is the button's checked state -->
	<Style TargetType="{x:Type controls:ColorPickerButton}">
		<Setter Property="Width" Value="22" />
		<Setter Property="Height" Value="18" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:ColorPickerButton}">
					<Grid>
						<Border x:Name="Bd" BorderBrush="{DynamicResource TextBoxBorder}" BorderThickness="1" SnapsToDevicePixels="True"
						        Background="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RgbBrush}}" />
						<Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
						       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
						       IsOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
							<Border Background="{DynamicResource ComboBoxListBackground}" BorderBrush="{DynamicResource MenuPopupBorder}" BorderThickness="1" SnapsToDevicePixels="True">
								<controls:ColorPicker x:Name="PART_Picker" Color="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
							</Border>
						</Popup>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextBoxHoverBorder}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- links (About): accent colour, underlined on hover and when focused by keyboard; the focus rectangle is WPF's own -->
	<Style TargetType="{x:Type Hyperlink}">
		<Setter Property="Foreground" Value="{DynamicResource Accent}" />
		<Setter Property="TextDecorations" Value="{x:Null}" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="TextDecorations" Value="Underline" />
			</Trigger>
			<Trigger Property="IsKeyboardFocused" Value="True">
				<Setter Property="TextDecorations" Value="Underline" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<StreamGeometry x:Key="MinusGeometry">M0,4 L8,4</StreamGeometry>
	<!-- the remove button of a point or node row (Views/PartPointsView, Views/FiberPathView); in the Tab cycle, since no key removes a row otherwise -->
	<Style x:Key="RemovePointButton" TargetType="{x:Type Button}">
		<Setter Property="Width" Value="18" />
		<Setter Property="Height" Value="18" />
		<Setter Property="Margin" Value="4,0,0,0" />
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
						<Path Data="{StaticResource MinusGeometry}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
						      HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.4" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FormSection" TargetType="{x:Type Label}">
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
		<Setter Property="BorderThickness" Value="0,0,0,1" />
		<Setter Property="Padding" Value="0,0,0,2" />
		<Setter Property="Margin" Value="0,2,0,6" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
	</Style>
	<!-- the gap between groups comes after a group's rows, not before its header, so the first header sits close to
	     the pane's edge (2026-10-15, it hung 18 px below it) -->
	<Style TargetType="{x:Type controls:FormPanel}">
		<Setter Property="Margin" Value="0,0,0,10" />
	</Style>
	<!-- the label of a preview picture (above it, or rotated beside it): the old plain section look -->
	<Style x:Key="PictureLabel" TargetType="{x:Type TextBlock}">
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
		<Setter Property="Margin" Value="0,10,0,4" />
	</Style>
	<Style x:Key="FormLabel" TargetType="{x:Type TextBlock}">
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<!-- the chain between two number boxes that keeps them equal (a rectangle's or ellipse's width and length,
	     2026-10-20, the user's request after the image editors): a toggle showing two linked rings, parted when off -->
	<StreamGeometry x:Key="ChainLinkedGeometry">M8,1 h2 a3,3 0 0 1 3,3 v2 a3,3 0 0 1 -3,3 h-2 a3,3 0 0 1 -3,-3 v-2 a3,3 0 0 1 3,-3 z M8,7 h2 a3,3 0 0 1 3,3 v2 a3,3 0 0 1 -3,3 h-2 a3,3 0 0 1 -3,-3 v-2 a3,3 0 0 1 3,-3 z</StreamGeometry>
	<StreamGeometry x:Key="ChainPartedGeometry">M8,0 h2 a3,3 0 0 1 3,3 v1 a3,3 0 0 1 -3,3 h-2 a3,3 0 0 1 -3,-3 v-1 a3,3 0 0 1 3,-3 z M8,9 h2 a3,3 0 0 1 3,3 v1 a3,3 0 0 1 -3,3 h-2 a3,3 0 0 1 -3,-3 v-1 a3,3 0 0 1 3,-3 z</StreamGeometry>
	<Style x:Key="LinkToggle" TargetType="{x:Type ToggleButton}">
		<Setter Property="Width" Value="22" />
		<Setter Property="Height" Value="22" />
		<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ToggleButton}">
					<Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
						<Path x:Name="Glyph" Data="{StaticResource ChainPartedGeometry}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
						      Width="18" Height="16" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Glyph" Property="Data" Value="{StaticResource ChainLinkedGeometry}" />
							<Setter Property="Foreground" Value="{DynamicResource Accent}" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.5" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="FormValue" TargetType="{x:Type TextBlock}">
		<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="4,0" />
	</Style>

</ResourceDictionary>
