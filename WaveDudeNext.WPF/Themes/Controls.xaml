<!--
	Control styles for the whole application. Visual Studio look, system font at 9pt, every
	colour taken from the active colour table (Dark.xaml / Light.xaml) via DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:docking="clr-namespace:WaveDudeNext.WPF.Docking"
                    xmlns:theming="clr-namespace:WaveDudeNext.WPF.Theming"
                    xmlns:converters="clr-namespace:WaveDudeNext.WPF.Converters"
                    xmlns:ui="clr-namespace:WaveDudeNext.UI;assembly=WaveDudeNext.UI">

	<!-- the geometries, one dictionary for both heads (the icons 2026-11-10, every keyed geometry 2026-11-11): the Avalonia head builds its copy from this file -->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="Icons.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
	<!-- the UI zoom for a tooltip or context menu, whose popup of WPF's own sits outside any window's tree and takes no
	     transform from its target (WindowZoom): the scale and the text formatting bound to the setting -->
	<converters:ZoomTransformConverter x:Key="ZoomTransform" />
	<converters:ZoomTextFormattingConverter x:Key="ZoomTextFormatting" />

	<!-- over the pictures (2026-10-26, Jeroen's tester: the selected item's accent blue was duller than the rest, lost on a blue
	     scheme and to colour-blind eyes): the handles, labels, lines, outlines and graph boxes in a light grey, the selected
	     item's in a bright yellow, both over the dark halo, so luminance tells them apart; the same in both themes, the
	     pictures being data, not chrome. The keyboard focus keeps the accent, as everywhere -->
	<SolidColorBrush x:Key="PictureHandle" Color="#FFC8C8C8" />
	<SolidColorBrush x:Key="PictureSelection" Color="#FFFFE000" />

	<DrawingBrush x:Key="DockGripInactiveBrush" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Viewbox="0,0,4,4" ViewboxUnits="Absolute">
		<DrawingBrush.Drawing>
			<GeometryDrawing Brush="{DynamicResource TitleBarDragHandleInactive}" Geometry="{StaticResource DockGripGeometry}" />
		</DrawingBrush.Drawing>
	</DrawingBrush>
	<DrawingBrush x:Key="DockGripActiveBrush" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Viewbox="0,0,4,4" ViewboxUnits="Absolute">
		<DrawingBrush.Drawing>
			<GeometryDrawing Brush="{DynamicResource TitleBarDragHandleActive}" Geometry="{StaticResource DockGripGeometry}" />
		</DrawingBrush.Drawing>
	</DrawingBrush>

	<!-- ===================== window ===================== -->
	<!-- every window of the app is a class derived from Window, which an implicit style never reaches: each names this one
	     (Style="{StaticResource {x:Type Window}}", 2026-10-23) -->
	<Style TargetType="{x:Type Window}">
		<Setter Property="Background" Value="{DynamicResource WindowBackground}" />
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
		<Setter Property="FontFamily" Value="Segoe UI" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextOptions.TextFormattingMode" Value="Display" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<!-- the start-up zoom switch, a layout scale on each window's content (WindowZoom; nothing at zoom 1) -->
		<Setter Property="theming:WindowZoom.Enabled" Value="True" />
	</Style>

	<!-- ===================== menu ===================== -->
	<Style TargetType="{x:Type Menu}">
		<Setter Property="Background" Value="{DynamicResource MenuBackground}" />
		<Setter Property="Foreground" Value="{DynamicResource MenuForeground}" />
		<Setter Property="Padding" Value="2,0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Menu}">
					<Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
						<ItemsPresenter />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<ControlTemplate x:Key="MenuTopLevelHeaderTemplate" TargetType="{x:Type MenuItem}">
		<Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
			<Grid>
				<ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
				<!-- placed by the whole header, not this grid inside its padding (2026-10-23: the menu opened 7 px in and over
				     the header's bottom 3 px): left-aligned with the header, right below it -->
				<Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Bd}"
				       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
				       AllowsTransparency="True" Focusable="False" PopupAnimation="None" theming:WindowZoom.Popup="True">
					<Border Background="{DynamicResource MenuPopupBackground}"
					        BorderBrush="{DynamicResource MenuPopupBorder}" BorderThickness="1" Padding="2" SnapsToDevicePixels="True">
						<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
					</Border>
				</Popup>
			</Grid>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsHighlighted" Value="True">
				<Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuItemHover}" />
				<Setter Property="Foreground" Value="{DynamicResource MenuItemHoverForeground}" />
			</Trigger>
			<Trigger Property="IsSubmenuOpen" Value="True">
				<Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHeaderOpen}" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<ControlTemplate x:Key="MenuTopLevelItemTemplate" TargetType="{x:Type MenuItem}">
		<Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
			<ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsHighlighted" Value="True">
				<Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuItemHover}" />
				<Setter Property="Foreground" Value="{DynamicResource MenuItemHoverForeground}" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<ControlTemplate x:Key="MenuSubmenuItemTemplate" TargetType="{x:Type MenuItem}">
		<Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="2" SnapsToDevicePixels="True">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="24" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumn" />
					<ColumnDefinition Width="16" />
				</Grid.ColumnDefinitions>
				<ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16"
				                  HorizontalAlignment="Center" VerticalAlignment="Center" />
				<Path x:Name="CheckGlyph" Data="{StaticResource CheckGeometry}" Stroke="{DynamicResource MenuGlyph}"
				      StrokeThickness="1.5" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
				<ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
				                  Margin="4,2,8,2" VerticalAlignment="Center" />
				<TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,2,4,2"
				           VerticalAlignment="Center" Foreground="{DynamicResource GrayText}" />
			</Grid>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="Icon" Value="{x:Null}">
				<Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
			</Trigger>
			<Trigger Property="IsChecked" Value="True">
				<Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
			</Trigger>
			<Trigger Property="IsHighlighted" Value="True">
				<Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuItemHover}" />
				<Setter Property="Foreground" Value="{DynamicResource MenuItemHoverForeground}" />
				<Setter TargetName="CheckGlyph" Property="Stroke" Value="{DynamicResource MenuGlyphHover}" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<ControlTemplate x:Key="MenuSubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
		<Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="2" SnapsToDevicePixels="True">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="24" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumn" />
					<ColumnDefinition Width="16" />
				</Grid.ColumnDefinitions>
				<ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16"
				                  HorizontalAlignment="Center" VerticalAlignment="Center" />
				<ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
				                  Margin="4,2,8,2" VerticalAlignment="Center" />
				<Path x:Name="Arrow" Grid.Column="3" Data="{StaticResource SubmenuArrowGeometry}"
				      Fill="{DynamicResource MenuGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" />
				<!-- placed by the whole entry (2026-10-23; by the grid inside its padding it covered the entry's last 3 px and
				     its first entry came 2 px low): over the menu's padding and border, clear of this entry, the first entry level
				     with this one -->
				<Popup x:Name="PART_Popup" Placement="Right" PlacementTarget="{Binding ElementName=Bd}" VerticalOffset="-3"
				       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
				       AllowsTransparency="True" Focusable="False" PopupAnimation="None" theming:WindowZoom.Popup="True">
					<Border Background="{DynamicResource MenuPopupBackground}"
					        BorderBrush="{DynamicResource MenuPopupBorder}" BorderThickness="1" Padding="2" SnapsToDevicePixels="True">
						<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
					</Border>
				</Popup>
			</Grid>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="Icon" Value="{x:Null}">
				<Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
			</Trigger>
			<Trigger Property="IsHighlighted" Value="True">
				<Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuItemHover}" />
				<Setter Property="Foreground" Value="{DynamicResource MenuItemHoverForeground}" />
				<Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource MenuGlyphHover}" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<!-- the plus of an add command over an icon (IconView PlusBadge): 5 px in the bottom-right corner, inside the 15 px ink,
	     a pixel clear of the ring, the square and the ticks; stroked in the accent colour, in the text colour where the
	     accent is the background (a pressed button) or the text is greyed (a disabled one) -->
	<Style x:Key="IconPlusBadgeStyle" TargetType="{x:Type Path}">
		<Setter Property="Data" Value="{StaticResource IconPlusBadge}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Stroke" Value="{DynamicResource Accent}" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}" Value="True">
				<Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
			</DataTrigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style TargetType="{x:Type MenuItem}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource MenuForeground}" />
		<!-- the menu bar's headers alone (the submenu templates pad themselves): 23 px high like the entries of their menus
		     (2026-10-23, the user's request; 21 px before), the 15 px text line on rows 4 to 18 in both -->
		<Setter Property="Padding" Value="7,4" />
		<!-- set here so the system theme's bindings to the parent ItemsControl never apply: the templates below do not use
		     them, and a menu item made before its menu (the shared part entries in ProjectTree.xaml) logged a binding error -->
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Template" Value="{StaticResource MenuSubmenuItemTemplate}" />
		<Style.Triggers>
			<Trigger Property="Role" Value="TopLevelHeader">
				<Setter Property="Template" Value="{StaticResource MenuTopLevelHeaderTemplate}" />
			</Trigger>
			<Trigger Property="Role" Value="TopLevelItem">
				<Setter Property="Template" Value="{StaticResource MenuTopLevelItemTemplate}" />
			</Trigger>
			<Trigger Property="Role" Value="SubmenuHeader">
				<Setter Property="Template" Value="{StaticResource MenuSubmenuHeaderTemplate}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Separator}">
					<Border Height="1" Margin="26,3,2,3" Background="{DynamicResource MenuSeparator}" SnapsToDevicePixels="True" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type ContextMenu}">
		<Setter Property="Foreground" Value="{DynamicResource MenuForeground}" />
		<Setter Property="HasDropShadow" Value="False" />
		<Setter Property="LayoutTransform" Value="{Binding Source={x:Static ui:Settings.Default}, Path=UiZoom, Converter={StaticResource ZoomTransform}}" />
		<Setter Property="TextOptions.TextFormattingMode" Value="{Binding Source={x:Static ui:Settings.Default}, Path=UiZoom, Converter={StaticResource ZoomTextFormatting}}" />
		<Setter Property="TextOptions.TextRenderingMode" Value="{x:Static theming:WindowZoom.TextRendering}" />
		<Setter Property="theming:WindowZoom.Standalone" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ContextMenu}">
					<Border Background="{DynamicResource MenuPopupBackground}"
					        BorderBrush="{DynamicResource MenuPopupBorder}" BorderThickness="1" Padding="2" SnapsToDevicePixels="True">
						<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================== status bar ===================== -->
	<Style TargetType="{x:Type StatusBar}">
		<Setter Property="Background" Value="{DynamicResource StatusBarBackground}" />
		<Setter Property="Foreground" Value="{DynamicResource StatusBarForeground}" />
		<!-- right padding keeps the window's resize grip clear of the last item -->
		<Setter Property="Padding" Value="4,0,16,0" />
		<Setter Property="MinHeight" Value="22" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type StatusBar}">
					<Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
						<ItemsPresenter />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type StatusBarItem}">
		<Setter Property="Padding" Value="4,2" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type StatusBarItem}">
					<Border Padding="{TemplateBinding Padding}">
						<ContentPresenter VerticalAlignment="Center" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- window resize grip, drawn over the status bar corner: VS-style dot triangle -->
	<Style TargetType="{x:Type ResizeGrip}">
		<Setter Property="Width" Value="16" />
		<Setter Property="Height" Value="16" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ResizeGrip}">
					<Border Background="Transparent">
						<Path Fill="{DynamicResource StatusBarForeground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
						      Data="M8,0 h2 v2 h-2 z M8,4 h2 v2 h-2 z M8,8 h2 v2 h-2 z M4,4 h2 v2 h-2 z M4,8 h2 v2 h-2 z M0,8 h2 v2 h-2 z" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================== scroll bars ===================== -->
	<Style x:Key="ScrollBarLineButtonStyle" TargetType="{x:Type RepeatButton}">
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="{DynamicResource ScrollBarBackground}">
						<Path x:Name="Glyph" Data="{TemplateBinding Content}" Fill="{DynamicResource ScrollBarArrow}"
						      HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource ScrollBarArrowHover}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource ScrollBarArrowPressed}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="ScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border Background="Transparent" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Thumb}">
					<Border x:Name="Bd" Background="{DynamicResource ScrollBarThumb}" Margin="3" />
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollBarThumbHover}" />
						</Trigger>
						<Trigger Property="IsDragging" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollBarThumbPressed}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
		<Grid Background="{TemplateBinding Background}">
			<Grid.RowDefinitions>
				<RowDefinition Height="14" />
				<RowDefinition Height="*" />
				<RowDefinition Height="14" />
			</Grid.RowDefinitions>
			<RepeatButton Grid.Row="0" Style="{StaticResource ScrollBarLineButtonStyle}"
			              Command="{x:Static ScrollBar.LineUpCommand}" Content="{StaticResource ArrowUpGeometry}" />
			<Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
				<Track.DecreaseRepeatButton>
					<RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="{x:Static ScrollBar.PageUpCommand}" />
				</Track.DecreaseRepeatButton>
				<Track.Thumb>
					<Thumb Style="{StaticResource ScrollBarThumbStyle}" />
				</Track.Thumb>
				<Track.IncreaseRepeatButton>
					<RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="{x:Static ScrollBar.PageDownCommand}" />
				</Track.IncreaseRepeatButton>
			</Track>
			<RepeatButton Grid.Row="2" Style="{StaticResource ScrollBarLineButtonStyle}"
			              Command="{x:Static ScrollBar.LineDownCommand}" Content="{StaticResource ArrowDownGeometry}" />
		</Grid>
	</ControlTemplate>

	<ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
		<Grid Background="{TemplateBinding Background}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="14" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="14" />
			</Grid.ColumnDefinitions>
			<RepeatButton Grid.Column="0" Style="{StaticResource ScrollBarLineButtonStyle}"
			              Command="{x:Static ScrollBar.LineLeftCommand}" Content="{StaticResource ArrowLeftGeometry}" />
			<Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
				<Track.DecreaseRepeatButton>
					<RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="{x:Static ScrollBar.PageLeftCommand}" />
				</Track.DecreaseRepeatButton>
				<Track.Thumb>
					<Thumb Style="{StaticResource ScrollBarThumbStyle}" />
				</Track.Thumb>
				<Track.IncreaseRepeatButton>
					<RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="{x:Static ScrollBar.PageRightCommand}" />
				</Track.IncreaseRepeatButton>
			</Track>
			<RepeatButton Grid.Column="2" Style="{StaticResource ScrollBarLineButtonStyle}"
			              Command="{x:Static ScrollBar.LineRightCommand}" Content="{StaticResource ArrowRightGeometry}" />
		</Grid>
	</ControlTemplate>

	<Style TargetType="{x:Type ScrollBar}">
		<Setter Property="Background" Value="{DynamicResource ScrollBarBackground}" />
		<Setter Property="Width" Value="14" />
		<Setter Property="MinWidth" Value="14" />
		<Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
		<Style.Triggers>
			<Trigger Property="Orientation" Value="Horizontal">
				<Setter Property="Width" Value="Auto" />
				<Setter Property="MinWidth" Value="0" />
				<Setter Property="Height" Value="14" />
				<Setter Property="MinHeight" Value="14" />
				<Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- ===================== tree view ===================== -->
	<Style TargetType="{x:Type TreeView}">
		<Setter Property="Background" Value="{DynamicResource TreeViewBackground}" />
		<Setter Property="Foreground" Value="{DynamicResource TreeViewForeground}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="2" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type TreeView}">
					<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="{TemplateBinding BorderThickness}">
						<ScrollViewer Focusable="False" CanContentScroll="False" Padding="{TemplateBinding Padding}"
						              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
							<ItemsPresenter />
						</ScrollViewer>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="TreeViewToggleStyle" TargetType="{x:Type ToggleButton}">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ToggleButton}">
					<!-- a pixel above the middle of the 23 px row: the box on row 3, where the 16 px icons beside it round to 4, so
					     the chevrons centre on the text (2026-10-23) -->
					<Border Background="Transparent" Width="16" Height="16" Margin="0,0,0,1">
						<Path x:Name="Glyph" Data="{StaticResource ChevronRightGeometry}" Stroke="{DynamicResource TreeViewGlyph}"
						      StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Glyph" Property="Data" Value="{StaticResource ChevronDownGeometry}" />
							<Setter TargetName="Glyph" Property="Margin" Value="0,2,0,0" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource TreeViewGlyphHover}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- every row 23 px high (2026-10-23, the user's request for more room; the rows had been 18 px, 20 with glyph buttons),
	     no padding above or below: the 15 px text line centres on row 4 and the 16 px icon on 3.5, which layout rounding takes
	     to the even 4, so the text's 9 rows of ink land on 7 to 15 and an icon's 15 on 4 to 18, both centred, as in the
	     project toolbar's buttons (a pixel of padding above had put the text on 3.5, rounded to 4, a pixel low) -->
	<Style TargetType="{x:Type TreeViewItem}">
		<Setter Property="Foreground" Value="{DynamicResource TreeViewForeground}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Padding" Value="3,0" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<!-- set so the system theme's binding to the parent ItemsControl never applies (the template does not use it): it
		     logged an error for every row dropped when a list was cleared and refilled, as Undo and Redo do -->
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type TreeViewItem}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="16" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition />
						</Grid.RowDefinitions>
						<ToggleButton x:Name="Expander" Style="{StaticResource TreeViewToggleStyle}" ClickMode="Press"
						              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
						<Border x:Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}" MinHeight="23"
						        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
							<ContentPresenter x:Name="PART_Header" ContentSource="Header"
							                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
						</Border>
						<ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsExpanded" Value="False">
							<Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="HasItems" Value="False">
							<Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
						</Trigger>
						<Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeViewItemHover}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeViewItemSelected}" />
							<Setter Property="Foreground" Value="{DynamicResource TreeViewItemSelectedForeground}" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsSelected" Value="True" />
								<Condition Property="IsSelectionActive" Value="False" />
							</MultiTrigger.Conditions>
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeViewItemSelectedInactive}" />
							<Setter Property="Foreground" Value="{DynamicResource TreeViewItemSelectedInactiveForeground}" />
						</MultiTrigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================== splitter ===================== -->
	<Style TargetType="{x:Type GridSplitter}">
		<Setter Property="Background" Value="{DynamicResource SplitterBackground}" />
		<Setter Property="ShowsPreview" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type GridSplitter}">
					<Border Background="{TemplateBinding Background}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================== buttons ===================== -->
	<Style TargetType="{x:Type Button}">
		<Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="10,3" />
		<Setter Property="MinHeight" Value="23" />
		<!-- keyboard focus is the accent border (the user's rule), not WPF's dotted rectangle -->
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressed}" />
							<Setter Property="Foreground" Value="White" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource GrayText}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- 16x16 glyph button for pane title bars. Background = hover colour, Content = geometry. -->
	<Style x:Key="DockHeaderButtonStyle" TargetType="{x:Type Button}">
		<Setter Property="Width" Value="16" />
		<Setter Property="Height" Value="16" />
		<Setter Property="Margin" Value="1,0" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True">
						<Path Data="{TemplateBinding Content}" Fill="{TemplateBinding Foreground}"
						      HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================== tool tip ===================== -->
	<Style TargetType="{x:Type ToolTip}">
		<Setter Property="Background" Value="{DynamicResource ToolTipBackground}" />
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
		<Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorder}" />
		<Setter Property="HasDropShadow" Value="False" />
		<!-- a long tip wraps at 400 px (2026-11-10, with the examples' descriptions as tips, up to 430 characters; a one-line
		     tip ran past the screen, the part kinds' descriptions too; the Avalonia head wraps at the same width) -->
		<Setter Property="MaxWidth" Value="400" />
		<Setter Property="LayoutTransform" Value="{Binding Source={x:Static ui:Settings.Default}, Path=UiZoom, Converter={StaticResource ZoomTransform}}" />
		<Setter Property="TextOptions.TextFormattingMode" Value="{Binding Source={x:Static ui:Settings.Default}, Path=UiZoom, Converter={StaticResource ZoomTextFormatting}}" />
		<Setter Property="TextOptions.TextRenderingMode" Value="{x:Static theming:WindowZoom.TextRendering}" />
		<Setter Property="theming:WindowZoom.Standalone" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ToolTip}">
					<!-- snapped to device pixels (2026-11-02, the user's report): under a UI zoom WPF's Border rounds an edge
					     line's thickness but keeps it centred on the unrounded half, a quarter pixel outside at 1.5 -->
					<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="1" Padding="6,3" SnapsToDevicePixels="True">
						<ContentPresenter>
							<ContentPresenter.Resources>
								<!-- the text block WPF makes for a string tip, found by the implicit style: it wraps within the MaxWidth -->
								<Style TargetType="{x:Type TextBlock}">
									<Setter Property="TextWrapping" Value="Wrap" />
								</Style>
							</ContentPresenter.Resources>
						</ContentPresenter>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===================== docking ===================== -->
	<Style x:Key="DockToolTabStripStyle" TargetType="{x:Type ListBox}">
		<Setter Property="Background" Value="{DynamicResource ToolTabBackground}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
		<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ListBox}">
					<Border Background="{TemplateBinding Background}">
						<ItemsPresenter />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemTemplate">
			<Setter.Value>
				<DataTemplate>
					<TextBlock Text="{Binding Title}" />
				</DataTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemContainerStyle">
			<Setter.Value>
				<Style TargetType="{x:Type ListBoxItem}">
					<Setter Property="Foreground" Value="{DynamicResource ToolTabForeground}" />
					<!-- a tab is 23 px high, as a tree row, a toolbar button and a menu entry are, its text centred the same way
					     (4 px above, 3 and the border's 1 below) and 10 px from the tab's edge, the side border included
					     (2026-11-06, the user's request: at 6,2 the tabs were 20 px high and stood cramped) -->
					<Setter Property="Padding" Value="9,4,9,3" />
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="{x:Type ListBoxItem}">
								<Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,0,1,1"
								        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
									<ContentPresenter />
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter Property="Foreground" Value="{DynamicResource ToolTabHoverForeground}" />
									</Trigger>
									<Trigger Property="IsSelected" Value="True">
										<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolTabSelectedBackground}" />
										<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ToolWindowBorder}" />
										<Setter Property="Foreground" Value="{DynamicResource ToolTabSelectedForeground}" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Control resets the inherited foreground to the system colour; keep hosted text themed -->
	<Style TargetType="{x:Type UserControl}">
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
	</Style>
	<Style TargetType="{x:Type ContentControl}">
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
	</Style>

	<Style TargetType="{x:Type docking:DockGroupControl}">
		<Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type docking:DockGroupControl}">
					<Border Background="{DynamicResource ToolWindowBackground}" BorderBrush="{DynamicResource ToolWindowBorder}"
					        BorderThickness="1" SnapsToDevicePixels="True">
						<DockPanel>
							<Border x:Name="PART_TitleBar" DockPanel.Dock="Top" Height="21"
							        Background="{DynamicResource TitleBarInactiveBackground}"
							        TextElement.Foreground="{DynamicResource TitleBarInactiveForeground}">
								<DockPanel Margin="5,0,2,0">
									<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
										<Button x:Name="PART_MenuButton" Style="{StaticResource DockHeaderButtonStyle}"
										        Content="{StaticResource DropDownGeometry}" ToolTip="{DynamicResource DockWindowPosition}"
										        AutomationProperties.Name="{DynamicResource DockWindowPosition}"
										        Foreground="{DynamicResource TitleBarInactiveForeground}"
										        Background="{DynamicResource TitleBarButtonHoverInactive}">
											<Button.ContextMenu>
												<!-- The popup is outside the visual tree; route the commands to the pane via the placement target. -->
												<ContextMenu>
													<ContextMenu.Resources>
														<Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
															<Setter Property="CommandTarget" Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
														</Style>
													</ContextMenu.Resources>
													<MenuItem Header="{DynamicResource DockMoveLeft}" Command="{x:Static docking:DockCommands.MoveToSide}" CommandParameter="{x:Static docking:DockSide.Left}" />
													<MenuItem Header="{DynamicResource DockMoveRight}" Command="{x:Static docking:DockCommands.MoveToSide}" CommandParameter="{x:Static docking:DockSide.Right}" />
													<MenuItem Header="{DynamicResource DockMoveTop}" Command="{x:Static docking:DockCommands.MoveToSide}" CommandParameter="{x:Static docking:DockSide.Top}" />
													<MenuItem Header="{DynamicResource DockMoveBottom}" Command="{x:Static docking:DockCommands.MoveToSide}" CommandParameter="{x:Static docking:DockSide.Bottom}" />
													<Separator />
													<MenuItem Header="{DynamicResource DockCloseMenu}" Command="{x:Static docking:DockCommands.Close}" />
												</ContextMenu>
											</Button.ContextMenu>
										</Button>
										<Button x:Name="PART_CloseButton" Style="{StaticResource DockHeaderButtonStyle}"
										        Content="{StaticResource CloseGeometry}" ToolTip="{DynamicResource DockClose}"
										        AutomationProperties.Name="{DynamicResource DockClose}"
										        Command="{x:Static docking:DockCommands.Close}"
										        Foreground="{DynamicResource TitleBarInactiveForeground}"
										        Background="{DynamicResource TitleBarButtonHoverInactive}"
										        Visibility="{Binding Group.ActiveItem.CanClose, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}" />
									</StackPanel>
									<!-- a Label, not a TextBlock: a TextBlock inside a template stays out of the UI Automation control view, id or
									     not, while a Label is a control with a peer; the title is read as DockTitle:<pane id> -->
									<Label DockPanel.Dock="Left" Content="{Binding Group.ActiveItem.Title, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"
									       Padding="0" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
									       AutomationProperties.AutomationId="{Binding Group.ActiveItem.Id, RelativeSource={RelativeSource TemplatedParent}, StringFormat='DockTitle:{0}'}" />
									<Rectangle x:Name="Grip" Height="5" Margin="6,0,4,0" VerticalAlignment="Center"
									           Fill="{StaticResource DockGripInactiveBrush}" />
								</DockPanel>
							</Border>
							<ListBox x:Name="PART_Tabs" DockPanel.Dock="Bottom" Style="{StaticResource DockToolTabStripStyle}"
							         ItemsSource="{Binding Group.Items, RelativeSource={RelativeSource TemplatedParent}}" SelectedItem="{Binding Group.ActiveItem, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
							<ContentPresenter x:Name="PART_Content" Content="{Binding Group.ActiveItem.Content, RelativeSource={RelativeSource TemplatedParent}}" />
						</DockPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsActive" Value="True">
							<Setter TargetName="PART_TitleBar" Property="Background" Value="{DynamicResource TitleBarActiveBackground}" />
							<Setter TargetName="PART_TitleBar" Property="TextElement.Foreground" Value="{DynamicResource TitleBarActiveForeground}" />
							<Setter TargetName="PART_MenuButton" Property="Foreground" Value="{DynamicResource TitleBarActiveForeground}" />
							<Setter TargetName="PART_MenuButton" Property="Background" Value="{DynamicResource TitleBarButtonHoverActive}" />
							<Setter TargetName="PART_CloseButton" Property="Foreground" Value="{DynamicResource TitleBarActiveForeground}" />
							<Setter TargetName="PART_CloseButton" Property="Background" Value="{DynamicResource TitleBarButtonHoverActive}" />
							<Setter TargetName="Grip" Property="Fill" Value="{StaticResource DockGripActiveBrush}" />
						</Trigger>
						<!-- in ControlTemplate.Triggers a binding is evaluated on the templated control, so Self is the control -->
						<DataTrigger Binding="{Binding Group.Items.Count, RelativeSource={RelativeSource Self}}" Value="1">
							<Setter TargetName="PART_Tabs" Property="Visibility" Value="Collapsed" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
