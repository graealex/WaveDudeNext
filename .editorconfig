root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = tab
indent_size = 4

# the license header of every source file (the IDE adds it to new files, IDE0073 flags a file without it)
file_header_template = SPDX-License-Identifier: GPL-3.0-or-later\nCopyright (C) 2026 Alexander Graef <alex@graef.cc>\n\nThis file is part of WaveDude Next, a 2D wave simulator.\n\nBased on the work of\n  Jeroen Vleggaar (Huygens Optics), author of Wave Dude 2D, Copyright (C) 2026\n    <https://www.youtube.com/@HuygensOptics>, <https://www.huygensoptics.com>\n  0x23 (Diffraction Limited), author of WaveSimulator2D\n    <https://www.youtube.com/@DiffractionLimited>, <https://github.com/0x23/WaveSimulator2D>\n\nWaveDude Next is free software: you can redistribute it and/or modify it under\nthe terms of the GNU General Public License as published by the Free Software\nFoundation, either version 3 of the License, or (at your option) any later\nversion. It is distributed WITHOUT ANY WARRANTY. See the LICENSE.md file or\n<https://www.gnu.org/licenses/>.
dotnet_diagnostic.IDE0073.severity = warning

# No this. qualification; expression bodies for trivial accessors
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = all

[*.{csproj,sln,resx,config,settings,manifest}]
indent_style = space
indent_size = 2

[*.{md,yml,yaml,json,py}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
